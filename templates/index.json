          "settings": {
            "title": "What 11pm Scrolling Is Actually About",
            "text": "Late-night scrolling may be a transition problem rather than an entertainment problem.",
            "research_insight": "Our observations suggest that late-night scrolling often appears during the period between finishing the day and entering restorative rest. Rather than viewing it only as a habit of entertainment, we are exploring whether it may also represent an incomplete transition between one state and the next.",
            "research_link": "/blogs/journal/the-boundary-between-states-an-emerging-theory-of-human-state-transitions",
            "research_link_label": "Read Finding →"
          }
