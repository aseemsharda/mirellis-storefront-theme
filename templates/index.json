    "mirellis_how_ritual_exists_qyeHNL": {
      "type": "mirellis-how-ritual-exists",
      "disabled": true,
      "name": "How a Ritual Exists",
      "settings": {
        "eyebrow": "How we work",
        "heading": "Nothing here begins as a product.",
        "body": "<p>We start with an observation. It becomes a finding. The finding raises a question — what would help most here? — and that question opens a landscape of possibilities: light, scent, sound, temperature, timing, attention.</p><p>Only then do we ask what form the answer should take. Sometimes an oil. Sometimes a sound. Sometimes an environment. Often, it stays a question a little longer.</p><p>The form is always chosen last.</p>",
        "steps": "Observation, Finding, Mechanism, Intervention, Delivery, Ritual, Outcome",
        "pipeline_note": "There may be ten intervention opportunities for a transition. Only one becomes a product. The others are not failures — they are the pipeline.",
        "cta_label": "Enter the Observatory →",
        "cta_url": "shopify://pages/how-we-work",
        "background": "#faf7f2"
      }
    },
