    "mirellis_environmental_philosophy_paHNgy": {
      "type": "mirellis-environmental-philosophy",
      "disabled": true,
      "name": "Environmental Philosophy",
      "settings": {
        "label": "THE MIRELLIS METHOD",
        "heading": "The Mirellis Method restores the signals that mark life's transitions.",
        "intro": "Every transition begins with recognition.\n\nThe Mirellis Method combines sensory cues—such as light, scent, sound and timing—into repeatable rituals that consistently mark the beginning or end of a state.\n\nOver time, these familiar signals become part of the rhythm of everyday life.\n\nThe goal is not to force a change in state, but to make the transition itself more recognisable."
      }
    },
