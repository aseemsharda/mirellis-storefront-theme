    "research_notes_plus_dx6AVD": {
      "type": "research-notes-plus",
      "blocks": {
        "research_note_PFpyYe": {
          "type": "research_note",
          "settings": {
            "title": "Evening Rituals & Nervous-System Association",
            "description": "Repeated evening sensory rituals gradually become associated with familiarity, predictability, and restoration through nervous-system and behavioral association.",
            "source": "Behavioral Psychology & Habit Research",
            "link": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3505409/"
          }
        },
        "research_note_Empcxx": {
          "type": "research_note",
          "settings": {
            "title": "Vetiver & Sensory Grounding",
            "description": "Earthy aromatic compounds such as vetiver have historically been associated with grounding sensory environments and slower emotional pacing in aromatic traditions and sensory research.",
            "source": "Vetiver Aromatic Research",
            "link": "https://clinicaltrials.gov/study/NCT05024136"
          }
        },
        "research_note_bym8Tm": {
          "type": "research_note",
          "settings": {
            "title": "Breath, Aroma & Parasympathetic Activity",
            "description": "Slow aromatic rituals and intentional breathing patterns may influence parasympathetic nervous-system activity and physiological slowing during evening transitions.",
            "source": "NIH / Breath Physiology Research",
            "link": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8125361/"
          }
        },
        "research_note_AAqjfG": {
          "type": "research_note",
          "settings": {
            "title": "Lavender & Emotional Regulation",
