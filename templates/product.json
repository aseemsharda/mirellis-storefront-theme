        "heading_EQAAJW": {
          "type": "heading",
          "settings": {
            "text": "As the day ends, the body doesn't always know how to stop.",
            "heading_tag": "h1",
            "text_color": "",
            "gradient": ""
          }
        },
        "richtext_kL7KwQ": {
          "type": "richtext",
          "settings": {
            "content": "<p>Mental noise lingers. Physical tension remains. The nervous system stays alert — even when rest is needed.</p><p>Evening Stillness was created for this exact moment: to help the body recognise that the day is complete, and it is safe to slow down.</p>"
          }
        }
      },
