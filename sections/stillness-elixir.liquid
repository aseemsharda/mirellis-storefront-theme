  <section id="research" style="background:#faf7f4">
    <div style="max-width:920px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,5vw,48px)">
      <div data-reveal style="margin-bottom:clamp(36px,5vw,56px)">
        <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#b07f54;margin-bottom:18px">Research notes</div>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,4vw,46px);margin:0 0 14px;letter-spacing:-0.01em">Evening rhythm &amp; nervous-system restoration.</h2>
        <p style="font-size:15px;line-height:1.75;color:#6f665b;margin:0;max-width:60ch">Quiet research increasingly supports the relationship between repeated sensory environments, circadian rhythm, and nervous-system slowing.</p>
      </div>
      <div data-reveal id="research-accordion" style="border-top:1px solid #e2dacd"></div>
    </div>
  </section>

  <!-- COMPANION CROSS-SELL -->
  <section style="background:#1b2230;color:#ece7dd">
    <div style="max-width:1240px;margin:0 auto;padding:clamp(64px,8vw,104px) clamp(20px,5vw,48px);display:flex;flex-wrap:wrap;gap:36px;align-items:center;justify-content:space-between">
      <div data-reveal style="max-width:560px">
        <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#8d96bb;margin-bottom:18px">The transition that follows</div>
        <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.6vw,42px);line-height:1.2;margin:0 0 16px;letter-spacing:-0.01em">The morning ritual that follows the evening.</h2>
        <p style="font-size:15.5px;line-height:1.75;color:#bcb6ab;margin:0">Stillness creates the conditions for a different kind of morning. Morning Clarity exists for the Sleep → Wakefulness transition — made possible by how the evening ended.</p>
      </div>
      <a href="#" data-reveal class="companion-link" style="flex:none;display:inline-flex;align-items:center;gap:12px;padding:16px 28px;border:1px solid rgba(255,255,255,0.25);border-radius:100px;text-decoration:none;color:#ece7dd;font-size:14px;letter-spacing:.06em;transition:background .3s,border-color .3s">Companion ritual — Morning Clarity →</a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="background:#12171f;color:#9aa1ac">
    <div style="max-width:1240px;margin:0 auto;padding:clamp(48px,6vw,72px) clamp(20px,5vw,48px)">
      <div style="display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between;align-items:flex-start;padding-bottom:36px;border-bottom:1px solid rgba(255,255,255,0.1)">
        <div style="max-width:320px">
          <div style="font-family:'Newsreader',serif;font-size:22px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:#ece7dd;margin-bottom:14px">Mirellis</div>
          <p style="font-size:13.5px;line-height:1.7;margin:0">A ritual science company by Lambda Lifestyle Private Limited.</p>
        </div>
        <div style="display:flex;gap:clamp(36px,6vw,80px);flex-wrap:wrap">
          <div>
            <div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#6b7280;margin-bottom:16px">Shop</div>
            <div style="display:flex;flex-direction:column;gap:11px;font-size:13.5px">
              <a href="#" style="text-decoration:none">Morning Clarity</a>
              <a href="#hero" style="text-decoration:none;color:#ece7dd">Stillness Elixir</a>
            </div>
          </div>
          <div>
            <div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#6b7280;margin-bottom:16px">Observatory</div>
            <div style="display:flex;flex-direction:column;gap:11px;font-size:13.5px">
              <a href="#research" style="text-decoration:none">Findings</a>
              <a href="#" style="text-decoration:none">Our Method</a>
              <a href="#" style="text-decoration:none">About</a>
            </div>
          </div>
        </div>
      </div>
      <div style="padding-top:24px;font-size:12px;color:#6b7280;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between">
        <span>© 2026 Mirellis</span>
        <span>Made in India · Gurugram</span>
      </div>
    </div>
  </footer>

<script>
(function () {
  // ── Gallery ────────────────────────────────────────────────────────────────────────
  var imgs = [
    'https://mirellis.in/cdn/shop/files/Image-1_Product.png?v=1773638905&width=1080',
    'https://mirellis.in/cdn/shop/files/Image-3_For-evenings.png?v=1773638905&width=1080',
    'https://mirellis.in/cdn/shop/files/Image-5_warm-grounding.png?v=1773638905&width=1080',
    'https://mirellis.in/cdn/shop/files/Image-7_Warm-in-palms.png?v=1773638905&width=1080',
    'https://mirellis.in/cdn/shop/files/Image-8_50ml-Ritual.png?v=1773638905&width=1080'
  ];
  var activeImg = 0;
  var mainImg = document.getElementById('main-img');
  var thumbStrip = document.getElementById('thumb-strip');

  function buildThumbs() {
    thumbStrip.innerHTML = '';
    imgs.forEach(function (url, i) {
      var btn = document.createElement('button');
      btn.className = 'thumb-btn';
      btn.style.cssText =
        'flex:1;aspect-ratio:1;padding:0;border-radius:4px;overflow:hidden;' +
        'cursor:pointer;background:#1b2230;transition:opacity .3s,border-color .3s;' +
        (i === activeImg
          ? 'border:1.5px solid #cf9266;opacity:1;'
          : 'border:1px solid rgba(255,255,255,0.16);opacity:0.55;');
      var img = document.createElement('img');
      img.src = url;
      img.loading = 'lazy';
      img.alt = '';
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
      btn.appendChild(img);
      btn.addEventListener('click', function () {
        activeImg = i;
        mainImg.src = url;
        buildThumbs();
      });
      thumbStrip.appendChild(btn);
    });
  }
  buildThumbs();

  // ── Qty stepper ──────────────────────────────────────────────────────────────────────────────
  var qty = 1;
  var qtyDisplay = document.getElementById('qty-display');

  document.getElementById('qty-dec').addEventListener('click', function () {
    if (qty > 1) { qty--; qtyDisplay.textContent = qty; }
  });
  document.getElementById('qty-inc').addEventListener('click', function () {
    if (qty < 9) { qty++; qtyDisplay.textContent = qty; }
  });

  // ── Add to cart ─────────────────────────────────────────────────────────────────────────────
  var addBtn = document.getElementById('add-btn');
  var addTimer;
  addBtn.addEventListener('click', function () {
    if (addBtn.disabled) return;
    addBtn.disabled = true;
    addBtn.textContent = 'Adding…';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: 42345014820930, quantity: qty })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      addBtn.textContent = 'Added to cart ✓';
      addBtn.disabled = false;
      clearTimeout(addTimer);
      addTimer = setTimeout(function() { addBtn.textContent = 'Add to cart'; }, 1800);
    })
    .catch(function() {
      addBtn.textContent = 'Add to cart';
      addBtn.disabled = false;
    });
  });

  // ── Research accordion ────────────────────────────────────────────────────────────────
  var research = [
    {
      t: 'Warmth, texture & sensory regulation',
      b: 'Temperature, tactile softness, dim light, and sensory atmosphere may influence how the body perceives comfort, safety, and evening decompression.'
    },
    {
      t: 'Environmental predictability & restoration',
      b: 'Repeated sensory environments and predictable evening rituals may help the nervous system associate certain signals with slowing, familiarity, and restoration.'
    },
    {
      t: 'Breathing & parasympathetic activity',
      b: 'Slower breathing rhythms are associated with parasympathetic nervous-system activity and may influence physiological slowing and emotional regulation.'
    },
    {
      t: 'Sound environment & emotional pacing',
      b: 'Lower-intensity sound environments and slower auditory pacing may support emotional decompression and reduced physiological stimulation during evening transitions.'
    },
    {
      t: 'Light exposure & circadian rhythm',
      b: "Artificial light exposure during evening hours may influence melatonin timing, circadian rhythm, and the body's natural transition into rest and restoration."
    }
  ];
  var openIdx = 0;
  var accordion = document.getElementById('research-accordion');

  function buildAccordion() {
    accordion.innerHTML = '';
    research.forEach(function (r, i) {
      var isOpen = openIdx === i;

      var item = document.createElement('div');
      item.style.borderBottom = '1px solid #e2dacd';

      var btn = document.createElement('button');
      btn.className = 'research-btn';
      btn.style.cssText =
        'width:100%;display:flex;align-items:center;justify-content:space-between;' +
        'gap:20px;padding:24px 0;background:transparent;border:none;cursor:pointer;' +
        "text-align:left;font-family:'Hanken Grotesk',sans-serif";

      var titleEl = document.createElement('span');
      titleEl.style.cssText = 'font-size:clamp(16px,2vw,19px);color:#2a261f;font-weight:500';
      titleEl.textContent = r.t;

      var signEl = document.createElement('span');
      signEl.className = 'research-sign';
      signEl.style.cssText =
        "font-family:'Newsreader',serif;font-size:24px;color:#cf9266;line-height:1;" +
        'flex:none;transition:color .2s';
      signEl.textContent = isOpen ? '−' : '+';

      btn.appendChild(titleEl);
      btn.appendChild(signEl);

      var panel = document.createElement('div');
      panel.style.cssText =
        'overflow:hidden;transition:max-height .5s cubic-bezier(.22,.61,.36,1),opacity .4s ease;' +
        (isOpen ? 'max-height:200px;opacity:1;' : 'max-height:0;opacity:0;');

      var p = document.createElement('p');
      p.style.cssText =
        'font-size:14.5px;line-height:1.8;color:#6f665b;margin:0;padding-bottom:26px;max-width:62ch';
      p.textContent = r.b;
      panel.appendChild(p);

      btn.addEventListener('click', function () {
        openIdx = isOpen ? -1 : i;
        buildAccordion();
      });

      item.appendChild(btn);
      item.appendChild(panel);
      accordion.appendChild(item);
    });
  }
  buildAccordion();

  // ── Scroll-reveal ─────────────────────────────────────────────────────────────────────────────
  var revealEls = document.querySelectorAll('[data-reveal]');
  revealEls.forEach(function (el) {
    el.style.opacity = '0';
    el.style.transform = 'translateY(26px)';
    el.style.transition =
      'opacity .9s cubic-bezier(.22,.61,.36,1), transform .9s cubic-bezier(.22,.61,.36,1)';
  });
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'none';
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
  revealEls.forEach(function (el) { observer.observe(el); });
})();
</script>
</body>
</html>

