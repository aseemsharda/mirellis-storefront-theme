<section class="about-editorial-split {% if section.settings.image_position == 'right' %}image-right{% endif %}">

  <div class="about-editorial-split__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          widths: '600,900,1200,1600,2000',
          class: 'about-editorial-split__image'
      }}
    {% endif %}
  </div>

  <div class="about-editorial-split__content">

    {% if section.settings.eyebrow != blank %}
      <p class="about-editorial-split__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="about-editorial-split__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.highlight_quote != blank %}
      <blockquote class="about-editorial-split__quote">
        {{ section.settings.highlight_quote }}
      </blockquote>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="about-editorial-split__body rte">
        {{ section.settings.body }}
      </div>
    {% endif %}

  </div>

</section>

<style>

.about-editorial-split{
  background:#F8F4EE;
  display:grid;
  grid-template-columns:52% 48%;
  gap:70px;
  align-items:start;
  max-width:1380px;
  margin:0 auto;
  padding:90px 48px;
}

.about-editorial-split.image-right{
  direction:rtl;
}

.about-editorial-split.image-right > *{
  direction:ltr;
}

.about-editorial-split__media{
  width:100%;
}

.about-editorial-split__image{
  width:100%;
  display:block;
  aspect-ratio:4/5;
  object-fit:cover;
  min-height:560px;
}

.about-editorial-split__content{
  max-width:540px;
}

.about-editorial-split__eyebrow{
  font-size:12px;
  letter-spacing:.18em;
  text-transform:uppercase;
  opacity:.55;
  margin-bottom:18px;
  font-weight:500;
}

.about-editorial-split__heading{
  font-size:clamp(30px,3vw,48px);
  line-height:1.08;
  letter-spacing:-0.03em;
  margin:0 0 18px;
}

.about-editorial-split__quote{
  font-size:clamp(18px,1.8vw,26px);
  line-height:1.5;
  margin:0 0 28px;
  font-weight:500;
  letter-spacing:-0.01em;
}

.about-editorial-split__body{
  font-size:17px;
  line-height:1.85;
  color:rgba(0,0,0,.78);
}

.about-editorial-split__body p{
  margin-bottom:16px;
}

.about-editorial-split__body strong{
  font-weight:600;
}

@media screen and (max-width:999px){

  .about-editorial-split{
    grid-template-columns:1fr;
    gap:32px;
    padding:64px 24px;
  }

  .about-editorial-split.image-right{
    direction:ltr;
  }

  .about-editorial-split__content{
    max-width:100%;
  }

  .about-editorial-split__image{
    min-height:auto;
  }

  .about-editorial-split__heading{
    font-size:38px;
  }

  .about-editorial-split__quote{
    font-size:22px;
  }

  .about-editorial-split__body{
    font-size:16px;
  }

}

</style>

{% schema %}
{
  "name": "About Editorial Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "highlight_quote",
      "label": "Highlight Quote"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    }
  ],
  "presets": [
    {
      "name": "About Editorial Split"
    }
  ]
}
{% endschema %}