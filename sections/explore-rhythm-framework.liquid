<section class="explore-framework">

  <div class="explore-framework-container">

    <div class="explore-framework-header">

      <p class="explore-framework-eyebrow">
        The Mirellis Framework
      </p>

      <h2>
        The Day Is More Than Activities
      </h2>

      <p class="explore-framework-intro">
        At Mirellis, rituals are viewed as transition signals.
        Not routines to optimize life. Not productivity systems.
        But repeated cues that help one state end and another begin.
      </p>

    </div>

    <div class="explore-framework-flow">

      <div class="framework-card">
        <span class="framework-phase">Morning</span>
        <h3>Orientation</h3>
        <p>
          The first signals that help attention arrive.
        </p>
      </div>

      <div class="framework-arrow">↓</div>

      <div class="framework-card">
        <span class="framework-phase">Day</span>
        <h3>Attention</h3>
        <p>
          Engagement with work, people and responsibilities.
        </p>
      </div>

      <div class="framework-arrow">↓</div>

      <div class="framework-card">
        <span class="framework-phase">Evening</span>
        <h3>Restoration</h3>
        <p>
          Signals that allow the body to begin slowing down.
        </p>
      </div>

      <div class="framework-arrow">↓</div>

      <div class="framework-card">
        <span class="framework-phase">Night</span>
        <h3>Integration</h3>
        <p>
          The quieter period where experiences settle.
        </p>
      </div>

    </div>

    <div class="explore-framework-note">

      <p>
        The body responds not only to what we do, but also to how we move between states.
      </p>

    </div>

  </div>

</section>

<style>

.explore-framework {
  background: #f8f4ee;
  padding: 140px 40px;
}

.explore-framework-container {
  max-width: 1200px;
  margin: 0 auto;
}

.explore-framework-header {
  text-align: center;
  max-width: 760px;
  margin: 0 auto 90px;
}

.explore-framework-eyebrow {
  font-size: 13px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #8d867d;
  margin-bottom: 22px;
}

.explore-framework-header h2 {
  font-size: clamp(40px,5vw,68px);
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #222;
  margin-bottom: 30px;
  font-weight: 400;
}

.explore-framework-intro {
  font-size: 20px;
  line-height: 1.9;
  color: #5f5952;
}

.explore-framework-flow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 26px;
  flex-wrap: wrap;
}

.framework-card {
  background: white;
  width: 240px;
  padding: 42px 32px;
  border-radius: 18px;
  text-align: center;
  box-shadow: 0 10px 30px rgba(0,0,0,0.04);
}

.framework-phase {
  display: block;
  font-size: 12px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #8d867d;
  margin-bottom: 14px;
}

.framework-card h3 {
  font-size: 30px;
  font-weight: 400;
  color: #222;
  margin-bottom: 16px;
}

.framework-card p {
  font-size: 15px;
  line-height: 1.8;
  color: #6a635b;
}

.framework-arrow {
  font-size: 28px;
  color: #b2aba1;
}

.explore-framework-note {
  max-width: 760px;
  margin: 90px auto 0;
  text-align: center;
}

.explore-framework-note p {
  font-size: 22px;
  line-height: 1.8;
  color: #4d4740;
}

@media screen and (max-width: 768px) {

  .explore-framework {
    padding: 90px 24px;
  }

  .explore-framework-header {
    margin-bottom: 60px;
  }

  .explore-framework-intro {
    font-size: 17px;
  }

  .framework-card {
    width: 100%;
  }

  .framework-arrow {
    width: 100%;
    text-align: center;
    margin: -4px 0;
  }

  .explore-framework-note p {
    font-size: 18px;
  }

}

</style>

{% schema %}
{
  "name": "Explore Rhythm Framework",
  "presets": [
    {
      "name": "Explore Rhythm Framework"
    }
  ]
}
{% endschema %}