<section class="homepage-ritual-products">

  <div class="page-width">

    <div class="homepage-ritual-products__inner">

      {% if section.settings.label != blank %}

        <p class="homepage-ritual-products__label">
          {{ section.settings.label }}
        </p>

      {% endif %}

      {% if section.settings.heading != blank %}

        <h2 class="homepage-ritual-products__heading">
          {{ section.settings.heading }}
        </h2>

      {% endif %}

      <div class="homepage-ritual-products__grid">

        {% for block in section.blocks %}

          <a href="{{ block.settings.link }}" class="homepage-ritual-products__item">

            {% if block.settings.image != blank %}

              <div class="homepage-ritual-products__media">

                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'homepage-ritual-products__image'
                }}

              </div>

            {% endif %}

            <div class="homepage-ritual-products__content">

              <p class="homepage-ritual-products__item-label">
                {{ block.settings.item_label }}
              </p>

              <h3 class="homepage-ritual-products__title">
                {{ block.settings.title }}
              </h3>

              <div class="homepage-ritual-products__description">
                {{ block.settings.description }}
              </div>

            </div>

          </a>

        {% endfor %}

      </div>

    </div>

  </div>

</section>

<style>

.homepage-ritual-products {
  padding: 140px 0;
  background: #f7f3ee;
}

.homepage-ritual-products__inner {
  max-width: 1240px;
  margin: 0 auto;
}

.homepage-ritual-products__label {
  margin-bottom: 24px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: #8b8378;
}

.homepage-ritual-products__heading {
  max-width: 780px;
  margin: 0 0 70px;

  font-size: 42px;
  line-height: 1.35;
  font-weight: 300;

  color: #1f1f1f;
}

.homepage-ritual-products__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 34px;
}

.homepage-ritual-products__item {
  display: block;

  text-decoration: none;
}

.homepage-ritual-products__media {
  overflow: hidden;
  margin-bottom: 28px;
}

.homepage-ritual-products__image {
  width: 100%;
  display: block;

  transition: transform 1.2s ease;
}

.homepage-ritual-products__item:hover .homepage-ritual-products__image {
  transform: scale(1.03);
}

.homepage-ritual-products__item-label {
  margin: 0 0 18px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: #8b8378;
}

.homepage-ritual-products__title {
  margin: 0 0 18px;

  font-size: 34px;
  line-height: 1.35;
  font-weight: 300;

  color: #1f1f1f;
}

.homepage-ritual-products__description {
  max-width: 520px;

  font-size: 17px;
  line-height: 1.9;

  color: #5a5550;
}

@media screen and (max-width: 990px) {

  .homepage-ritual-products {
    padding: 110px 0;
  }

  .homepage-ritual-products__grid {
    grid-template-columns: 1fr;
  }

}

@media screen and (max-width: 749px) {

  .homepage-ritual-products {
    padding: 80px 0;
  }

  .homepage-ritual-products__heading {
    margin-bottom: 46px;
    font-size: 30px;
  }

  .homepage-ritual-products__title {
    font-size: 26px;
  }

  .homepage-ritual-products__description {
    font-size: 16px;
    line-height: 1.85;
  }

}

</style>

{% schema %}
{
  "name": "Ritual Products",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Ritual Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products designed as ritual environments rather than momentary stimulation."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "item_label",
          "label": "Item Label",
          "default": "Ritual Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual Products"
    }
  ]
}
{% endschema %}