{%- comment -%}
  MIRELLIS — PDP HERO  (Product Experience OS · reusable across products)
  Book I: Journey 1–2 (Curiosity+Recognition) · resolves Uncertainty 1 (Product), 4 (Personal relevance) · Dim A+B.
  The transition is the hero — never the commodity. All copy is section settings (editable).
  MEDIA: add Image and/or Video blocks for a swipeable gallery (scroll-snap + dots). Falls back to a
  single image (or the product's featured image) when no blocks are added. Self-contained; tokens; empty-safe.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign filled_media_blocks = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'image' and block.settings.image != blank -%}
    {%- assign filled_media_blocks = filled_media_blocks | plus: 1 -%}
  {%- elsif block.type == 'video' -%}
    {%- if block.settings.native_video != blank or block.settings.video_url != blank -%}
      {%- assign filled_media_blocks = filled_media_blocks | plus: 1 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign use_product_media = false -%}
{%- if filled_media_blocks == 0 and s.use_product_media and product != blank and product.media.size > 0 -%}
  {%- assign use_product_media = true -%}
{%- endif -%}

<section class="pdh" style="background: {{ s.background | default: 'var(--ml-color-warm-paper)' }};">
  {%- if filled_media_blocks > 0 or use_product_media -%}
    <div class="pdh__gallery">
      <div class="pdh__track" id="pdh-track-{{ section.id }}">
        {%- if filled_media_blocks > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'image' and block.settings.image != blank -%}
              <div class="pdh__slide" {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'pdh__el', sizes: '100vw', widths: '600,900,1200,1800,2400', alt: block.settings.image.alt | default: s.heading }}
              </div>
            {%- elsif block.type == 'video' -%}
              {%- if block.settings.native_video != blank or block.settings.video_url != blank -%}
                <div class="pdh__slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.native_video != blank -%}
                    {{ block.settings.native_video | video_tag: class: 'pdh__el', controls: true, loop: block.settings.autoplay, autoplay: block.settings.autoplay, muted: block.settings.autoplay, playsinline: true, image_size: '1600x' }}
                  {%- else -%}
                    <div class="pdh__ext">{{ block.settings.video_url | external_video_url: autoplay: block.settings.autoplay, loop: block.settings.autoplay, mute: block.settings.autoplay, playlist: '' | external_video_tag: class: 'pdh__el', loading: 'lazy' }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <div class="pdh__slide">
                {{ media.preview_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'pdh__el', sizes: '100vw', widths: '600,900,1200,1800,2400', alt: media.alt | default: s.heading }}
              </div>
            {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
              <div class="pdh__slide">
                {{ media | media_tag: class: 'pdh__el', controls: true, image_size: '1600x' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if filled_media_blocks > 1 or use_product_media -%}
        <div class="pdh__dots">
          {%- if filled_media_blocks > 0 -%}
            {%- assign slide_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- assign has_media = false -%}
              {%- if block.type == 'image' and block.settings.image != blank -%}
                {%- assign has_media = true -%}
              {%- elsif block.type == 'video' -%}
                {%- if block.settings.native_video != blank or block.settings.video_url != blank -%}
                  {%- assign has_media = true -%}
                {%- endif -%}
              {%- endif -%}
              {%- if has_media -%}
                <button type="button" class="pdh__dot{% if slide_index == 0 %} is-on{% endif %}" data-i="{{ slide_index }}" aria-label="Go to slide {{ slide_index | plus: 1 }}"></button>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign slide_index = 0 -%}
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' -%}
                <button type="button" class="pdh__dot{% if slide_index == 0 %} is-on{% endif %}" data-i="{{ slide_index }}" aria-label="Go to slide {{ slide_index | plus: 1 }}"></button>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- assign hero_img = s.image -%}
    {%- if hero_img == blank and product != blank -%}{%- assign hero_img = product.featured_image -%}{%- endif -%}
    {%- if hero_img != blank -%}
      <div class="pdh__media">{{ hero_img | image_url: width: 2400 | image_tag: loading: 'eager', class: 'pdh__el', sizes: '100vw', widths: '600,900,1200,1800,2400', alt: s.heading | default: product.title }}</div>
    {%- endif -%}
  {%- endif -%}

  <div class="pdh__inner">
    {%- if s.eyebrow != blank -%}<div class="pdh__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    {%- if s.heading != blank -%}<h1 class="pdh__heading">{{ s.heading }}</h1>{%- endif -%}
    {%- if s.identity != blank -%}<p class="pdh__identity">{{ s.identity }}</p>{%- endif -%}
    {%- if s.sub != blank -%}<p class="pdh__sub">{{ s.sub }}</p>{%- endif -%}
    <div class="pdh__cta">
      {%- if s.cta_label != blank -%}<a class="pdh__btn" href="{{ s.cta_url | default: '#pdp-buy' }}">{{ s.cta_label }}</a>{%- endif -%}
      {%- if s.secondary_label != blank and s.secondary_url != blank -%}<a class="pdh__link" href="{{ s.secondary_url }}">{{ s.secondary_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

<style>
  .pdh { position: relative; }
  .pdh__el, .pdh__media img { display: block; width: 100%; height: clamp(52vh, 60vh, 640px); object-fit: cover; }
  .pdh__gallery { position: relative; }
  .pdh__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .pdh__track::-webkit-scrollbar { display: none; }
  .pdh__slide { flex: 0 0 100%; scroll-snap-align: center; }
  .pdh__ext { position: relative; width: 100%; height: clamp(52vh, 60vh, 640px); }
  .pdh__ext iframe, .pdh__ext .pdh__el { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pdh__dots { display: flex; justify-content: center; gap: 0.55rem; padding: 0.9rem 0 0.2rem; }
  .pdh__dot { width: 7px; height: 7px; padding: 0; border: none; border-radius: 50%; background: var(--ml-color-border-soft); cursor: pointer; transition: background var(--ml-motion-fast, 200ms) ease, transform var(--ml-motion-fast, 200ms) ease; }
  .pdh__dot.is-on { background: var(--ml-color-muted-earth); transform: scale(1.2); }
  .pdh__inner { max-width: 720px; margin-inline: auto; padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 5vw, 2rem) clamp(3rem, 7vw, 5.5rem); }
  .pdh__eyebrow { font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ml-color-muted-earth); font-weight: 600; margin-bottom: 1.5rem; }
  .pdh__heading { font-size: clamp(2.2rem, 5.5vw, 3.4rem); font-weight: 300; letter-spacing: -0.01em; line-height: 1.12; color: var(--ml-color-soft-charcoal); margin: 0 0 1.25rem; max-width: 18ch; }
  .pdh__identity { font-size: clamp(1.2rem, 2.6vw, 1.5rem); font-weight: 300; line-height: 1.5; color: var(--ml-color-soft-charcoal); max-width: 40ch; margin: 0 0 1.25rem; }
  .pdh__sub { font-size: 1.0625rem; line-height: 1.85; color: var(--ml-color-text-secondary); max-width: 54ch; margin: 0 0 2.25rem; }
  .pdh__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 1.75rem; }
  .pdh__btn { display: inline-block; padding: 0.9rem 1.9rem; border: 1px solid var(--ml-color-soft-charcoal); border-radius: 999px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ml-color-soft-charcoal); text-decoration: none; transition: background var(--ml-motion-fast, 200ms) ease, color var(--ml-motion-fast, 200ms) ease; }
  .pdh__btn:hover { background: var(--ml-color-soft-charcoal); color: var(--ml-color-warm-paper); }
  .pdh__link { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ml-color-muted-earth); text-underline-offset: 3px; }
</style>

<script>
  (function () {
    var track = document.getElementById('pdh-track-{{ section.id }}');
    if (!track) return;
    var gallery = track.closest('.pdh__gallery');
    var dots = gallery ? gallery.querySelectorAll('.pdh__dot') : [];
    if (!dots.length) return;
    function setActive(i) { for (var j = 0; j < dots.length; j++) { dots[j].classList.toggle('is-on', j === i); } }
    var raf;
    track.addEventListener('scroll', function () {
      if (raf) return;
      raf = requestAnimationFrame(function () { raf = null; setActive(Math.round(track.scrollLeft / track.clientWidth)); });
    });
    for (var k = 0; k < dots.length; k++) {
      dots[k].addEventListener('click', function () {
        track.scrollTo({ left: parseInt(this.getAttribute('data-i'), 10) * track.clientWidth, behavior: 'smooth' });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "PDP · Hero",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "native_video", "label": "Video (upload / Shopify-hosted)" },
        { "type": "video_url", "id": "video_url", "label": "or Video URL (YouTube / Vimeo)", "accept": ["youtube", "vimeo"] },
        { "type": "checkbox", "id": "autoplay", "label": "Autoplay (muted, looped)", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Fallback media (when no blocks added)" },
    { "type": "image_picker", "id": "image", "label": "Single hero image (falls back to product image)" },
    { "type": "checkbox", "id": "use_product_media", "label": "Use product media as gallery when no media blocks are added", "default": false },
    { "type": "paragraph", "content": "For a custom hero, add Image and Video blocks above. Their order becomes the scroll order; uploaded Shopify videos, YouTube, and Vimeo are supported." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (the transition)", "default": "Sleep → Wakefulness" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The first signal of the day." },
    { "type": "inline_richtext", "id": "identity", "label": "Identity line", "default": "An Ayurvedic morning ritual for the crossing from sleep into wakefulness." },
    { "type": "inline_richtext", "id": "sub", "label": "Sub", "default": "Not an oil-pulling product. The first coherent sensory signal the nervous system receives each morning — before screens, before caffeine, before language." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Begin the morning ritual →" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA link (default scrolls to buy)" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Why this exists →" },
    { "type": "url", "id": "secondary_url", "label": "Secondary link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf7f2" }
  ],
  "presets": [{ "name": "PDP · Hero" }]
}
{% endschema %}
