{% stylesheet %}
.mirellis-interval {
  position: relative;
  min-height: 72vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #0d0c0b;
}

.mirellis-interval__image {
  position: absolute;
  inset: 0;
}

.mirellis-interval__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mirellis-interval__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,0.46),
      rgba(0,0,0,0.58)
    );
}

.mirellis-interval__content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 760px;
  padding: 2rem;
}

.mirellis-interval__text {
  font-family: var(--font-heading-family);
  font-size: clamp(1.8rem, 4vw, 4rem);
  line-height: 1.2;
  letter-spacing: -0.03em;
  color: #f5f1ea;
  font-weight: 400;
}

.mirellis-interval__subtle {
  margin-top: 1.6rem;
  font-size: 0.95rem;
  color: rgba(255,255,255,0.52);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

@media screen and (max-width: 749px) {
  .mirellis-interval {
    min-height: 60vh;
  }

  .mirellis-interval__content {
    padding: 1.6rem;
  }

  .mirellis-interval__text {
    font-size: clamp(1.7rem, 8vw, 2.8rem);
    line-height: 1.22;
  }

  .mirellis-interval__subtle {
    font-size: 0.8rem;
    margin-top: 1.2rem;
  }
}
{% endstylesheet %}

<section class="mirellis-interval">

  <div class="mirellis-interval__image">

    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '600, 900, 1200, 1800',
          alt: section.settings.image.alt | default: section.settings.quote
      }}
    {% endif %}

    <div class="mirellis-interval__overlay"></div>

  </div>

  <div class="mirellis-interval__content">

    {% if section.settings.quote != blank %}
      <div class="mirellis-interval__text">
        {{ section.settings.quote | escape | newline_to_br }}
      </div>
    {% endif %}

    {% if section.settings.subtle != blank %}
      <div class="mirellis-interval__subtle">
        {{ section.settings.subtle | escape | newline_to_br }}
      </div>
    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "Atmospheric Interval",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "info": "Press Enter to break onto a new line. Each line renders separately.",
      "default": "The body learns what comes next.\nThe transition becomes familiar."
    },
    {
      "type": "textarea",
      "id": "subtle",
      "label": "Subtle Text",
      "info": "Press Enter to break onto a new line.",
      "default": "Repeated signals become familiar pathways"
    }
  ],
  "presets": [
    {
      "name": "Atmospheric Interval"
    }
  ]
}
{% endschema %}