<section class="public-notes-archive">
  <div class="public-notes-archive__inner">

    {% for block in section.blocks %}
      <article class="public-note" {{ block.shopify_attributes }}>

        <div class="public-note__date">
          {{ block.settings.date }}
        </div>

        <h2 class="public-note__title">
          {{ block.settings.title }}
        </h2>

        <div class="public-note__context">
          {{ block.settings.context }}
        </div>

        {% if block.settings.link != blank %}
          <a
            class="public-note__link"
            href="{{ block.settings.link }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            {{ block.settings.link_label }}
          </a>
        {% endif %}

      </article>
    {% endfor %}

  </div>
</section>

<style>
  .public-notes-archive {
    padding: 0 24px 140px;
  }

  .public-notes-archive__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .public-note {
    padding-top: 48px;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .public-note + .public-note {
    margin-top: 88px;
  }

  .public-note__date {
    margin-bottom: 18px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.45);
  }

  .public-note__title {
    margin: 0;
    max-width: 720px;
    font-size: 28px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: rgba(var(--color-foreground), 1);
  }

  .public-note__context {
    max-width: 640px;
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.85;
    color: rgba(var(--color-foreground), 0.72);
  }

  .public-note__context p {
    margin: 0;
  }

  .public-note__link {
    display: inline-block;
    margin-top: 28px;
    font-size: 14px;
    line-height: 1.6;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.75);
    transition: opacity 0.25s ease;
  }

  .public-note__link:hover {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .public-notes-archive {
      padding: 0 24px 100px;
    }

    .public-note {
      padding-top: 36px;
    }

    .public-note + .public-note {
      margin-top: 72px;
    }

    .public-note__title {
      font-size: 24px;
      line-height: 1.3;
    }

    .public-note__context {
      margin-top: 20px;
      font-size: 15px;
      line-height: 1.8;
    }

    .public-note__link {
      margin-top: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Public Notes Archive",
  "blocks": [
    {
      "type": "reference",
      "name": "Reference",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "October 2026"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mirellis Launches Ritual Wellness Products for Sleep and Nervous-System Recovery"
        },
        {
          "type": "textarea",
          "id": "context",
          "label": "Context",
          "default": "A public release exploring Mirellis’ evening ritual philosophy around decompression, transition pacing, and nervous-system restoration."
        },
        {
          "type": "url",
          "id": "link",
          "label": "External Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Read Reference →"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Public Notes Archive"
    }
  ]
}
{% endschema %}