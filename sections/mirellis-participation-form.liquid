{% schema %}
{
  "name": "Mirellis Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Leave Your Details"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "Products are being shared directly by Mirellis as part of an early participation initiative. There is no purchase required. Over time, we simply value honest experience and thoughtful feedback."
    }
  ],
  "presets": [
    {
      "name": "Mirellis Form"
    }
  ]
}
{% endschema %}

<section
  class="mirellis-form-section"
  id="participation-form"
>

  <div class="mirellis-form-wrapper">

    <div class="mirellis-form-intro">

      <h2>
        {{ section.settings.heading }}
      </h2>

      <p>
        {{ section.settings.paragraph }}
      </p>

    </div>

    {% form 'contact' %}

      {% if form.posted_successfully? %}

        <div class="mirellis-success-message">
          Thank you. We’ll quietly review and reach out if the rituals feel aligned.
        </div>

      {% endif %}

      <!-- BASIC DETAILS -->

      <div class="mirellis-form-grid">

        <div class="mirellis-field">
          <input
            type="text"
            name="contact[name]"
            placeholder="Full Name"
            required
          >
        </div>

        <div class="mirellis-field">
          <input
            type="email"
            name="contact[email]"
            placeholder="Email Address"
            required
          >
        </div>

      </div>

      <div class="mirellis-form-grid">

        <div class="mirellis-field">
          <input
            type="tel"
            name="contact[phone]"
            placeholder="Phone Number"
            required
          >
        </div>

        <div class="mirellis-field">

          <select
            name="contact[profession]"
            required
          >

            <option value="">
              Profession / Space Type
            </option>

            <option>
              Wellness Practitioner
            </option>

            <option>
              Therapist
            </option>

            <option>
              Hospitality
            </option>

            <option>
              Writer / Artist
            </option>

            <option>
              Musician
            </option>

            <option>
              Yoga / Movement
            </option>

            <option>
              Designer / Architect
            </option>

            <option>
              Personal Use
            </option>

            <option>
              Other
            </option>

          </select>

        </div>

      </div>

      <!-- PRODUCT SELECTION -->

      <div class="mirellis-checkbox-group">

        <label>
          <input
            type="checkbox"
            name="contact[products]"
            value="Morning Clarity"
          >

          Morning Clarity
        </label>

        <label>
          <input
            type="checkbox"
            name="contact[products]"
            value="Stillness"
          >

          Stillness
        </label>

      </div>

      <!-- QUANTITY + INSTAGRAM -->

      <div class="mirellis-form-grid">

        <div class="mirellis-field">

          <select name="contact[quantity]">

            <option value="">
              Rituals Requested
            </option>

            <option>
              1
            </option>

            <option>
              2
            </option>

          </select>

        </div>

        <div class="mirellis-field">

          <input
            type="text"
            name="contact[instagram]"
            placeholder="Instagram Handle (Optional)"
          >

        </div>

      </div>

      <!-- ADDRESS -->

      <div class="mirellis-form-grid">

        <div class="mirellis-field">
          <input
            type="text"
            name="contact[address_line_1]"
            placeholder="House / Flat / Building"
            required
          >
        </div>

        <div class="mirellis-field">
          <input
            type="text"
            name="contact[address_line_2]"
            placeholder="Society / Lane / Area"
            required
          >
        </div>

      </div>

      <div class="mirellis-form-grid">

        <div class="mirellis-field">
          <input
            type="text"
            name="contact[city]"
            placeholder="City"
            required
          >
        </div>

        <div class="mirellis-field">
          <input
            type="text"
            name="contact[district]"
            placeholder="District"
            required
          >
        </div>

      </div>

      <div class="mirellis-form-grid">

        <div class="mirellis-field">
          <input
            type="text"
            name="contact[state]"
            placeholder="State"
            required
          >
        </div>

        <div class="mirellis-field">
          <input
            type="number"
            name="contact[pincode]"
            placeholder="PIN Code"
            required
          >
        </div>

      </div>

      <!-- RELEVANCE -->

      <div class="mirellis-field full-width">

        <textarea
          name="contact[relevance]"
          placeholder="Why does this feel relevant to you? (Optional)"
          rows="4"
        ></textarea>

      </div>

      <!-- PRIVACY NOTE -->

      <div class="mirellis-privacy-note">

        {%- comment -%}
          DPDP audit 2026-10-17: the old note said Mirellis does not share details with third
          parties, but the address goes to Shopify (form delivery) and to the courier that
          ships the sample. The link pointed at /pages/privacy-policy, an older August copy;
          the store policy of record is /policies/privacy-policy.
        {%- endcomment -%}
        We use these details to choose participants, send your products and talk to you about this experience,
        nothing else. They reach us by email through Shopify, our store platform, and your name and address go to the
        courier that delivers the products. We do not sell them or use them for advertising, and we delete them within
        12 months of the experience ending. To see, correct or delete them sooner, write to
        <a href="mailto:aseem@mirellis.in">aseem@mirellis.in</a>.

        <br><br>

        <a href="/policies/privacy-policy">
          View Privacy Policy
        </a>

      </div>

      <!-- CONSENT -->

      <div class="mirellis-consent">

        <label>

          <input
            type="checkbox"
            required
          >

          I agree to Mirellis using these details to consider me for this experience, deliver the products and contact me about it.

        </label>

      </div>

      <!-- SUBMIT -->

      <button
        type="submit"
        class="mirellis-submit-button"
      >
        Submit
      </button>

    {% endform %}

  </div>

</section>

<style>

.mirellis-form-section {
  background: #f4efe7;
  padding: 140px 24px;
}

.mirellis-form-wrapper {
  max-width: 920px;
  margin: 0 auto;
}

.mirellis-form-intro {
  text-align: center;
  margin-bottom: 72px;
}

.mirellis-form-intro h2 {
  font-size: clamp(38px, 5vw, 68px);
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #1a1a1a;
  margin-bottom: 24px;
  font-weight: 400;
}

.mirellis-form-intro p {
  max-width: 720px;
  margin: 0 auto;
  font-size: 18px;
  line-height: 1.9;
  color: rgba(20,20,20,0.72);
  font-weight: 300;
}

.mirellis-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}

.mirellis-field input,
.mirellis-field textarea,
.mirellis-field select {
  width: 100%;
  border: 1px solid rgba(20,20,20,0.12);
  background: rgba(255,255,255,0.42);
  padding: 22px 24px;
  font-size: 16px;
  color: #1a1a1a;
  font-family: inherit;
  outline: none;
  transition: all 0.3s ease;
}

.mirellis-field input:focus,
.mirellis-field textarea:focus,
.mirellis-field select:focus {
  border-color: rgba(20,20,20,0.32);
  background: rgba(255,255,255,0.72);
}

.mirellis-field textarea {
  resize: vertical;
}

.full-width {
  margin-bottom: 32px;
}

.mirellis-checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
  margin-bottom: 36px;
  padding: 8px 0;
}

.mirellis-checkbox-group label {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 15px;
  color: rgba(20,20,20,0.82);
}

.mirellis-checkbox-group input {
  width: 18px;
  height: 18px;
}

.mirellis-privacy-note {
  margin-bottom: 28px;
  font-size: 14px;
  line-height: 1.8;
  color: rgba(20,20,20,0.52);
  max-width: 620px;
}

.mirellis-privacy-note a {
  color: rgba(20,20,20,0.72);
  text-decoration: underline;
}

.mirellis-consent {
  margin-bottom: 28px;
}

.mirellis-consent label {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  font-size: 14px;
  line-height: 1.7;
  color: rgba(20,20,20,0.58);
}

.mirellis-consent input {
  margin-top: 4px;
}

.mirellis-submit-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18px 42px;
  background: #1a1a1a;
  color: #f4efe7;
  border: none;
  font-size: 15px;
  letter-spacing: 0.06em;
  cursor: pointer;
  transition: all 0.35s ease;
}

.mirellis-submit-button:hover {
  opacity: 0.88;
}

.mirellis-success-message {
  background: rgba(255,255,255,0.62);
  border: 1px solid rgba(20,20,20,0.08);
  padding: 24px;
  margin-bottom: 42px;
  color: #1a1a1a;
  line-height: 1.8;
}

@media screen and (max-width: 768px) {

  .mirellis-form-section {
    padding: 90px 20px;
  }

  .mirellis-form-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .mirellis-form-intro {
    margin-bottom: 54px;
  }

  .mirellis-form-intro h2 {
    font-size: 42px;
  }

  .mirellis-form-intro p {
    font-size: 16px;
    line-height: 1.8;
  }

  .mirellis-field input,
  .mirellis-field textarea,
  .mirellis-field select {
    padding: 18px 20px;
    font-size: 15px;
  }

  .mirellis-checkbox-group {
    gap: 18px;
  }

}

</style>