<section class="community-environments">

  <div class="community-environments-inner">

    <!-- HEADER -->

    <div class="community-environments-header">

      <div class="community-section-label">
        SELECTED ENVIRONMENTS
      </div>

      <h2 class="community-environments-heading">
        Spaces, textures, lighting, objects,
        and quieter environmental systems
        that reduce internal friction.
      </h2>

    </div>

    <!-- ENVIRONMENT GRID -->

    <div class="community-environments-grid">

      <!-- ENVIRONMENT 1 -->

      <div class="environment-card environment-large">

        <div class="environment-image environment-image-1"></div>

        <div class="environment-overlay">

          <div class="environment-title">
            Evening Corners
          </div>

          <div class="environment-text">
            Warm lighting, softer textures,
            slower transitions after cognitive overload.
          </div>

        </div>

      </div>

      <!-- ENVIRONMENT 2 -->

      <div class="environment-card">

        <div class="environment-image environment-image-2"></div>

        <div class="environment-overlay">

          <div class="environment-title">
            Reading Atmospheres
          </div>

        </div>

      </div>

      <!-- ENVIRONMENT 3 -->

      <div class="environment-card">

        <div class="environment-image environment-image-3"></div>

        <div class="environment-overlay">

          <div class="environment-title">
            Quiet Workspaces
          </div>

        </div>

      </div>

      <!-- ENVIRONMENT 4 -->

      <div class="environment-card environment-wide">

        <div class="environment-image environment-image-4"></div>

        <div class="environment-overlay">

          <div class="environment-title">
            Morning Light Rituals
          </div>

          <div class="environment-text">
            Environmental pacing before the internet enters the body.
          </div>

        </div>

      </div>

    </div>

  </div>

</section>

