<section style="background:#12171f;font-family:'Hanken Grotesk',system-ui,sans-serif">
  <div data-reveal style="position:relative;height:clamp({{ section.settings.height_min }}px,{{ section.settings.height_vw }}vw,{{ section.settings.height_max }}px);overflow:hidden">
    {%- if section.settings.image != blank -%}
      {%- assign band_img_src = section.settings.image | image_url: width: 1600 -%}
      <img src="{{ band_img_src }}" width="1600" height="900" alt="{{ section.settings.eyebrow }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.92"/>
    {%- endif -%}
    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(18,23,31,0.78) 0%,rgba(18,23,31,0.30) 55%,rgba(18,23,31,0.10) 100%)"></div>
    <div style="position:absolute;inset:0;display:flex;align-items:center">
      <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,5vw,48px);width:100%">
        <div style="max-width:420px;color:#ece7dd">
          {%- if section.settings.eyebrow != blank -%}
            <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#cf9266;margin-bottom:18px">{{ section.settings.eyebrow }}</div>
          {%- endif -%}
          <p style="font-family:'Newsreader',serif;font-size:clamp(22px,3vw,34px);line-height:1.3;margin:0">{{ section.settings.heading }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SE — Band Image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "The Transition" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A calming aromatic oil designed to support the transition from day to night." },
    { "type": "header", "content": "Height" },
    { "type": "range", "id": "height_min", "label": "Min height (px)", "min": 200, "max": 400, "step": 20, "default": 280 },
    { "type": "range", "id": "height_vw", "label": "Fluid height (vw)", "min": 20, "max": 60, "step": 2, "default": 42 },
    { "type": "range", "id": "height_max", "label": "Max height (px)", "min": 400, "max": 800, "step": 20, "default": 520 }
  ],
  "presets": [{ "name": "SE — Band Image" }]
}
{% endschema %}