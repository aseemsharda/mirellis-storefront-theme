<section
  class="editorial-sound-philosophy"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};

    {% if section.settings.bg_image != blank %}
      background-image:
        linear-gradient(
          rgba(0,0,0,{{ section.settings.overlay_opacity }}),
          rgba(0,0,0,{{ section.settings.overlay_opacity }})
        ),
        url('{{ section.settings.bg_image | image_url: width: 2200 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  "
>

  <div class="editorial-sound-philosophy__container">

    <div class="editorial-sound-philosophy__left">

      <p class="editorial-sound-philosophy__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h2 class="editorial-sound-philosophy__heading">
        {{ section.settings.heading }}
      </h2>

    </div>

    <div class="editorial-sound-philosophy__right">

      <div class="editorial-sound-philosophy__text rte">
        {{ section.settings.text }}
      </div>

    </div>

  </div>

</section>

<style>

.editorial-sound-philosophy {
  position: relative;
  padding: 180px 80px;
  overflow: hidden;
}

.editorial-sound-philosophy__container {
  max-width: 1440px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 120px;
  align-items: start;
}

.editorial-sound-philosophy__eyebrow {
  font-size: 11px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  opacity: 0.75;
  margin-bottom: 28px;
}

.editorial-sound-philosophy__heading {
  font-size: clamp(42px, 5vw, 74px);
  line-height: 1.02;
  letter-spacing: -0.04em;
  font-weight: 400;
  margin: 0;
  max-width: 580px;
  color: inherit;
}

.editorial-sound-philosophy__text {
  font-size: 18px;
  line-height: 2;
  max-width: 620px;
  opacity: 0.92;
  color: inherit;
}

.editorial-sound-philosophy__text p {
  margin-top: 0;
  margin-bottom: 34px;
}

.editorial-sound-philosophy__text p:last-child {
  margin-bottom: 0;
}

@media screen and (max-width: 990px) {

  .editorial-sound-philosophy {
    padding: 110px 28px;
  }

  .editorial-sound-philosophy__container {
    grid-template-columns: 1fr;
    gap: 52px;
  }

  .editorial-sound-philosophy__heading {
    font-size: 42px;
    line-height: 1.06;
  }

  .editorial-sound-philosophy__text {
    font-size: 16px;
    line-height: 1.9;
  }

}

</style>

{% schema %}
{
  "name": "Editorial Sound",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE PHILOSOPHY OF SOUND"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The nervous system responds to repeated sensory patterns."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sound influences atmosphere before conscious interpretation. Repeated auditory environments shape emotional pacing, environmental familiarity, and physiological rhythm.</p><p>Mirellis approaches sound not as entertainment, but as part of a broader sensory environment designed around moments of orientation, slowing, reflection, and restoration.</p><p>These sonic environments are intentionally restrained — built with warmth, spaciousness, repetition, and slower transitions that allow the body to gradually shift states rather than react abruptly.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0f0f10"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f1eb"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 0.9,
      "step": 0.1,
      "default": 0.3
    }
  ],
  "presets": [
    {
      "name": "Editorial Sound"
    }
  ]
}
{% endschema %}