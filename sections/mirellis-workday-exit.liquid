{{ 'mirellis-workday-exit.css' | asset_url | stylesheet_tag }}

<div class="mwe" id="workday-exit-{{ section.id }}">
  <section class="mwe__hero">
    <div class="mwe__shell mwe__hero-grid">
      <div>
        <p class="mwe__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p class="mwe__lead">{{ section.settings.lede }}</p>
      </div>
      <aside class="mwe__hero-aside" aria-label="What this page provides">
        <p>{{ section.settings.hero_promise }}</p>
        <span>{{ section.settings.hero_note }}</span>
      </aside>
    </div>
  </section>

  <section class="mwe__selector" aria-labelledby="mwe-question-{{ section.id }}">
    <div class="mwe__shell">
      <div class="mwe__selector-head">
        <div><p class="mwe__eyebrow">Help for right now</p><h2 id="mwe-question-{{ section.id }}">What is keeping work open tonight?</h2></div>
        <p class="mwe__selector-note">Choose the closest situation. The action changes with your answer; Mirellis does not score or diagnose it.</p>
      </div>
      <div class="mwe__choices" role="group" aria-label="Choose what is keeping work open">
        {% for block in section.blocks %}
          {% if block.type == 'route' %}<button class="mwe__choice" type="button" data-mwe-choice="{{ block.settings.route_id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}><strong>{{ block.settings.label }}</strong><span>Show my action</span></button>{% endif %}
        {% endfor %}
      </div>
      <div aria-live="polite">
        {% for block in section.blocks %}
          {% if block.type == 'route' %}
            <article class="mwe__result" data-mwe-result="{{ block.settings.route_id }}" {% unless forloop.first %}hidden{% endunless %}>
              <div class="mwe__result-copy"><p class="mwe__eyebrow">Your action for tonight</p><h3>{{ block.settings.result_heading }}</h3><p>{{ block.settings.acknowledgement }}</p><p class="mwe__promise">{{ block.settings.promise }}</p><div class="mwe__actions"><a class="mwe__button mwe__button--light" href="https://app.mirellis.in/?friction={{ block.settings.route_id }}">Do this with Mirellis now</a><a class="mwe__text-link" href="https://open.spotify.com/playlist/6VG02jtawiXTcOGi0nZzp6" target="_blank" rel="noopener">Use sound while I do it</a></div></div>
              <ol class="mwe__result-steps"><li><strong>{{ block.settings.step_1_title }}</strong><span>{{ block.settings.step_1_body }}</span></li><li><strong>{{ block.settings.step_2_title }}</strong><span>{{ block.settings.step_2_body }}</span></li><li><strong>{{ block.settings.step_3_title }}</strong><span>{{ block.settings.step_3_body }}</span></li></ol>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="mwe__programme">
    <div class="mwe__shell mwe__programme-grid">
      <div><p class="mwe__eyebrow">A repeatable ending</p><h2>The 21-day Workday Exit Programme.</h2><p class="mwe__lead">One seven-minute practice each day. It begins with a clear stopping point and gradually helps you handle interruptions, late requests, physical cues and difficult days.</p><div class="mwe__actions"><a class="mwe__button" href="https://app.mirellis.in">Choose my starting difficulty</a><a class="mwe__text-link" href="https://app.mirellis.in">See how reminders work</a></div></div>
      <div class="mwe__days" aria-label="Programme progression"><div class="mwe__day"><span>Days 1–7</span><strong>Make work end in a visible way.</strong></div><div class="mwe__day"><span>Days 8–14</span><strong>Handle the cues that reopen it.</strong></div><div class="mwe__day"><span>Days 15–20</span><strong>Build an ending for real, difficult days.</strong></div><div class="mwe__day"><span>Day 21</span><strong>Leave with a sequence you can use without Mirellis.</strong></div></div>
    </div>
  </section>

  <section class="mwe__media">
    <div class="mwe__shell"><p class="mwe__eyebrow">Support in different forms</p><h2>Advice is not the only format.</h2><div class="mwe__media-grid"><article class="mwe__media-card"><p class="mwe__eyebrow">Listen</p><h3>Stillness</h3><p>Use the playlist while you close the work surface, move rooms or begin the evening.</p><a class="mwe__text-link" href="{{ section.settings.spotify_url }}" target="_blank" rel="noopener">Open the Spotify playlist</a></article><article class="mwe__media-card"><p class="mwe__eyebrow">Understand</p><h3>Why work can remain mentally open.</h3><p>A qualified explanation of cognitive continuation, practical closure and what remains uncertain.</p><a class="mwe__text-link" href="{{ section.settings.finding_url }}">Read the current finding</a></article><article class="mwe__media-card"><p class="mwe__eyebrow">Practise</p><h3>Take one action now.</h3><p>Choose your real difficulty and let Mirellis guide the action, one step at a time.</p><a class="mwe__text-link" href="https://app.mirellis.in">Open After Work</a></article></div></div>
  </section>

  <section class="mwe__product">
    <div class="mwe__product-media">{% if section.settings.product_image != blank %}{{ section.settings.product_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600', alt: section.settings.product_image.alt }}{% endif %}</div>
    <div class="mwe__product-copy"><p class="mwe__eyebrow">Optional ritual instrument</p><h2>{{ section.settings.product_heading }}</h2><p>{{ section.settings.product_body }}</p><div class="mwe__actions"><a class="mwe__button mwe__button--light" href="{{ section.settings.product_url }}">See the product and price</a><a class="mwe__text-link" href="{{ section.settings.product_url }}">How it participates in the ritual</a></div></div>
  </section>

  <section class="mwe__trust">
    <div class="mwe__shell mwe__trust-grid"><div><p class="mwe__eyebrow">The trust boundary</p><h2>The person remains the authority.</h2></div><ul class="mwe__principles"><li><strong>No diagnosis.</strong><span>Your selected difficulty changes the action, not a hidden psychological profile.</span></li><li><strong>No false reminder.</strong><span>The web app explains that reminders are calendar events delivered by your own calendar.</span></li><li><strong>No required product.</strong><span>The programme works without Stillness Elixir or a Spotify account.</span></li><li><strong>No hidden record.</strong><span>Programme data stays in the browser and can be deleted from Settings.</span></li></ul></div>
  </section>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ section.settings.heading | json }},
  "description": {{ section.settings.lede | json }},
  "url": {{ canonical_url | json }},
  "isPartOf": {
    "@type": "WebSite",
    "name": "Mirellis",
    "url": "https://mirellis.in"
  },
  "about": {
    "@type": "Thing",
    "name": "Workday exit and work-to-recovery transition"
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Ways work can remain open after the workday",
    "itemListElement": [
      {% assign route_position = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'route' %}
          {% assign route_position = route_position | plus: 1 %}
          {
            "@type": "ListItem",
            "position": {{ route_position }},
            "name": {{ block.settings.label | json }},
            "description": {{ block.settings.acknowledgement | json }},
            "url": "https://app.mirellis.in/?friction={{ block.settings.route_id }}"
          }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ]
  }
}
</script>

<script>
(() => {
  const root = document.getElementById('workday-exit-{{ section.id }}');
  if (!root) return;
  const choices = Array.from(root.querySelectorAll('[data-mwe-choice]'));
  const results = Array.from(root.querySelectorAll('[data-mwe-result]'));
  choices.forEach((choice) => choice.addEventListener('click', () => {
    const selected = choice.getAttribute('data-mwe-choice');
    choices.forEach((item) => item.setAttribute('aria-pressed', String(item === choice)));
    results.forEach((result) => { result.hidden = result.getAttribute('data-mwe-result') !== selected; });
    const active = results.find((result) => !result.hidden);
    if (active) active.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
  }));
})();
</script>

{% schema %}
{
  "name": "Workday Exit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mirellis · After Work" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Work has ended. Why is it still with you?" },
    { "type": "textarea", "id": "lede", "label": "Introduction", "default": "Do not read another list of advice. Choose what is actually keeping work open and take one relevant action now." },
    { "type": "textarea", "id": "hero_promise", "label": "Promise", "default": "One real action now. A repeatable ending if you want it." },
    { "type": "textarea", "id": "hero_note", "label": "Trust note", "default": "Private by default · no score · no diagnosis · leaving is always allowed" },
    { "type": "url", "id": "spotify_url", "label": "Stillness Spotify URL" },
    { "type": "url", "id": "finding_url", "label": "Finding URL" },
    { "type": "image_picker", "id": "product_image", "label": "Stillness product photograph" },
    { "type": "text", "id": "product_heading", "label": "Product heading", "default": "A physical cue, if you want one." },
    { "type": "textarea", "id": "product_body", "label": "Product body", "default": "Stillness Elixir adds scent and touch to the moment work ends. It is an optional instrument inside the ritual, not a requirement and not a treatment." },
    { "type": "url", "id": "product_url", "label": "Product URL" }
  ],
  "blocks": [
    { "type": "route", "name": "Difficulty route", "limit": 4, "settings": [
      { "type": "select", "id": "route_id", "label": "App route", "options": [{"value":"unfinished","label":"Unfinished point"},{"value":"activated","label":"Body activated"},{"value":"checking","label":"Checking"},{"value":"scattered","label":"Scattered"}] },
      { "type": "text", "id": "label", "label": "Situation" },
      { "type": "text", "id": "result_heading", "label": "Action heading" },
      { "type": "textarea", "id": "acknowledgement", "label": "Acknowledgement" },
      { "type": "textarea", "id": "promise", "label": "Small promise" },
      { "type": "text", "id": "step_1_title", "label": "Step 1 title" }, { "type": "textarea", "id": "step_1_body", "label": "Step 1 body" },
      { "type": "text", "id": "step_2_title", "label": "Step 2 title" }, { "type": "textarea", "id": "step_2_body", "label": "Step 2 body" },
      { "type": "text", "id": "step_3_title", "label": "Step 3 title" }, { "type": "textarea", "id": "step_3_body", "label": "Step 3 body" }
    ] }
  ],
  "presets": [{ "name": "Workday Exit" }]
}
{% endschema %}
