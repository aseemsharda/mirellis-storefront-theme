{% stylesheet %}
[data-mc-reveal]{opacity:0;transform:translateY(18px);transition:opacity 0.85s cubic-bezier(.2,.7,.2,1),transform 0.85s cubic-bezier(.2,.7,.2,1)}
[data-mc-reveal].mc-on{opacity:1;transform:none}
.mc-obs-card{transition:border-color .3s,transform .3s;text-decoration:none}
.mc-obs-card:hover{border-color:#bb7a33!important;transform:translateY(-3px)}
@media(max-width:768px){.mc-3col{grid-template-columns:1fr!important}}
{% endstylesheet %}

<section style="background:{{ section.settings.bg_color }}">
  <div style="max-width:1180px;margin:0 auto;padding:104px 32px">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:46px">
      <div>
        <p data-mc-reveal style="margin:0 0 22px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:#bb7a33">{{ section.settings.eyebrow }}</p>
        <h2 data-mc-reveal style="margin:0;font-weight:400;font-size:40px;line-height:1.14;letter-spacing:-0.015em;color:#1f1c17">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.all_link != blank %}
        <a data-mc-reveal href="{{ section.settings.all_link }}" style="font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#5b5346;border-bottom:1px solid #bb7a33;padding-bottom:4px;text-decoration:none">All findings →</a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px" class="mc-3col">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
        <a data-mc-reveal href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }} class="mc-obs-card" style="display:flex;flex-direction:column;justify-content:space-between;min-height:230px;padding:26px 24px;background:#faf7f4;border:1px solid #e2d8ca;border-radius:5px">
          <span style="font-family:'Mulish',sans-serif;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:#bb7a33">{{ block.settings.tag }}</span>
          <span style="font-size:21px;line-height:1.32;color:#1f1c17;margin:18px 0 auto">{{ block.settings.title }}</span>
          <span style="font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.1em;color:#8a7f70;margin-top:22px">{{ block.settings.link_text | default: 'Read →' }}</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<script>
(function(){if(!window.mcBaseInit){window.mcBaseInit=true;document.addEventListener('DOMContentLoaded',function(){var io=null;if('IntersectionObserver' in window){io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('mc-on');io.unobserve(e.target);}});},{threshold:0.12});}document.querySelectorAll('[data-mc-reveal]').forEach(function(el){if(io){io.observe(el);}else{el.classList.add('mc-on');}});});}})();
</script>

{% schema %}
{
  "name": "MC — Observatory",
  "settings": [
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#f1ebe1"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the Observatory"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "The research behind this ritual"},
    {"type": "url", "id": "all_link", "label": "All findings link"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Research card",
      "settings": [
        {"type": "text", "id": "tag", "label": "Tag / category"},
        {"type": "textarea", "id": "title", "label": "Card title"},
        {"type": "text", "id": "link_text", "label": "Link text", "default": "Read →"},
        {"type": "url", "id": "url", "label": "Card URL"}
      ]
    }
  ],
  "presets": [{"name": "MC — Observatory"}]
}
{% endschema %}