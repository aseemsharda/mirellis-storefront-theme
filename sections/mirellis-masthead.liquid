<header class="hst-mast">
  <div class="hst-mast-in">
    <a href="#hst-top" class="hst-mast-logo">
      <span class="hst-mast-logo-main">MIRELLIS</span>
      <span class="hst-mast-logo-sub">/ OBSERVATORY</span>
    </a>
    <nav class="hst-mast-nav">
      <a href="#hst-s1">01 STUDY</a>
      <a href="#hst-s2">02 DOMAINS</a>
      <a href="#hst-s3">03 FRAMEWORK</a>
      <a href="#hst-s4">04 FINDINGS</a>
      <a href="#hst-s5">05 METHOD</a>
      <a href="#hst-s6">06 ACTIVITY</a>
      <a href="#hst-s7">07 PATHWAYS</a>
    </nav>
    <div class="hst-mast-live">
      <span class="hst-live-dot"></span>
      <span>LIVE</span>
      <span class="hst-live-time"></span>
    </div>
  </div>
</header>

{% stylesheet %}
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:#f4efe6;font-family:'Newsreader',Georgia,serif;font-weight:300;color:#1c1813;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
::selection{background:#35536c;color:#f4efe6;}
a{color:inherit;}

@keyframes hstPulse{0%{left:6%;opacity:0;}9%{opacity:1;}50%{transform:scale(1.5);}91%{opacity:1;}100%{left:94%;opacity:0;}}
@keyframes hstBlink{0%,100%{opacity:1;}50%{opacity:0.2;}}
@keyframes hstFade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

.hst-mast{position:sticky;top:0;z-index:50;background:rgba(244,239,230,0.88);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid rgba(28,24,19,0.16);}
.hst-mast-in{max-width:1280px;margin:0 auto;padding:0 clamp(20px,5vw,72px);height:54px;display:flex;align-items:center;justify-content:space-between;gap:24px;}
.hst-mast-logo{text-decoration:none;display:flex;align-items:baseline;gap:10px;white-space:nowrap;}
.hst-mast-logo-main{font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:13px;letter-spacing:0.34em;color:#1c1813;}
.hst-mast-logo-sub{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.22em;color:#978c7c;}
.hst-mast-nav{display:flex;align-items:center;gap:20px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.14em;color:#5b5349;}
.hst-mast-nav a{text-decoration:none;transition:color 0.15s;}
.hst-mast-nav a:hover{color:#35536c;}
.hst-mast-live{display:flex;align-items:center;gap:8px;white-space:nowrap;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#5b5349;}
.hst-live-dot{width:7px;height:7px;border-radius:50%;background:#35536c;display:inline-block;animation:hstBlink 1.8s ease-in-out infinite;}
.hst-live-time{color:#b7ab98;}

.hst-sec-label{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.2em;color:#978c7c;}
.hst-h2{font-weight:200;font-size:clamp(1.8rem,3.4vw,3rem);line-height:1.06;margin:0;}
.hst-2col-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px;margin-bottom:36px;}
.hst-desc{font-size:1.04rem;line-height:1.55;max-width:34ch;color:#3a342c;margin:0;}
.hst-arrow{color:#35536c;font-style:italic;}
.hst-dot{width:7px;height:7px;border-radius:50%;display:inline-block;}
.hst-badge{display:inline-flex;align-items:center;gap:7px;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.1em;}

@media(max-width:900px){.hst-mast-nav{display:none;}}
{% endstylesheet %}

