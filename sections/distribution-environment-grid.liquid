<section class="distribution-grid">

  <div class="page-width">

    {% if section.settings.subheading != blank %}
      <p class="distribution-grid__subheading">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="distribution-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="distribution-grid__intro">
        {{ section.settings.text }}
      </div>
    {% endif %}

    <div class="distribution-grid__wrapper">

      {% for block in section.blocks %}

        <div class="distribution-grid__card">

          {% if block.settings.image != blank %}
            <div class="distribution-grid__image-wrapper">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'distribution-grid__image'
              }}
            </div>
          {% endif %}

          <div class="distribution-grid__content">

            {% if block.settings.title != blank %}
              <h3 class="distribution-grid__card-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="distribution-grid__card-text">
                {{ block.settings.text }}
              </div>
            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

<style>

.distribution-grid {
  background: #f4f0ea;
  padding: 140px 0;
}

.distribution-grid__subheading {
  text-align: center;
  font-size: 12px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: #a89584;
  margin-bottom: 24px;
}

.distribution-grid__heading {
  text-align: center;
  font-size: clamp(42px, 6vw, 88px);
  line-height: 0.95;
  font-weight: 300;
  letter-spacing: -0.04em;
  color: #1d1d1d;
  max-width: 900px;
  margin: 0 auto 40px;
}

.distribution-grid__intro {
  max-width: 850px;
  margin: 0 auto 100px;
  text-align: center;
  font-size: 21px;
  line-height: 1.9;
  color: #5f5a54;
}

.distribution-grid__wrapper {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 48px;
}

.distribution-grid__card {
  background: #f7f4ef;
  border-radius: 36px;
  overflow: hidden;
}

.distribution-grid__image-wrapper {
  aspect-ratio: 4/5;
  overflow: hidden;
}

.distribution-grid__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.distribution-grid__content {
  padding: 42px;
}

.distribution-grid__card-title {
  font-size: 40px;
  line-height: 1;
  font-weight: 300;
  margin-bottom: 24px;
  color: #1f1f1f;
}

.distribution-grid__card-text {
  font-size: 20px;
  line-height: 1.9;
  color: #5e5954;
}

@media screen and (max-width: 989px) {

  .distribution-grid {
    padding: 90px 0;
  }

  .distribution-grid__wrapper {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .distribution-grid__content {
    padding: 30px;
  }

  .distribution-grid__card-title {
    font-size: 30px;
  }

  .distribution-grid__card-text {
    font-size: 18px;
    line-height: 1.8;
  }

}

</style>

{% schema %}
{
  "name": "Env Grid",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Env Grid"
    }
  ]
}
{% endschema %}