<section class="sound-hero">
  <div class="sound-hero__video-wrapper">

    {% if section.settings.hero_video != blank %}
      {{
        section.settings.hero_video
        | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        playsinline: true,
        class: 'sound-hero__video'
      }}
    {% endif %}

    <div class="sound-hero__overlay"></div>
    <div class="sound-hero__grain"></div>
  </div>

  <div class="sound-hero__content">
    <p class="sound-hero__eyebrow">
      {{ section.settings.eyebrow }}
    </p>

    <h1 class="sound-hero__heading">
      {{ section.settings.heading }}
    </h1>

    <div class="sound-hero__text">
      {{ section.settings.text }}
    </div>

    <div class="sound-hero__buttons">
      {% if section.settings.primary_button_label != blank %}
        <a href="{{ section.settings.primary_button_link }}" class="sound-hero__button sound-hero__button--primary">
          {{ section.settings.primary_button_label }}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_label != blank %}
        <a href="{{ section.settings.secondary_button_link }}" class="sound-hero__button sound-hero__button--secondary">
          {{ section.settings.secondary_button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>

.sound-hero {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: transparent;
  color: #1a1a18;
}

.sound-hero__video-wrapper {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.sound-hero__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.03);
  filter: brightness(0.52);
}

.sound-hero__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,0.30) 0%,
      rgba(0,0,0,0.45) 45%,
      rgba(0,0,0,0.72) 100%
    );
  z-index: 2;
}

.sound-hero__grain {
  position: absolute;
  inset: 0;
  opacity: 0.08;
  z-index: 3;
  background-image:
    url("https://cdn.shopify.com/s/files/1/0735/9738/6972/files/grain.png?v=1");
  background-size: cover;
  mix-blend-mode: soft-light;
}

.sound-hero__content {
  position: relative;
  z-index: 5;
  max-width: 760px;
  height: 100%;
  padding:
    0
    80px
    110px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sound-hero__eyebrow {
  font-size: 11px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  opacity: 0.68;
  margin-bottom: 28px;
  font-weight: 500;
}

.sound-hero__heading {
  font-size: clamp(48px, 7vw, 92px);
  line-height: 0.96;
  letter-spacing: -0.04em;
  font-weight: 400;
  margin: 0;
  max-width: 700px;
}

.sound-hero__text {
  margin-top: 34px;
  max-width: 560px;
  font-size: 17px;
  line-height: 1.9;
  color: rgba(26,26,24,0.7);
}

.sound-hero__buttons {
  display: flex;
  gap: 16px;
  margin-top: 42px;
  flex-wrap: wrap;
}

.sound-hero__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 24px;
  border-radius: 999px;
  text-decoration: none;
  transition: all 0.35s ease;
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.sound-hero__button--primary {
  background: rgba(26,26,24,0.1);
  border: 1px solid rgba(26,26,24,0.1);
  color: #1a1a18;
  backdrop-filter: blur(10px);
}

.sound-hero__button--primary:hover {
  background: rgba(26,26,24,0.15);
  transform: translateY(-1px);
}

.sound-hero__button--secondary {
  border: 1px solid rgba(26,26,24,0.15);
  color: rgba(26,26,24,0.6);
}

.sound-hero__button--secondary:hover {
  border-color: rgba(26,26,24,0.3);
  color: #1a1a18;
}

@media screen and (max-width: 768px) {

  .sound-hero {
    height: 100svh;
  }

  .sound-hero__content {
    padding:
      0
      28px
      72px;
  }

  .sound-hero__eyebrow {
    margin-bottom: 18px;
  }

  .sound-hero__heading {
    font-size: 46px;
    line-height: 1.02;
  }

  .sound-hero__text {
    font-size: 15px;
    line-height: 1.8;
    margin-top: 24px;
  }

  .sound-hero__buttons {
    margin-top: 32px;
    gap: 12px;
  }

  .sound-hero__button {
    width: 100%;
  }

}

</style>

{% schema %}
{
  "name": "Sound Hero",
  "settings": [
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero Video"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MIRELLIS SOUND"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Sound shapes the pace of the nervous system."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Mirellis sound environments are designed as rhythmic sensory spaces for moments of orientation, slowing, reflection, and restoration.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary Button Label",
      "default": "Listen on Spotify"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Explore Ritual Sound"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Sound Hero"
    }
  ]
}
{% endschema %}