<section style="background:{{ section.settings.bg_color }};font-family:'Hanken Grotesk',system-ui,sans-serif">
  <div style="max-width:1240px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,5vw,48px)">
    <div data-reveal style="margin-bottom:clamp(40px,6vw,72px);max-width:620px">
      {%- if section.settings.eyebrow != blank -%}
        <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#b07f54;margin-bottom:18px">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(30px,4.4vw,52px);margin:0;letter-spacing:-0.01em;color:{{ section.settings.text_color }}">{{ section.settings.heading }}</h2>
    </div>

    <div data-reveal>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }} style="border-top:1px solid #e0d8cc">
          <button onclick="seAccToggle(this)" aria-expanded="false" style="width:100%;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0;background:none;border:none;cursor:pointer;text-align:left">
            <span style="font-family:'Newsreader',serif;font-size:clamp(17px,1.8vw,21px);font-weight:500;color:{{ section.settings.text_color }}">{{ block.settings.title }}</span>
            <span class="se-acc-icon" style="font-size:22px;color:#cf9266;flex-shrink:0;transition:transform .25s">+</span>
          </button>
          <div class="se-acc-body" style="display:none;padding-bottom:24px">
            <p style="font-size:15px;line-height:1.8;color:#6f665b;margin:0">{{ block.settings.body }}</p>
            {%- if block.settings.source != blank -%}
              <p style="font-size:12px;color:#9a8f83;margin:12px 0 0;font-style:italic">{{ block.settings.source }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      <div style="border-top:1px solid #e0d8cc"></div>
    </div>
  </div>
</section>

<script>
  function seAccToggle(btn) {
    var body = btn.nextElementSibling;
    var icon = btn.querySelector('.se-acc-icon');
    var open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', open ? 'false' : 'true');
    body.style.display = open ? 'none' : 'block';
    icon.style.transform = open ? '' : 'rotate(45deg)';
  }
</script>

{% schema %}
{
  "name": "SE — Research",
  "blocks": [
    {
      "type": "item",
      "name": "Research Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Research finding" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Describe the research here." },
        { "type": "text", "id": "source", "label": "Source / citation" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Evidence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Centuries of use. Emerging science." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf7f4" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#26221d" }
  ],
  "presets": [
    {
      "name": "SE — Research",
      "blocks": [
        { "type": "item", "settings": { "title": "Ashwagandha & cortisol reduction", "body": "Multiple clinical trials have explored Ashwagandha's role in stress response. A 2019 study published in Medicine found significant reductions in perceived stress and cortisol levels among participants who took standardised root extract over 8 weeks.", "source": "Chandrasekhar et al., Indian Journal of Psychological Medicine, 2012." } },
        { "type": "item", "settings": { "title": "Valerian root & sleep quality", "body": "Valerian (Tagar) has been studied for its potential role in sleep onset and quality. Research suggests compounds including valerenic acid may interact with GABA receptors, supporting relaxation without sedation.", "source": "Fernández-San-Martín et al., Sleep Medicine, 2010." } },
        { "type": "item", "settings": { "title": "Aromatic compounds & the limbic system", "body": "Olfactory receptors have a direct neural pathway to the limbic system — the brain's emotional centre. This is why scent can shift emotional states more rapidly than visual or auditory cues.", "source": "Herz, R.S., Chemical Senses, 2009." } },
        { "type": "item", "settings": { "title": "Lavender & autonomic nervous system", "body": "Inhalation of lavender essential oil has been associated with reduced heart rate variability markers of stress and increased parasympathetic (rest-and-digest) nervous system activity.", "source": "Sayorwan et al., Journal of the Medical Association of Thailand, 2012." } }
      ]
    }
  ]
}
{% endschema %}