{% stylesheet %}
[data-mc-reveal]{opacity:0;transform:translateY(18px);transition:opacity 0.85s cubic-bezier(.2,.7,.2,1),transform 0.85s cubic-bezier(.2,.7,.2,1)}
[data-mc-reveal].mc-on{opacity:1;transform:none}
.mc-rush-card img{transition:transform .6s ease}
.mc-rush-card:hover img{transform:scale(1.04)}
@media(max-width:768px){.mc-3col{grid-template-columns:1fr!important}}
{% endstylesheet %}

<section style="background:{{ section.settings.bg_color }}">
  <div style="max-width:1180px;margin:0 auto;padding:104px 32px">
    <div style="max-width:62ch">
      <p data-mc-reveal style="margin:0 0 26px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:#bb7a33">{{ section.settings.eyebrow }}</p>
      <h2 data-mc-reveal style="margin:0;font-weight:400;font-size:40px;line-height:1.2;letter-spacing:-0.01em;color:#1f1c17">{{ section.settings.heading }}</h2>
      <p data-mc-reveal style="margin:24px 0 0;font-size:19px;line-height:1.62;color:#5b5346;max-width:52ch">{{ section.settings.body }}</p>
    </div>

    {% if section.blocks.size > 0 %}
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px" class="mc-3col">
      {% for block in section.blocks %}
        {% if block.type == 'rush_card' %}
        <figure data-mc-reveal class="mc-rush-card" {{ block.shopify_attributes }} style="margin:0;display:flex;flex-direction:column">
          <div style="border-radius:5px;overflow:hidden;background:#ede5da;aspect-ratio:1/1">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 1122 }}" alt="{{ block.settings.caption }}" width="1122" height="1122" style="width:100%;height:100%;object-fit:cover">
            {% elsif block.settings.fallback_url != blank %}
              <img src="{{ block.settings.fallback_url }}" alt="{{ block.settings.caption }}" width="1122" height="1122" style="width:100%;height:100%;object-fit:cover">
            {% endif %}
          </div>
          <figcaption style="display:flex;align-items:baseline;gap:12px;margin-top:18px">
            <span style="font-family:'Mulish',sans-serif;font-size:11px;color:#bb7a33;letter-spacing:0.1em">{{ block.settings.number }}</span>
            <span style="font-size:20px;color:#1f1c17">{{ block.settings.caption }}</span>
          </figcaption>
        </figure>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<script>
(function(){if(!window.mcBaseInit){window.mcBaseInit=true;document.addEventListener('DOMContentLoaded',function(){var io=null;if('IntersectionObserver' in window){io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('mc-on');io.unobserve(e.target);}});},{threshold:0.12});}document.querySelectorAll('[data-mc-reveal]').forEach(function(el){if(io){io.observe(el);}else{el.classList.add('mc-on');}});});}})();
</script>

{% schema %}
{
  "name": "MC — Rush",
  "settings": [
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#faf7f4"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The cost of urgency"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Mornings often begin in a rush."},
    {"type": "textarea", "id": "body", "label": "Body text", "default": "Over time, this disrupts digestion, focus, and the body's natural rhythm of waking. Morning Clarity was created to restore the first moment of the day — allowing the body and mind to transition into activity with intention rather than urgency."}
  ],
  "blocks": [
    {
      "type": "rush_card",
      "name": "Rush card",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "fallback_url", "label": "Fallback image URL"},
        {"type": "text", "id": "number", "label": "Number label", "default": "01"},
        {"type": "text", "id": "caption", "label": "Caption"}
      ]
    }
  ],
  "presets": [{"name": "MC — Rush"}]
}
{% endschema %}