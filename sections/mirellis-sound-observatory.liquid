<!-- MIRELLIS SOUND — LAYER 3: THE SOUND OBSERVATORY -->
<div id="mso-root-{{ section.id }}">
<style>
#mso-root-{{ section.id }} .mso-section {
  background: {{ section.settings.bg_color }};
  padding: 80px 2rem;
  border-bottom: 1px solid #ddd6cc;
}
#mso-root-{{ section.id }} .mso-wrap {
  max-width: 1000px;
  margin: 0 auto;
}
#mso-root-{{ section.id }} .mso-header {
  margin-bottom: 60px;
  max-width: 700px;
}
#mso-root-{{ section.id }} .mso-eyebrow {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #8b6f47;
  margin: 0 0 20px 0;
  display: flex;
  align-items: center;
  gap: 14px;
}
#mso-root-{{ section.id }} .mso-eyebrow::after {
  content: "";
  flex: 1;
  height: 1px;
  background: #ddd6cc;
  max-width: 120px;
}
#mso-root-{{ section.id }} .mso-heading {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(26px, 3.5vw, 42px);
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin: 0 0 24px 0;
  color: #1a1a18;
}
#mso-root-{{ section.id }} .mso-intro {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 16px;
  color: #6b6b66;
  line-height: 1.7;
  max-width: 52ch;
  margin: 0;
}

#mso-root-{{ section.id }} .mso-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2px;
  background: #ddd6cc;
  border: 1px solid #ddd6cc;
  margin-bottom: 40px;
}
#mso-root-{{ section.id }} .mso-card {
  background: #fcfaf6;
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
#mso-root-{{ section.id }} .mso-card-num {
  font-family: 'SFMono-Regular', Menlo, Consolas, monospace;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #6b6b66;
  margin: 0;
}
#mso-root-{{ section.id }} .mso-card-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(18px, 2.5vw, 24px);
  font-weight: 400;
  letter-spacing: -0.01em;
  line-height: 1.2;
  margin: 0;
  color: #1a1a18;
}
#mso-root-{{ section.id }} .mso-card-question {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 15px;
  color: #6b6b66;
  line-height: 1.6;
  margin: 0;
}
#mso-root-{{ section.id }} .mso-status {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #6b6b66;
  padding-top: 12px;
  border-top: 1px solid #ddd6cc;
  margin-top: auto;
}

#mso-root-{{ section.id }} .mso-note {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 14px;
  color: #6b6b66;
  line-height: 1.7;
  max-width: 52ch;
  padding: 28px;
  background: #fcfaf6;
  border: 1px solid #ddd6cc;
}
#mso-root-{{ section.id }} .mso-note p { margin: 0; }

@media (max-width: 640px) {
  #mso-root-{{ section.id }} .mso-section { padding: 60px 1.5rem; }
  #mso-root-{{ section.id }} .mso-grid { grid-template-columns: 1fr; gap: 1px; }
  #mso-root-{{ section.id }} .mso-card { padding: 2rem; }
  #mso-root-{{ section.id }} .mso-header { margin-bottom: 40px; }
  #mso-root-{{ section.id }} .mso-eyebrow::after { max-width: 64px; }
}
</style>

<div class="mso-section">
  <div class="mso-wrap">
    <div class="mso-header">
      <p class="mso-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="mso-heading">{{ section.settings.heading }}</h2>
      <p class="mso-intro">{{ section.settings.intro }}</p>
    </div>

    <div class="mso-grid">
      {% for block in section.blocks %}
        <div class="mso-card" {{ block.shopify_attributes }}>
          {% if block.settings.num != blank %}<p class="mso-card-num">{{ block.settings.num }}</p>{% endif %}
          <h3 class="mso-card-title">{{ block.settings.title }}</h3>
          {% if block.settings.question != blank %}<p class="mso-card-question">{{ block.settings.question }}</p>{% endif %}
          {% if block.settings.status != blank %}<p class="mso-status">{{ block.settings.status }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.note != blank %}
      <div class="mso-note">{{ section.settings.note }}</div>
    {% endif %}
  </div>
</div>
</div>

{% schema %}
{
  "name": "Sound Observatory",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Active Research" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Sound Observatory" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "These are the questions currently under investigation. Not conclusions. Not claims. Open questions the Observatory is studying." },
    { "type": "header", "content": "Closing Note" },
    { "type": "richtext", "id": "note", "label": "Note", "default": "<p>These observations are gathered from people using Mirellis Sound environments consistently over weeks and months. The patterns that emerge from your data help us understand which transitions sound influences most strongly.</p>" },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf7f2" }
  ],
  "blocks": [
    {
      "type": "study",
      "name": "Study",
      "settings": [
        { "type": "text", "id": "num", "label": "Number", "default": "Study 01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Repetition vs Novelty" },
        { "type": "textarea", "id": "question", "label": "Question", "default": "Does repeated exposure strengthen transition effects over time?" },
        { "type": "text", "id": "status", "label": "Status", "default": "Under Investigation" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Sound Observatory",
      "blocks": [
        { "type": "study", "settings": { "num": "Study 01", "title": "Repetition vs Novelty", "question": "Does repeated exposure strengthen transition effects over time?", "status": "Under Investigation" } },
        { "type": "study", "settings": { "num": "Study 02", "title": "Time-of-Day Effects", "question": "Does Morning Clarity function differently at different hours of the day?", "status": "Under Investigation" } },
        { "type": "study", "settings": { "num": "Study 03", "title": "Ritual Pairing Effects", "question": "Does sound become more effective when paired with scent and touch?", "status": "Under Investigation" } },
        { "type": "study", "settings": { "num": "Study 04", "title": "Environmental Consistency", "question": "Does listening in the same location strengthen association?", "status": "Under Investigation" } }
      ]
    }
  ]
}
{% endschema %}