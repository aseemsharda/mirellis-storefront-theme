{% comment %}
Transition Research Archive Section
All research articles for a transition, filterable by topic
{% endcomment %}

<section class="transition-archive">
  <div class="transition-archive__container">
    
    <h2 class="transition-archive__title">Full Research Archive</h2>

    <div class="transition-archive__filters">
      <button class="transition-archive__filter-button transition-archive__filter-button--active" data-topic="all">
        All Topics
      </button>
      <button class="transition-archive__filter-button" data-topic="neurobiology">
        Neurobiology
      </button>
      <button class="transition-archive__filter-button" data-topic="circadian">
        Circadian Timing
      </button>
      <button class="transition-archive__filter-button" data-topic="behavior">
        Behavior & Habit
      </button>
    </div>

    <div class="transition-archive__grid">
      
      <article class="transition-archive__item" data-topic="neurobiology">
        <div class="transition-archive__item-header">
          <h3 class="transition-archive__item-title">
            <a href="/blogs/journal/how-your-prefrontal-cortex-boots-up">How Your Prefrontal Cortex Boots Up</a>
          </h3>
          <span class="transition-archive__topic-tag">Neurobiology</span>
        </div>
        <p class="transition-archive__item-excerpt">
          Your executive function doesn't activate instantly. The prefrontal cortex needs specific signals to engage.
        </p>
        <div class="transition-archive__item-meta">
          <span class="transition-archive__reading-time">8 min</span>
          <span class="transition-archive__date">Published Jan 2026</span>
        </div>
      </article>

      <article class="transition-archive__item" data-topic="neurobiology">
        <div class="transition-archive__item-header">
          <h3 class="transition-archive__item-title">
            <a href="/blogs/journal/arousal-vs-consciousness">Arousal vs. Consciousness: Why You're Not Fully Awake Yet</a>
          </h3>
          <span class="transition-archive__topic-tag">Neurobiology</span>
        </div>
        <p class="transition-archive__item-excerpt">
          Being awake and being conscious are different neurological states. Understanding the gap changes how you approach mornings.
        </p>
        <div class="transition-archive__item-meta">
          <span class="transition-archive__reading-time">7 min</span>
          <span class="transition-archive__date">Published Jan 2026</span>
        </div>
      </article>

      <article class="transition-archive__item" data-topic="neurobiology">
        <div class="transition-archive__item-header">
          <h3 class="transition-archive__item-title">
            <a href="/blogs/journal/the-reticular-activating-system">The Reticular Activating System: Why the Transition Is Hard</a>
          </h3>
          <span class="transition-archive__topic-tag">Neurobiology</span>
        </div>
        <p class="transition-archive__item-excerpt">
          Sleep inertia is real. Your brain's primary attention system needs time to reboot after sleep.
        </p>
        <div class="transition-archive__item-meta">
          <span class="transition-archive__reading-time">9 min</span>
          <span class="transition-archive__date">Published Jan 2026</span>
        </div>
      </article>

      <article class="transition-archive__item" data-topic="circadian">
        <div class="transition-archive__item-header">
          <h3 class="transition-archive__item-title">
            <a href="/blogs/journal/cortisol-timing-and-morning-activation">Cortisol Timing and Morning Activation</a>
          </h3>
          <span class="transition-archive__topic-tag">Circadian Timing</span>
        </div>
        <p class="transition-archive__item-excerpt">
          Cortisol naturally peaks upon waking. Understanding the rhythm lets you work with it instead of against it.
        </p>
        <div class="transition-archive__item-meta">
          <span class="transition-archive__reading-time">7 min</span>
          <span class="transition-archive__date">Published Jan 2026</span>
        </div>
      </article>

      <article class="transition-archive__item" data-topic="circadian">
        <div class="transition-archive__item-header">
          <h3 class="transition-archive__item-title">
            <a href="/blogs/journal/light-exposure-and-melatonin">Light Exposure and Melatonin Production: Why Dark Mornings Are Harder</a>
          </h3>
          <span class="transition-archive__topic-tag">Circadian Timing</span>
        </div>
        <p class="transition-archive__item-excerpt">
          The absence of light keeps melatonin elevated, extending sleep mode into waking hours. First light is critical.
        </p>
        <div class="transition-archive__item-meta">
          <span class="transition-archive__reading-time">8 min</span>
          <span class="transition-archive__date">Published Jan 2026</span>
        </div>
      </article>

      <article class="transition-archive__item" data-topic="behavior">
        <div class="transition-archive__item-header">
          <h3 class="transition-archive__item-title">
            <a href="/blogs/journal/morning-routine-anchoring">Morning Routine Anchoring: Why Consistency Matters More Than Content</a>
          </h3>
          <span class="transition-archive__topic-tag">Behavior & Habit</span>
        </div>
        <p class="transition-archive__item-excerpt">
          The specific actions matter less than the consistency. Your brain learns the anchor point, not the activity.
        </p>
        <div class="transition-archive__item-meta">
          <span class="transition-archive__reading-time">6 min</span>
          <span class="transition-archive__date">Published Jan 2026</span>
        </div>
      </article>

      <article class="transition-archive__item" data-topic="behavior">
        <div class="transition-archive__item-header">
          <h3 class="transition-archive__item-title">
            <a href="/blogs/journal/micro-exposures-and-wakefulness">Micro-Exposures and Wakefulness: Small Stimuli, Big Effects</a>
          </h3>
          <span class="transition-archive__topic-tag">Behavior & Habit</span>
        </div>
        <p class="transition-archive__item-excerpt">
          Cold water, light intensity, temperature shifts—tiny sensory inputs trigger large neurological responses.
        </p>
        <div class="transition-archive__item-meta">
          <span class="transition-archive__reading-time">7 min</span>
          <span class="transition-archive__date">Published Jan 2026</span>
        </div>
      </article>

    </div>

  </div>
</section>

<style>
  .transition-archive {
    padding: 4rem 2rem;
    background: #fff;
  }

  .transition-archive__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .transition-archive__title {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 400;
    color: #1a1a18;
    margin-bottom: 2rem;
  }

  .transition-archive__filters {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .transition-archive__filter-button {
    padding: 0.6rem 1.2rem;
    border: 1px solid rgba(26, 26, 24, 0.2);
    background: #fff;
    color: #1a1a18;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .transition-archive__filter-button:hover {
    border-color: #1a1a18;
    background: #faf7f2;
  }

  .transition-archive__filter-button--active {
    background: #1a1a18;
    color: #fff;
    border-color: #1a1a18;
  }

  .transition-archive__grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .transition-archive__item {
    padding: 1.5rem;
    background: #faf7f2;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .transition-archive__item:hover {
    background: #f5f2ed;
  }

  .transition-archive__item.hidden {
    display: none;
  }

  .transition-archive__item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .transition-archive__item-title {
    margin: 0;
    flex: 1;
  }

  .transition-archive__item-title a {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    color: #1a1a18;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .transition-archive__item-title a:hover {
    color: #666;
  }

  .transition-archive__topic-tag {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    background: rgba(26, 26, 24, 0.08);
    color: #666;
    font-size: 0.8rem;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .transition-archive__item-excerpt {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #666;
    margin: 0 0 0.75rem 0;
  }

  .transition-archive__item-meta {
    font-size: 0.85rem;
    color: #999;
    display: flex;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .transition-archive {
      padding: 3rem 1.5rem;
    }

    .transition-archive__title {
      font-size: 1.5rem;
    }

    .transition-archive__filters {
      gap: 0.5rem;
    }

    .transition-archive__filter-button {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }

    .transition-archive__item-header {
      flex-direction: column;
    }

    .transition-archive__topic-tag {
      order: -1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const filterButtons = document.querySelectorAll('.transition-archive__filter-button');
    const archiveItems = document.querySelectorAll('.transition-archive__item');

    filterButtons.forEach(button => {
      button.addEventListener('click', function() {
        const selectedTopic = this.getAttribute('data-topic');

        filterButtons.forEach(btn => {
          btn.classList.remove('transition-archive__filter-button--active');
        });
        this.classList.add('transition-archive__filter-button--active');

        archiveItems.forEach(item => {
          const itemTopic = item.getAttribute('data-topic');
          if (selectedTopic === 'all' || itemTopic === selectedTopic) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Research Archive",
  "settings": []
}
{% endschema %}