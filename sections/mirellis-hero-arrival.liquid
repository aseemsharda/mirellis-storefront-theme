{% comment %}
MIRELLIS — SCENE 01
ARRIVAL HERO (Cinematic Video First System)
{% endcomment %}

<section id="mirellisHero" class="mirellis-hero">

  <!-- =========================
       VIDEO / MEDIA LAYER
  ========================== -->

  <div class="mirellis-media">

    {% if section.settings.video != blank %}

      <!-- Shopify MP4 VIDEO -->
      <video
        id="heroVideo"
        class="mirellis-video"
        autoplay
        muted
        loop
        playsinline
      >
        <source src="{{ section.settings.video }}" type="video/mp4">
      </video>

    {% elsif section.settings.youtube != blank %}

      <!-- YOUTUBE EMBED -->
      <iframe
        class="mirellis-video"
        src="https://www.youtube.com/embed/{{ section.settings.youtube | split: 'v=' | last }}?autoplay=1&mute=1&controls=0&loop=1&playlist={{ section.settings.youtube | split: 'v=' | last }}"
        frameborder="0"
        allow="autoplay; fullscreen"
        allowfullscreen
      ></iframe>

    {% elsif section.settings.image != blank %}

      <!-- FALLBACK IMAGE -->
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: class: 'mirellis-image'
      }}

    {% endif %}

  </div>

  <!-- =========================
       ATMOSPHERIC OVERLAY
  ========================== -->

  <div class="mirellis-overlay"></div>

  <!-- =========================
       CONTENT LAYER
  ========================== -->

  <div class="mirellis-content">

    {% if section.settings.heading != blank %}
      <h1 class="mirellis-title">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="mirellis-subtext">
        {{ section.settings.subtext }}
      </p>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_link }}" class="mirellis-cta">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}

  </div>

  <!-- =========================
       SIMPLE CONTROLS (SAFE)
  ========================== -->

  {% if section.settings.video != blank %}

    <div class="mirellis-controls">

      <button id="muteBtn">Mute</button>
      <button id="fsBtn">Fullscreen</button>

    </div>

  {% endif %}

</section>

<style>

/* =========================
   HERO ARRIVAL SYSTEM
========================= */

.mirellis-hero {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  background: #f6f1ea;
}

/* MEDIA */
.mirellis-media {
  position: absolute;
  inset: 0;
}

.mirellis-video,
.mirellis-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* OVERLAY */
.mirellis-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at 50% 40%,
    rgba(246,241,232,0.2),
    rgba(246,241,232,0.9)
  );
}

/* CONTENT */
.mirellis-content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 0 24px;
}

.mirellis-title {
  font-size: clamp(30px, 4vw, 64px);
  font-weight: 400;
  color: #1c1c1c;
  margin-bottom: 16px;
}

.mirellis-subtext {
  font-size: 16px;
  color: rgba(28,28,28,0.7);
  max-width: 620px;
  margin-bottom: 30px;
}

.mirellis-cta {
  padding: 10px 18px;
  border: 1px solid rgba(0,0,0,0.2);
  text-decoration: none;
  color: #1c1c1c;
}

/* CONTROLS */
.mirellis-controls {
  position: absolute;
  bottom: 20px;
  right: 20px;
  z-index: 3;
  display: flex;
  gap: 10px;
}

.mirellis-controls button {
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(0,0,0,0.1);
  padding: 6px 10px;
  cursor: pointer;
}

/* FULLSCREEN */
.mirellis-fullscreen {
  position: fixed;
  inset: 0;
  z-index: 9999;
}

</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const hero = document.getElementById("mirellisHero");
  const video = document.getElementById("heroVideo");

  const muteBtn = document.getElementById("muteBtn");
  const fsBtn = document.getElementById("fsBtn");

  // MUTE ONLY IF VIDEO EXISTS
  if (muteBtn && video) {
    muteBtn.addEventListener("click", () => {
      video.muted = !video.muted;
      muteBtn.innerText = video.muted ? "Unmute" : "Mute";
    });
  }

  // FULLSCREEN (simple toggle)
  if (fsBtn) {
    fsBtn.addEventListener("click", () => {
      hero.classList.toggle("mirellis-fullscreen");
    });
  }

});
</script>

{% schema %}
{
  "name": "Mirellis Hero — Arrival",
  "settings": [
    {
      "type": "text",
      "id": "video",
      "label": "MP4 Video URL"
    },
    {
      "type": "text",
      "id": "youtube",
      "label": "YouTube Link (full URL)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modern life lost its transitions."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "A slower environment designed for nervous-system coherence."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Enter Slowly"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Mirellis Hero — Arrival"
    }
  ]
}
{% endschema %} 