{% stylesheet %}

.science-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  background: #f4f0ea;
}

.science-hero__media {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.science-hero__media img,
.science-hero__media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.science-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    linear-gradient(
      to top,
      rgba(20, 18, 16, 0.72) 0%,
      rgba(20, 18, 16, 0.48) 35%,
      rgba(20, 18, 16, 0.18) 65%,
      rgba(20, 18, 16, 0.08) 100%
    );
}

.science-hero__content {
  position: relative;
  z-index: 3;
  width: 100%;
  padding: 0 72px 88px;
}

.science-hero__inner {
  max-width: 760px;
}

.science-hero__eyebrow {
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.72);
  margin-bottom: 22px;
  font-weight: 500;
}

.science-hero__title {
  font-family: var(--heading-font-family);
  font-size: clamp(48px, 7vw, 108px);
  line-height: 0.96;
  letter-spacing: -0.04em;
  color: #f8f4ef;
  margin: 0;
  max-width: 820px;
  font-weight: 400;
}

.science-hero__text {
  margin-top: 32px;
  max-width: 560px;
  font-size: 18px;
  line-height: 1.8;
  color: rgba(255,255,255,0.82);
  font-weight: 400;
}

.science-hero__ambient {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    radial-gradient(
      circle at top right,
      rgba(201, 161, 101, 0.14),
      transparent 30%
    );
  mix-blend-mode: screen;
}

@media screen and (max-width: 999px) {

  .science-hero {
    min-height: 88vh;
  }

  .science-hero__content {
    padding: 0 24px 64px;
  }

  .science-hero__title {
    font-size: 54px;
    line-height: 0.98;
  }

  .science-hero__text {
    font-size: 16px;
    line-height: 1.75;
    margin-top: 24px;
  }

  .science-hero__eyebrow {
    margin-bottom: 18px;
  }

}

{% endstylesheet %}

<section class="science-hero">

  <div class="science-hero__media">

    {% if section.settings.hero_video != blank %}
      {{
        section.settings.hero_video
        | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        playsinline: true
      }}
    {% elsif section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
        loading: 'eager',
        widths: '1200, 1600, 2000, 2400',
        class: 'science-hero__image'
      }}
    {% endif %}

  </div>

  <div class="science-hero__overlay"></div>

  <div class="science-hero__ambient"></div>

  <div class="science-hero__content">
    <div class="science-hero__inner">

      {% if section.settings.eyebrow != blank %}
        <div class="science-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.title != blank %}
        <h1 class="science-hero__title">
          {{ section.settings.title }}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="science-hero__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Science Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero Video"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ritual Science"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "The Science of Ritual"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "How light, sound, rhythm, scent, and repetition shape the nervous system."
    }
  ],
  "presets": [
    {
      "name": "Science Hero"
    }
  ]
}
{% endschema %}