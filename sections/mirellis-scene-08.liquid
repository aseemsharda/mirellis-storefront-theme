{% comment %}
=========================================================
MIRELLIS — SCENE 08 (REFINED FINAL)
QUIET CLOSURE / DISSOLUTION FIELD
=========================================================
{% endcomment %}

<section
  class="
    ml-scene
    ml-scene-continuous
    ml-scene-descent-soft
    ml-spatial-stillness
    ml-scene-text-flow
  "
>

  <!-- =====================================================
       ATMOSPHERIC FOUNDATION (DISSOLUTION FIELD)
       ===================================================== -->

  <div
    class="ml-depth-layer ml-depth-soft"
    style="
      background:
        radial-gradient(
          ellipse at top,
          rgba(246,241,232,0.55) 0%,
          rgba(246,241,232,0.20) 45%,
          rgba(246,241,232,0) 75%
        );
      filter: blur(6px);
      opacity: 0.95;
    "
  ></div>


  <!-- =====================================================
       CLOSURE IMAGE (RESIDUAL FIELD)
       ===================================================== -->

  {% if section.settings.scene_image != blank %}

    <div
      class="ml-depth-layer ml-depth-atmospheric ml-light-drift"
      style="opacity: 0.10; filter: saturate(0.85) contrast(0.95);"
    >

      {{
        section.settings.scene_image
        | image_url: width: 2200
        | image_tag:
          class: 'ml-atmospheric-image ml-soft-presence',
          loading: 'lazy',
          widths: '1200,1600,2200',
          alt: section.settings.scene_heading
      }}

    </div>

  {% endif %}


  <!-- =====================================================
       DISSOLUTION FIELD (TEXT FLOW)
       ===================================================== -->

  <div class="ml-container-reading">

    <div class="ml-balanced-field ml-rhythm-atmospheric ml-scene-text-flow">

      <div class="ml-visual-silence-lg"></div>


      <!-- HEADING -->

      {% if section.settings.scene_heading != blank %}
        <h2 class="ml-display-heading ml-headline-soft">
          {{ section.settings.scene_heading }}
        </h2>
      {% endif %}


      <!-- COPY -->

      {% if section.settings.scene_copy != blank %}
        <div class="ml-contemplative-copy ml-copy-soft">
          {{ section.settings.scene_copy }}
        </div>
      {% endif %}


      <div class="ml-cinematic-pause"></div>


      <!-- CTA (SOFT EXIT RITUAL, NOT BUTTON) -->

      {% if section.settings.scene_cta_label != blank %}
        <div class="ml-button-field">
          <a
            href="{{ section.settings.scene_cta_link }}"
            class="ml-ritual-cta ml-ritual-fade"
          >
            {{ section.settings.scene_cta_label }}
          </a>
        </div>
      {% endif %}


      <div class="ml-visual-silence-lg"></div>

    </div>

  </div>


  <!-- =====================================================
       ATMOSPHERIC EXIT FIELD
       ===================================================== -->

  <div
    class="ml-depth-layer ml-shadow-breathing ml-depth-atmospheric"
    style="
      background:
        radial-gradient(
          ellipse at center,
          rgba(255,255,255,0.06) 0%,
          rgba(255,255,255,0) 72%
        );
      opacity: 0.8;
    "
  ></div>

</section>


{% schema %}
{
  "name": "Scene 08",
  "tag": "section",
  "settings": [

    {
      "type": "image_picker",
      "id": "scene_image",
      "label": "Closure Image"
    },

    {
      "type": "textarea",
      "id": "scene_heading",
      "label": "Heading",
      "default": "Some environments stay with the body even after we leave them."
    },

    {
      "type": "textarea",
      "id": "scene_copy",
      "label": "Copy",
      "default": "Not every part of life needs to move at the speed surrounding it."
    },

    {
      "type": "text",
      "id": "scene_cta_label",
      "label": "CTA Label",
      "default": "Continue Slowly"
    },

    {
      "type": "url",
      "id": "scene_cta_link",
      "label": "CTA Link"
    }

  ],

  "presets": [
    {
      "name": "Scene 08"
    }
  ]
}
{% endschema %}