{% comment %}
MIRELLIS — FEATURED PRODUCTS (MINIMAL LUXURY GRID)
Only 2 products max, no clutter, no storytelling overload
{% endcomment %}

<section class="ml-featured-products">

  <div class="ml-featured-products__container">

    {% if section.settings.heading != blank %}
      <h2 class="ml-featured-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="ml-featured-grid">

      {% for product in section.settings.collection.products limit: 2 %}

        <div class="ml-product-card">

          <a href="{{ product.url }}">

            {% if product.featured_image %}
              <div class="ml-product-image">
                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag: class: 'ml-product-img'
                }}
              </div>
            {% endif %}

            <div class="ml-product-info">

              <h3 class="ml-product-title">
                {{ product.title }}
              </h3>

              {% if product.metafields.custom.short_note != blank %}
                <p class="ml-product-text">
                  {{ product.metafields.custom.short_note }}
                </p>
              {% endif %}

              <div class="ml-product-cta">
                View Ritual
              </div>

            </div>

          </a>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

<style>
/* ===============================
   MIRELLIS FEATURED PRODUCTS
   =============================== */

.ml-featured-products {
  padding: 90px 24px;
  background: #fcfaf7;
}

.ml-featured-products__container {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
}

.ml-featured-heading {
  font-size: 26px;
  font-weight: 300;
  margin-bottom: 50px;
  color: #1f1f1f;
}

.ml-featured-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
}

.ml-product-card {
  text-align: center;
}

.ml-product-img {
  width: 100%;
  height: 380px;
  object-fit: cover;
  filter: contrast(0.98) saturate(0.95);
}

.ml-product-title {
  font-size: 18px;
  font-weight: 300;
  margin-top: 18px;
}

.ml-product-text {
  font-size: 14px;
  opacity: 0.7;
  margin-top: 8px;
}

.ml-product-cta {
  margin-top: 14px;
  font-size: 13px;
  border: 1px solid rgba(0,0,0,0.15);
  display: inline-block;
  padding: 8px 14px;
}

.ml-product-cta:hover {
  border-color: rgba(0,0,0,0.35);
}

/* MOBILE */
@media (max-width: 768px) {
  .ml-featured-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .ml-product-img {
    height: 300px;
  }
}
</style>

{% schema %}
{
  "name": "Mirellis Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ritual Formulations"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product Collection"
    }
  ],
  "presets": [
    {
      "name": "Mirellis Featured Products"
    }
  ]
}
{% endschema %}