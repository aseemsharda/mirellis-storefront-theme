<section class="editorial-ritual-connection">

  <div class="page-width">

    <div class="editorial-ritual-connection__inner">

      {% if section.settings.label != blank %}

        <p class="editorial-ritual-connection__label">
          {{ section.settings.label }}
        </p>

      {% endif %}

      <div class="editorial-ritual-connection__content">

        <h2 class="editorial-ritual-connection__title">
          {{ section.settings.title }}
        </h2>

        <div class="editorial-ritual-connection__text">
          {{ section.settings.text }}
        </div>

        {% if section.settings.link_label != blank and section.settings.link != blank %}

          <a href="{{ section.settings.link }}" class="editorial-ritual-connection__link">
            {{ section.settings.link_label }}
          </a>

        {% endif %}

      </div>

    </div>

  </div>

</section>

<style>

.editorial-ritual-connection {
  padding: 120px 0;
  background: #fcfaf7;
}

.editorial-ritual-connection__inner {
  max-width: 760px;
  margin: 0 auto;
}

.editorial-ritual-connection__label {
  margin-bottom: 22px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: #8b8378;
}

.editorial-ritual-connection__title {
  margin: 0 0 28px;

  font-size: 40px;
  line-height: 1.3;
  font-weight: 300;

  color: #1f1f1f;
}

.editorial-ritual-connection__text {
  font-size: 20px;
  line-height: 1.9;
  font-weight: 300;

  color: #4f4a45;
}

.editorial-ritual-connection__text p {
  margin: 0 0 24px;
}

.editorial-ritual-connection__text p:last-child {
  margin-bottom: 0;
}

.editorial-ritual-connection__link {
  display: inline-block;
  margin-top: 36px;

  font-size: 14px;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-decoration: none;

  color: #1f1f1f;

  border-bottom: 1px solid #1f1f1f;
  padding-bottom: 4px;
}

@media screen and (max-width: 990px) {

  .editorial-ritual-connection {
    padding: 90px 0;
  }

  .editorial-ritual-connection__title {
    font-size: 34px;
  }

  .editorial-ritual-connection__text {
    font-size: 18px;
  }

}

@media screen and (max-width: 749px) {

  .editorial-ritual-connection {
    padding: 70px 0;
  }

  .editorial-ritual-connection__title {
    font-size: 28px;
    line-height: 1.35;
  }

  .editorial-ritual-connection__text {
    font-size: 17px;
    line-height: 1.9;
  }

}

</style>

{% schema %}
{
  "name": "Ritual Connection",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Ritual Connection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "Explore Ritual"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Ritual Connection"
    }
  ]
}
{% endschema %}