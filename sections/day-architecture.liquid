<section class="day-architecture">

  <div class="day-architecture-container">

    <div class="architecture-intro">

      <p class="architecture-eyebrow">
        The Mirellis Framework
      </p>

      <h2>
        The Architecture Of A Day
      </h2>

      <p>
        Human physiology rarely moves through a day as one continuous state.
        It moves through a sequence of transitions.
      </p>

      <p>
        Mirellis focuses on four recurring phases that shape attention,
        pacing, restoration and integration.
      </p>

    </div>

    <div class="architecture-grid">

      <div class="architecture-card">

        {% if section.settings.morning_image != blank %}
          <img
            src="{{ section.settings.morning_image | image_url: width: 1200 }}"
            alt="Morning Orientation"
            loading="lazy"
          >
        {% endif %}

        <div class="architecture-card-content">

          <span class="architecture-label">
            Morning
          </span>

          <h3>
            Orientation
          </h3>

          <p>
            The first signals that shape attention, pacing and direction.
          </p>

        </div>

      </div>

      <div class="architecture-card">

        {% if section.settings.day_image != blank %}
          <img
            src="{{ section.settings.day_image | image_url: width: 1200 }}"
            alt="Day Attention"
            loading="lazy"
          >
        {% endif %}

        <div class="architecture-card-content">

          <span class="architecture-label">
            Day
          </span>

          <h3>
            Attention
          </h3>

          <p>
            Energy directed toward activity, decisions and engagement.
          </p>

        </div>

      </div>

      <div class="architecture-card">

        {% if section.settings.evening_image != blank %}
          <img
            src="{{ section.settings.evening_image | image_url: width: 1200 }}"
            alt="Evening Restoration"
            loading="lazy"
          >
        {% endif %}

        <div class="architecture-card-content">

          <span class="architecture-label">
            Evening
          </span>

          <h3>
            Restoration
          </h3>

          <p>
            The transition out of activity and toward slowing.
          </p>

        </div>

      </div>

      <div class="architecture-card">

        {% if section.settings.night_image != blank %}
          <img
            src="{{ section.settings.night_image | image_url: width: 1200 }}"
            alt="Night Integration"
            loading="lazy"
          >
        {% endif %}

        <div class="architecture-card-content">

          <span class="architecture-label">
            Night
          </span>

          <h3>
            Integration
          </h3>

          <p>
            Experiences settle into memory, recovery and renewal.
          </p>

        </div>

      </div>

    </div>

  </div>

</section>

<style>

.day-architecture{
padding:140px 40px;
background:#f8f4ee;
}

.day-architecture-container{
max-width:1400px;
margin:0 auto;
}

.architecture-intro{
max-width:820px;
margin:0 auto 90px;
text-align:center;
}

.architecture-eyebrow{
font-size:13px;
letter-spacing:.16em;
text-transform:uppercase;
color:#8d867d;
margin-bottom:20px;
}

.architecture-intro h2{
font-size:clamp(44px,6vw,78px);
line-height:1.05;
font-weight:400;
margin-bottom:30px;
color:#1f1f1f;
}

.architecture-intro p{
font-size:20px;
line-height:1.9;
color:#5d5650;
margin-bottom:10px;
}

.architecture-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:30px;
}

.architecture-card{
background:white;
border-radius:22px;
overflow:hidden;
transition:.35s ease;
}

.architecture-card:hover{
transform:translateY(-6px);
}

.architecture-card img{
width:100%;
aspect-ratio:4/5;
object-fit:cover;
display:block;
}

.architecture-card-content{
padding:32px;
}

.architecture-label{
display:block;
font-size:12px;
letter-spacing:.14em;
text-transform:uppercase;
color:#8d867d;
margin-bottom:12px;
}

.architecture-card h3{
font-size:34px;
font-weight:400;
margin-bottom:16px;
color:#1f1f1f;
}

.architecture-card p{
font-size:16px;
line-height:1.8;
color:#5d5650;
}

@media(max-width:1100px){

.architecture-grid{
grid-template-columns:repeat(2,1fr);
}

}

@media(max-width:768px){

.day-architecture{
padding:90px 24px;
}

.architecture-grid{
grid-template-columns:1fr;
gap:24px;
}

.architecture-intro h2{
font-size:42px;
}

.architecture-intro p{
font-size:17px;
}

.architecture-card h3{
font-size:28px;
}

}

</style>

{% schema %}
{
  "name": "Day Architecture",
  "settings": [

    {
      "type": "image_picker",
      "id": "morning_image",
      "label": "Morning Image"
    },

    {
      "type": "image_picker",
      "id": "day_image",
      "label": "Day Image"
    },

    {
      "type": "image_picker",
      "id": "evening_image",
      "label": "Evening Image"
    },

    {
      "type": "image_picker",
      "id": "night_image",
      "label": "Night Image"
    }

  ],
  "presets": [
    {
      "name": "Day Architecture"
    }
  ]
}
{% endschema %}