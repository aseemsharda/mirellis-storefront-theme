<section class="community-sound">

  <div class="community-sound-inner">

    <!-- HEADER -->

    <div class="community-sound-header">

      <div class="community-section-label">
        SOUND & ATMOSPHERE
      </div>

      <h2 class="community-sound-heading">
        Sonic environments for slower rhythms,
        softer transitions, deeper restoration,
        and quieter nervous systems.
      </h2>

    </div>

    <!-- PLAYLIST LAYOUT -->

    <div class="community-playlist-layout">

      <!-- FEATURED PLAYLIST -->

      <a
        href="https://open.spotify.com/playlist/6VG02jtawiXTcOGi0nZzp6"
        target="_blank"
        class="featured-playlist-card"
      >

        <div class="featured-playlist-image"></div>

        <div class="featured-playlist-overlay">

          <div class="featured-playlist-meta">
            Evening Atmosphere
          </div>

          <h3 class="featured-playlist-title">
            Stillness
          </h3>

          <div class="featured-playlist-text">
            Slower ambient textures designed
            for decompression, softer evenings,
            and quieter transitions into restoration.
          </div>

          <div class="featured-playlist-link">
            Open on Spotify
          </div>

        </div>

      </a>

      <!-- SECONDARY PLAYLISTS -->

      <div class="secondary-playlists">

        <!-- Morning Clarity -->

        <a
          href="https://open.spotify.com/playlist/0kPGfp1m7uIAEkT8h6j66P"
          target="_blank"
          class="secondary-playlist-card"
        >

          <div class="secondary-playlist-gradient gradient-morning"></div>

          <div class="secondary-playlist-content">

            <div class="secondary-playlist-title">
              Morning Clarity
            </div>

            <div class="secondary-playlist-text">
              Gentle environmental pacing
              for softer cognitive beginnings.
            </div>

          </div>

        </a>

        <!-- Restoration -->

        <a
          href="https://open.spotify.com/playlist/53xH1HRTy7x9IEN7WPByDp"
          target="_blank"
          class="secondary-playlist-card"
        >

          <div class="secondary-playlist-gradient gradient-restoration"></div>

          <div class="secondary-playlist-content">

            <div class="secondary-playlist-title">
              Restoration
            </div>

            <div class="secondary-playlist-text">
              Quiet sonic environments
              for emotional decompression.
            </div>

          </div>

        </a>

        <!-- Flow -->

        <a
          href="https://open.spotify.com/playlist/10xydaUigLOhIwJa4FCAtT"
          target="_blank"
          class="secondary-playlist-card"
        >

          <div class="secondary-playlist-gradient gradient-flow"></div>

          <div class="secondary-playlist-content">

            <div class="secondary-playlist-title">
              Flow
            </div>

            <div class="secondary-playlist-text">
              Atmospheric focus environments
              for calmer concentration.
            </div>

          </div>

        </a>

      </div>

    </div>

  </div>

</section>

