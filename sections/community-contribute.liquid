<section class="community-contribute">

  <div class="community-contribute-inner">

    <!-- LEFT -->

    <div class="community-contribute-content">

      <div class="community-section-label">
        CONTRIBUTION LAYER
      </div>

      <h2 class="community-contribute-heading">
        Mirellis is slowly becoming
        a collaborative ecosystem around
        restoration, atmosphere,
        nervous-system awareness,
        and modern living.
      </h2>

      <div class="community-contribute-text">
        We are gradually building relationships with
        researchers, doctors, sound artists, writers,
        environmental thinkers, hospitality spaces,
        designers, ritual practitioners, and slower
        systems thinkers from around the world.
      </div>

      <div class="community-contribute-actions">

        <a href="#" class="community-contribute-button">
          Contribute to the Ecosystem
        </a>

        <a href="#" class="community-contribute-button secondary">
          Partnership & Distribution
        </a>

      </div>

    </div>

    <!-- RIGHT -->

    <div class="community-contribute-grid">

      <div class="contribute-mini-card">
        Sound Artists
      </div>

      <div class="contribute-mini-card">
        Sleep Researchers
      </div>

      <div class="contribute-mini-card">
        Ayurveda Practitioners
      </div>

      <div class="contribute-mini-card">
        Environmental Designers
      </div>

      <div class="contribute-mini-card">
        Writers & Thinkers
      </div>

      <div class="contribute-mini-card">
        Hospitality Spaces
      </div>

      <div class="contribute-mini-card">
        Architects
      </div>

      <div class="contribute-mini-card">
        Ritual Contributors
      </div>

    </div>

  </div>

</section>

