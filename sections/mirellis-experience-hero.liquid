{% schema %}
{
  "name": "Mirellis Experience Hero",
  "settings": [
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop Video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience Morning Clarity & Stillness"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "Modern life rarely transitions gently. Mirellis explores slower morning and evening rituals designed around nervous-system transitions."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Leave Your Details"
    }
  ],
  "presets": [
    {
      "name": "Mirellis Experience Hero"
    }
  ]
}
{% endschema %}

<section class="mirellis-experience-hero">

  <div class="mirellis-video-wrapper">

    {% if section.settings.desktop_video != blank %}
      {{
        section.settings.desktop_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'mirellis-video desktop-video'
      }}
    {% endif %}

    {% if section.settings.mobile_video != blank %}
      {{
        section.settings.mobile_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'mirellis-video mobile-video'
      }}
    {% endif %}

    <div class="mirellis-overlay"></div>

  </div>

  <div class="mirellis-content">
    <h1>{{ section.settings.heading }}</h1>

    <p>{{ section.settings.paragraph }}</p>

    <a href="#participation-form" class="mirellis-button">
      {{ section.settings.button_label }}
    </a>
  </div>

</section>

<style>

.mirellis-experience-hero {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f4efe7;
}

.mirellis-video-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.mirellis-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mobile-video {
  display: none;
}

.mirellis-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to bottom,
      rgba(20,20,20,0.18),
      rgba(20,20,20,0.45)
    );
}

.mirellis-content {
  position: relative;
  z-index: 2;
  max-width: 760px;
  margin: 0 auto;
  padding: 0 32px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.mirellis-content h1 {
  font-size: clamp(42px, 6vw, 78px);
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #f4efe7;
  margin-bottom: 28px;
  font-weight: 400;
}

.mirellis-content p {
  font-size: 18px;
  line-height: 1.9;
  color: rgba(244,239,231,0.88);
  max-width: 680px;
  margin-bottom: 42px;
  font-weight: 300;
}

.mirellis-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 34px;
  border: 1px solid rgba(244,239,231,0.4);
  color: #f4efe7;
  text-decoration: none;
  font-size: 15px;
  letter-spacing: 0.06em;
  transition: all 0.35s ease;
  backdrop-filter: blur(4px);
}

.mirellis-button:hover {
  background: rgba(244,239,231,0.12);
  border-color: rgba(244,239,231,0.7);
}

@media screen and (max-width: 768px) {

  .desktop-video {
    display: none;
  }

  .mobile-video {
    display: block;
  }

  .mirellis-content {
    padding: 0 24px;
  }

  .mirellis-content h1 {
    font-size: 42px;
    line-height: 1.12;
  }

  .mirellis-content p {
    font-size: 16px;
    line-height: 1.8;
  }

  .mirellis-button {
    padding: 14px 28px;
    font-size: 14px;
  }

}

</style>