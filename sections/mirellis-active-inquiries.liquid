<section class="mi-inquiries">

  <div class="container">

    <div class="mi-inquiries-header">

      {% if section.settings.eyebrow != blank %}
        <p class="mi-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="mi-inquiries-description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>

    <div class="mi-inquiries-grid">

      {% for block in section.blocks %}

        <article class="mi-inquiry-card">

          <h3>
            {{ block.settings.question }}
          </h3>

          {% if block.settings.description != blank %}
            <p>
              {{ block.settings.description }}
            </p>
          {% endif %}

        </article>

      {% endfor %}

    </div>

  </div>

</section>

<style>

.mi-inquiries{
  padding:
  {{ section.settings.top_spacing }}px
  0
  {{ section.settings.bottom_spacing }}px;
}

.mi-inquiries-header{
  max-width:900px;
  margin:0 auto 70px;
  text-align:center;
}

.mi-eyebrow{
  text-transform:uppercase;
  letter-spacing:.15em;
  opacity:.6;
  margin-bottom:12px;
}

.mi-inquiries-header h2{
  margin-bottom:24px;
}

.mi-inquiries-description{
  max-width:750px;
  margin:0 auto;
  opacity:.8;
}

.mi-inquiries-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:24px;
}

.mi-inquiry-card{
  border:1px solid rgba(0,0,0,.08);
  border-radius:24px;
  padding:32px;
  min-height:220px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.mi-inquiry-card h3{
  font-size:22px;
  line-height:1.4;
  margin-bottom:16px;
}

.mi-inquiry-card p{
  opacity:.7;
}

@media(max-width:990px){

  .mi-inquiries-grid{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:749px){

  .mi-inquiries-grid{
    grid-template-columns:1fr;
  }

}

</style>

{% schema %}
{
  "name": "Active Inquiries",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Current Inquiry"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions Currently Being Explored"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top Spacing",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Optional Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Active Inquiries",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Why do transitions feel increasingly difficult in modern environments?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can sensory rituals alter the quality of state transitions?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What signals help the nervous system recognize closure?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How does environmental design influence restoration?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Why do some routines become meaningful rituals while others disappear?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What role does repetition play in physiological regulation?"
          }
        }
      ]
    }
  ]
}
{% endschema %}