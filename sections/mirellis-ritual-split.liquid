{% comment %}
MIRELLIS — RITUAL SPLIT SECTION
Morning vs Evening Entry Architecture (Luxury Minimal System)
{% endcomment %}

<section class="ml-ritual-split">

  <div class="ml-ritual-split__grid">

    <!-- MORNING -->
    <div class="ml-ritual-card">

      {% if section.settings.morning_image != blank %}
        <div class="ml-ritual-card__image">
          {{
            section.settings.morning_image
            | image_url: width: 1600
            | image_tag: class: 'ml-ritual-img'
          }}
        </div>
      {% endif %}

      {% if section.settings.morning_title != blank %}
        <h2 class="ml-ritual-title">
          {{ section.settings.morning_title }}
        </h2>
      {% endif %}

      {% if section.settings.morning_text != blank %}
        <p class="ml-ritual-text">
          {{ section.settings.morning_text }}
        </p>
      {% endif %}

      {% if section.settings.morning_link != blank %}
        <a class="ml-ritual-btn" href="{{ section.settings.morning_link }}">
          {{ section.settings.morning_btn }}
        </a>
      {% endif %}

    </div>

    <!-- EVENING -->
    <div class="ml-ritual-card">

      {% if section.settings.evening_image != blank %}
        <div class="ml-ritual-card__image">
          {{
            section.settings.evening_image
            | image_url: width: 1600
            | image_tag: class: 'ml-ritual-img'
          }}
        </div>
      {% endif %}

      {% if section.settings.evening_title != blank %}
        <h2 class="ml-ritual-title">
          {{ section.settings.evening_title }}
        </h2>
      {% endif %}

      {% if section.settings.evening_text != blank %}
        <p class="ml-ritual-text">
          {{ section.settings.evening_text }}
        </p>
      {% endif %}

      {% if section.settings.evening_link != blank %}
        <a class="ml-ritual-btn" href="{{ section.settings.evening_link }}">
          {{ section.settings.evening_btn }}
        </a>
      {% endif %}

    </div>

  </div>

</section>

<style>
/* ===============================
   MIRELLIS RITUAL SPLIT
   =============================== */

.ml-ritual-split {
  padding: 80px 24px;
  background: #fcfaf7;
}

.ml-ritual-split__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  max-width: 1200px;
  margin: 0 auto;
}

.ml-ritual-card {
  text-align: center;
}

.ml-ritual-card__image {
  margin-bottom: 24px;
}

.ml-ritual-img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  filter: contrast(0.98) saturate(0.95);
}

.ml-ritual-title {
  font-size: 24px;
  font-weight: 300;
  margin-bottom: 12px;
  color: #1f1f1f;
}

.ml-ritual-text {
  font-size: 15px;
  font-weight: 300;
  color: rgba(31,31,31,0.7);
  margin-bottom: 20px;
  padding: 0 10px;
}

.ml-ritual-btn {
  display: inline-block;
  padding: 10px 18px;
  border: 1px solid rgba(0,0,0,0.15);
  text-decoration: none;
  color: #1f1f1f;
  font-weight: 300;
  transition: 0.3s ease;
}

.ml-ritual-btn:hover {
  border-color: rgba(0,0,0,0.4);
}

/* MOBILE */
@media (max-width: 768px) {
  .ml-ritual-split__grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .ml-ritual-img {
    height: 320px;
  }
}
</style>

{% schema %}
{
  "name": "Mirellis Ritual Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "morning_image",
      "label": "Morning Image"
    },
    {
      "type": "text",
      "id": "morning_title",
      "label": "Morning Title",
      "default": "Morning Clarity Ritual"
    },
    {
      "type": "textarea",
      "id": "morning_text",
      "label": "Morning Text",
      "default": "Focus, clarity, and grounded energy for the start of your day."
    },
    {
      "type": "text",
      "id": "morning_btn",
      "label": "Morning Button",
      "default": "Begin Morning Ritual"
    },
    {
      "type": "url",
      "id": "morning_link",
      "label": "Morning Link"
    },

    {
      "type": "image_picker",
      "id": "evening_image",
      "label": "Evening Image"
    },
    {
      "type": "text",
      "id": "evening_title",
      "label": "Evening Title",
      "default": "Evening Stillness Ritual"
    },
    {
      "type": "textarea",
      "id": "evening_text",
      "label": "Evening Text",
      "default": "Release tension and restore internal rhythm before rest."
    },
    {
      "type": "text",
      "id": "evening_btn",
      "label": "Evening Button",
      "default": "Begin Evening Ritual"
    },
    {
      "type": "url",
      "id": "evening_link",
      "label": "Evening Link"
    }
  ],
  "presets": [
    {
      "name": "Mirellis Ritual Split"
    }
  ]
}
{% endschema %}