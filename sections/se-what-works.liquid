<section style="background:{{ section.settings.bg_color }};color:#ece7dd;font-family:'Hanken Grotesk',system-ui,sans-serif">
  <div style="max-width:1240px;margin:0 auto;padding:clamp(64px,8vw,104px) clamp(20px,5vw,48px);display:flex;flex-wrap:{{ section.settings.image_position | replace: 'left','wrap' | replace: 'right','wrap-reverse' }};gap:clamp(36px,5vw,72px);align-items:center">

    <div data-reveal style="flex:1 1 340px;min-width:280px;border-radius:6px;overflow:hidden;aspect-ratio:5/4;background:#1b2230">
      {%- if section.settings.image != blank -%}
        {%- assign ww_img_src = section.settings.image | image_url: width: 1100 -%}
        <img src="{{ ww_img_src }}" width="1100" height="880" alt="{{ section.settings.eyebrow }}" loading="lazy" style="width:100%;height:100%;object-fit:cover"/>
      {%- endif -%}
    </div>

    <div data-reveal style="flex:1 1 380px;min-width:300px">
      {%- if section.settings.eyebrow != blank -%}
        <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#cf9266;margin-bottom:20px">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.6vw,42px);line-height:1.18;margin:0 0 24px;letter-spacing:-0.01em;color:#ece7dd">{{ section.settings.heading }}</h2>
      {%- if section.settings.body_1 != blank -%}
        <p style="font-size:15.5px;line-height:1.8;color:#bcb6ab;margin:0 0 18px">{{ section.settings.body_1 }}</p>
      {%- endif -%}
      {%- if section.settings.body_2 != blank -%}
        <p style="font-size:15.5px;line-height:1.8;color:#bcb6ab;margin:0">{{ section.settings.body_2 }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SE — What Makes It Work",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What makes it work" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Scent, touch, and breath — the senses most closely tied to rest." },
    { "type": "textarea", "id": "body_1", "label": "Paragraph 1", "default": "Stillness engages grounding botanical extracts and essential oils traditionally used to calm the mind and ease the body. Rather than forcing sleep, the ritual supports the nervous system's natural ability to transition into stillness." },
    { "type": "textarea", "id": "body_2", "label": "Paragraph 2", "default": "Consistency matters more than intensity. The ritual is designed to be repeated gently, every evening." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#12171f" }
  ],
  "presets": [{ "name": "SE — What Makes It Work" }]
}
{% endschema %}