{% stylesheet %}
[data-mc-reveal]{opacity:0;transform:translateY(18px);transition:opacity 0.85s cubic-bezier(.2,.7,.2,1),transform 0.85s cubic-bezier(.2,.7,.2,1)}
[data-mc-reveal].mc-on{opacity:1;transform:none}
.mc-whofor-card img{transition:transform .6s ease}
.mc-whofor-card:hover img{transform:scale(1.05)}
@media(max-width:768px){.mc-4col{grid-template-columns:repeat(2,1fr)!important}}
{% endstylesheet %}

<section style="background:{{ section.settings.bg_color }};color:#ece3d6">
  <div style="max-width:1180px;margin:0 auto;padding:104px 32px">
    <div style="max-width:50ch;margin-bottom:52px">
      <p data-mc-reveal style="margin:0 0 24px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:#bb8b4d">{{ section.settings.eyebrow }}</p>
      <h2 data-mc-reveal style="margin:0;font-weight:300;font-size:42px;line-height:1.14;letter-spacing:-0.01em">{{ section.settings.heading }}</h2>
    </div>

    {% if section.blocks.size > 0 %}
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px" class="mc-4col">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          {% assign card_num = forloop.index %}
          <figure data-mc-reveal class="mc-whofor-card" {{ block.shopify_attributes }} style="margin:0">
            <div style="border-radius:5px;overflow:hidden;background:#2c251d;aspect-ratio:4/5">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 1122 }}" alt="{{ block.settings.caption }}" width="1122" height="1403" style="width:100%;height:100%;object-fit:cover">
              {% elsif block.settings.fallback_url != blank %}
                <img src="{{ block.settings.fallback_url }}" alt="{{ block.settings.caption }}" width="1122" height="1403" style="width:100%;height:100%;object-fit:cover">
              {% endif %}
            </div>
            <figcaption style="display:flex;gap:11px;margin-top:18px">
              <span style="font-family:'Mulish',sans-serif;font-size:11px;color:#bb8b4d;letter-spacing:0.08em;line-height:1.5">{% if card_num < 10 %}0{{ card_num }}{% else %}{{ card_num }}{% endif %}</span>
              <span style="font-size:18px;line-height:1.4;color:#ece3d6">{{ block.settings.caption }}</span>
            </figcaption>
          </figure>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<script>
(function(){if(!window.mcBaseInit){window.mcBaseInit=true;document.addEventListener('DOMContentLoaded',function(){var io=null;if('IntersectionObserver' in window){io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('mc-on');io.unobserve(e.target);}});},{threshold:0.12});}document.querySelectorAll('[data-mc-reveal]').forEach(function(el){if(io){io.observe(el);}else{el.classList.add('mc-on');}});});}})();
</script>

{% schema %}
{
  "name": "MC — Who It's For",
  "settings": [
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#211d18"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who it's for"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Morning Clarity is for those who—"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Who-for card",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "fallback_url", "label": "Fallback image URL"},
        {"type": "text", "id": "caption", "label": "Caption"}
      ]
    }
  ],
  "presets": [{"name": "MC — Who It's For"}]
}
{% endschema %}