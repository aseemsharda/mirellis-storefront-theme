<div class="distribution-columns page-width">
  {% if section.settings.title != blank %}
    <h2 class="distribution-columns__title">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="distribution-columns__grid">
    {% for block in section.blocks %}
      <div class="distribution-columns__item">
        <h3>{{ block.settings.title }}</h3>

        {% if block.settings.text != blank %}
          <p>{{ block.settings.text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
.distribution-columns {
  padding: 80px 20px;
}

.distribution-columns__title {
  text-align: center;
  margin-bottom: 50px;
  font-size: 42px;
}

.distribution-columns__grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 30px;
}

.distribution-columns__item {
  background: #f8f5f1;
  padding: 30px;
  border-radius: 20px;
}

.distribution-columns__item h3 {
  margin-bottom: 15px;
}

@media screen and (max-width: 768px) {
  .distribution-columns__grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Distribution Columns",
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    }
  ],
  "presets": [
    {
      "name": "Distribution Columns"
    }
  ]
}
{% endschema %}