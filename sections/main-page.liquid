{{ 'observatory.css' | asset_url | stylesheet_tag }}

<style>
#shopify-section-{{ section.id }} {
  background: var(--ml-color-warm-paper, #f8f5f1);
}

/* ==================================================
   PAGE
================================================== */

.ml-research-page {
  padding-top: clamp(5rem, 10vw, 10rem);
  padding-bottom: clamp(6rem, 10vw, 10rem);
}

/* ==================================================
   HEADER
================================================== */

.ml-research-header {
  max-width: 820px;
  margin: 0 auto;
  padding: 0 24px;
}

.ml-research-kicker {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;

  margin-bottom: 2rem;

  font-size: 0.72rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;

  color: rgba(0,0,0,.45);
}

.ml-research-title {
  font-size: clamp(3.5rem, 7vw, 6rem);
  line-height: 0.98;
  font-weight: 300;
  letter-spacing: -0.045em;

  color: #1f1f1f;

  max-width: 14ch;
  margin: 0;
}

.ml-research-divider {
  width: 72px;
  height: 1px;

  background: rgba(0,0,0,.14);

  margin-top: 3rem;
}

.ml-publication-meta {
  margin-top: 1.5rem;

  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  color: rgba(0,0,0,.42);
}

/* ==================================================
   BODY
================================================== */

.ml-research-body {
  max-width: 640px;
  margin: 0 auto;
  padding: 5rem 24px 0;
}

.ml-research-body .prose {
  max-width: none;
}

/* ==================================================
   ABSTRACT
================================================== */

.ml-research-body .prose > p:first-of-type {
  font-size: clamp(1.3rem, 2vw, 1.5rem);
  line-height: 1.85;

  color: rgba(0,0,0,.9);

  max-width: 44ch;

  margin-bottom: 5rem;
}

/* ==================================================
   BODY COPY
================================================== */

.ml-research-body .prose p {
  font-size: 1.125rem;
  line-height: 2;

  color: rgba(0,0,0,.78);

  margin-bottom: 2rem;
}

/* ==================================================
   CHAPTER HEADINGS
================================================== */

.ml-research-body .prose h2 {
  margin-top: 7rem;
  margin-bottom: 2rem;

  padding-top: 2rem;

  border-top: 1px solid rgba(0,0,0,.08);

  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 600;

  color: rgba(0,0,0,.45);
}

.ml-research-body .prose h3 {
  margin-top: 4rem;
  margin-bottom: 1.5rem;

  font-size: 1.45rem;
  line-height: 1.4;
  font-weight: 400;

  color: #1f1f1f;
}

/* ==================================================
   LINKS
================================================== */

.ml-research-body .prose a {
  color: inherit;
  text-decoration: none;

  background-image: linear-gradient(
    rgba(0,0,0,.22),
    rgba(0,0,0,.22)
  );

  background-repeat: no-repeat;
  background-position: 0 100%;
  background-size: 100% 1px;

  transition: all .25s ease;
}

.ml-research-body .prose a:hover {
  background-size: 100% 2px;
}

/* ==================================================
   LISTS
================================================== */

.ml-research-body .prose ul,
.ml-research-body .prose ol {
  margin: 2.5rem 0;
  padding-left: 1.3rem;
}

.ml-research-body .prose li {
  margin-bottom: 1rem;
  line-height: 1.9;
}

/* ==================================================
   BLOCKQUOTES
================================================== */

.ml-research-body .prose blockquote {
  margin: 6rem 0;
  padding-left: 2rem;

  border-left: 2px solid rgba(0,0,0,.18);

  max-width: 28ch;

  font-size: clamp(1.5rem, 2vw, 2rem);
  line-height: 1.55;
  font-weight: 300;

  color: rgba(0,0,0,.88);
}

.ml-research-body .prose blockquote p {
  margin: 0;
}

/* ==================================================
   STRONG
================================================== */

.ml-research-body .prose strong,
.ml-research-body .prose b {
  color: #1f1f1f;
  font-weight: 600;
}

/* ==================================================
   HR
================================================== */

.ml-research-body .prose hr {
  border: none;

  width: 60px;
  height: 1px;

  background: rgba(0,0,0,.12);

  margin: 6rem auto;
}

/* ==================================================
   IMAGES
================================================== */

.ml-research-body .prose img {
  display: block;
  width: 100%;
  height: auto;

  margin: 4rem auto;

  border-radius: 10px;
}

/* ==================================================
   TABLES
================================================== */

.ml-research-body .prose table {
  width: 100%;
  border-collapse: collapse;

  margin: 4rem 0;
}

.ml-research-body .prose th,
.ml-research-body .prose td {
  padding: 1rem;
  border-bottom: 1px solid rgba(0,0,0,.08);
  text-align: left;
}

/* ==================================================
   FOOTER
================================================== */

.ml-research-footer {
  max-width: 820px;
  margin: 8rem auto 0;
  padding: 0 24px;
}

.ml-research-footer-divider {
  height: 1px;
  background: rgba(0,0,0,.08);

  margin-bottom: 3rem;
}

.ml-research-footer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 4rem;
}

.ml-research-footer-label {
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  color: rgba(0,0,0,.45);

  margin-bottom: 1.2rem;
}

.ml-research-footer-links a {
  display: block;

  margin-bottom: 1rem;

  color: rgba(0,0,0,.72);

  text-decoration: none;

  transition: opacity .2s ease;
}

.ml-research-footer-links a:hover {
  opacity: .65;
}

/* ==================================================
   MOBILE
================================================== */

@media screen and (max-width: 768px) {

  .ml-research-page {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .ml-research-kicker {
    gap: .75rem;
  }

  .ml-research-title {
    font-size: 2.6rem;
    max-width: 100%;
  }

  .ml-research-body {
    max-width: 100%;
    padding-top: 3rem;
  }

  .ml-research-body .prose > p:first-of-type {
    font-size: 1.2rem;
  }

  .ml-research-body .prose p {
    font-size: 1.125rem;
    line-height: 1.95;
  }

  .ml-research-body .prose h2 {
    margin-top: 5rem;
  }

  .ml-research-body .prose blockquote {
    max-width: 100%;
    margin: 4rem 0;
    font-size: 1.35rem;
  }

  .ml-research-footer-grid {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
}
</style>

<div class="ml-research-page">

  <header class="ml-research-header">

```
<div class="ml-research-kicker">
  <span>Mirellis Observatory</span>
  <span>Research Archive</span>
</div>

<h1 class="ml-research-title">
  {{ page.title }}
</h1>

<div class="ml-research-divider"></div>

<div class="ml-publication-meta">
  Foundational Document · Research Publication
</div>
```

  </header>

  <div class="ml-research-body">

```
{% if page.content != blank %}
  <div class="prose">
    {{ page.content }}
  </div>
{% endif %}
```

  </div>

  <footer class="ml-research-footer">

```
<div class="ml-research-footer-divider"></div>

<div class="ml-research-footer-grid">

  <div>
    <div class="ml-research-footer-label">
      Research Archive
    </div>

    <div class="ml-research-footer-links">
      <a href="/pages/the-observatory">The Observatory</a>
      <a href="/pages/findings">Findings</a>
      <a href="/pages/dossiers">Current Investigations</a>
    </div>
  </div>

  <div>
    <div class="ml-research-footer-label">
      Foundational Documents
    </div>

    <div class="ml-research-footer-links">
      <a href="/pages/founder-prior">How This Started</a>
      <a href="/pages/founder-thesis">Why Transitions Matter</a>
      <a href="/pages/the-method">Our Method</a>
    </div>
  </div>

</div>
```

  </footer>

</div>

