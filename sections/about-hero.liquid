<section class="about-hero">

  <div class="about-hero__image">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '800,1200,1600,2000,2400',
          class: 'about-hero__img'
      }}
    {% endif %}
  </div>

  <div class="about-hero__content">

    {% if section.settings.eyebrow != blank %}
      <p class="about-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="about-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="about-hero__body rte">
        {{ section.settings.body }}
      </div>
    {% endif %}

  </div>

</section>

<style>

.about-hero{
  background:#F8F4EE;
  width:100%;
}

.about-hero__image{
  height:72vh;
  min-height:650px;
  overflow:hidden;
}

.about-hero__img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.about-hero__content{
  max-width:900px;
  margin:0 auto;
  padding:120px 48px 90px;
}

.about-hero__eyebrow{
  font-size:12px;
  letter-spacing:.18em;
  text-transform:uppercase;
  opacity:.55;
  margin-bottom:18px;
  font-weight:500;
}

.about-hero__heading{
  font-size:clamp(48px,6vw,80px);
  line-height:1.04;
  letter-spacing:-0.04em;
  margin:0 0 36px;
  max-width:900px;
}

.about-hero__body{
  max-width:760px;
  font-size:19px;
  line-height:1.95;
  color:rgba(0,0,0,.78);
}

.about-hero__body p{
  margin-bottom:20px;
}

.about-hero__body strong{
  font-weight:600;
}

@media screen and (max-width:999px){

  .about-hero__image{
    height:52vh;
    min-height:420px;
  }

  .about-hero__content{
    padding:80px 24px 60px;
  }

  .about-hero__heading{
    font-size:42px;
    line-height:1.08;
  }

  .about-hero__body{
    font-size:17px;
    line-height:1.9;
  }

}

</style>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Copy"
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}