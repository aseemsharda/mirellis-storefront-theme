{% schema %}
{
  "name": "Mirellis Ritual Pairing",
  "settings": [
    {
      "type": "image_picker",
      "id": "morning_image",
      "label": "Morning Image"
    },
    {
      "type": "image_picker",
      "id": "stillness_image",
      "label": "Stillness Image"
    }
  ],
  "presets": [
    {
      "name": "Mirellis Ritual Pairing"
    }
  ]
}
{% endschema %}

<section class="mirellis-ritual-pairing">

  <div class="ritual-grid">

    <!-- MORNING CARD -->

    <div class="ritual-card">

      {% if section.settings.morning_image != blank %}

        {{
          section.settings.morning_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'ritual-image',
            alt: 'Morning Clarity'
        }}

      {% endif %}

      <div class="ritual-content">

        <span class="ritual-label">
          Morning Ritual
        </span>

        <h2>
          Morning Clarity
        </h2>

        <p>
          A slower oil-pulling ritual designed to support calmer, more intentional beginnings.
        </p>

      </div>

    </div>

    <!-- STILLNESS CARD -->

    <div class="ritual-card">

      {% if section.settings.stillness_image != blank %}

        {{
          section.settings.stillness_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'ritual-image',
            alt: 'Stillness'
        }}

      {% endif %}

      <div class="ritual-content">

        <span class="ritual-label">
          Evening Ritual
        </span>

        <h2>
          Stillness
        </h2>

        <p>
          An evening aromatic ritual designed around decompression, quietness, and slower endings.
        </p>

      </div>

    </div>

  </div>

</section>

<style>

.mirellis-ritual-pairing {
  background: #f4efe7;
  padding: 140px 60px;
}

.ritual-grid {
  max-width: 1380px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
}

.ritual-card {
  display: flex;
  flex-direction: column;
}

.ritual-image {
  width: 100%;
  height: 720px;
  object-fit: cover;
  display: block;
}

.ritual-content {
  padding-top: 32px;
}

.ritual-label {
  display: inline-block;
  font-size: 13px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(20,20,20,0.45);
  margin-bottom: 16px;
}

.ritual-content h2 {
  font-size: clamp(34px, 4vw, 56px);
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #1a1a1a;
  margin-bottom: 24px;
  font-weight: 400;
}

.ritual-content p {
  max-width: 520px;
  font-size: 18px;
  line-height: 1.9;
  color: rgba(20,20,20,0.72);
  font-weight: 300;
}

@media screen and (max-width: 900px) {

  .mirellis-ritual-pairing {
    padding: 90px 24px;
  }

  .ritual-grid {
    grid-template-columns: 1fr;
    gap: 72px;
  }

  .ritual-image {
    height: 520px;
  }

  .ritual-content h2 {
    font-size: 38px;
  }

  .ritual-content p {
    font-size: 16px;
    line-height: 1.8;
  }

}

</style>