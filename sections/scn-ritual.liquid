{% comment %}
SCN 06 — RITUAL PARTICIPATION (FIXED)
Block-based Carousel System (Shopify Valid)
{% endcomment %}

<section class="ml-ritual">

  <div class="ml-ritual-bg"></div>

  <div class="ml-container">

    <!-- INTRO -->
    <div class="ml-ritual-intro">

      {% if section.settings.heading != blank %}
        <h2 class="ml-ritual-title">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="ml-ritual-subtext">
          {{ section.settings.subtext }}
        </p>
      {% endif %}

    </div>

    <!-- =========================
         MORNING RITUAL CAROUSEL
    ========================== -->

    <div class="ml-ritual-card">

      <div class="ml-carousel">

        {% for block in section.blocks %}
          {% if block.type == 'morning' and block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag: class: 'ml-slide'
            }}
          {% endif %}
        {% endfor %}

      </div>

      <div class="ml-ritual-content">

        <div class="ml-label">Morning Architecture</div>

        <h3>Morning Clarity</h3>

        <p>
          A sensory orientation system designed for early-day cognitive alignment.
        </p>

        {% if section.settings.morning_link != blank %}
          <a href="{{ section.settings.morning_link }}" class="ml-cta">
            Explore Morning Ritual
          </a>
        {% endif %}

      </div>

    </div>

    <!-- =========================
         EVENING RITUAL CAROUSEL
    ========================== -->

    <div class="ml-ritual-card">

      <div class="ml-carousel">

        {% for block in section.blocks %}
          {% if block.type == 'evening' and block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag: class: 'ml-slide'
            }}
          {% endif %}
        {% endfor %}

      </div>

      <div class="ml-ritual-content">

        <div class="ml-label">Evening Architecture</div>

        <h3>Stillness Elixir</h3>

        <p>
          An environmental descent system designed for evening transition states.
        </p>

        {% if section.settings.evening_link != blank %}
          <a href="{{ section.settings.evening_link }}" class="ml-cta">
            Enter Evening Ritual
          </a>
        {% endif %}

      </div>

    </div>

    <div class="ml-footnote">
      {{ section.settings.note }}
    </div>

  </div>

</section>

<style>

/* =========================
   SCN 06 — RITUAL
========================= */

.ml-ritual {
  position: relative;
  padding: 120px 24px;
  background: #f6f1ea;
}

.ml-ritual-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 20%, rgba(255,255,255,0.6), rgba(246,241,232,0.95));
}

.ml-container {
  position: relative;
  z-index: 2;
  max-width: 1100px;
  margin: 0 auto;
}

/* INTRO */
.ml-ritual-intro {
  text-align: center;
  margin-bottom: 70px;
}

.ml-ritual-title {
  font-size: clamp(28px, 3vw, 48px);
  font-weight: 400;
}

.ml-ritual-subtext {
  font-size: 16px;
  max-width: 700px;
  margin: 12px auto 0;
  color: rgba(28,28,28,0.7);
}

/* CARD */
.ml-ritual-card {
  margin-bottom: 60px;
}

/* CAROUSEL (basic safe version) */
.ml-carousel {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  gap: 0;
  height: 360px;
  background: #eae6df;
}

/* SLIDE */
.ml-slide {
  min-width: 100%;
  height: 360px;
  object-fit: cover;
  scroll-snap-align: center;
}

/* CONTENT */
.ml-ritual-content {
  padding-top: 20px;
}

.ml-label {
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.6;
}

.ml-ritual-content h3 {
  font-size: 22px;
  font-weight: 400;
  margin: 10px 0;
}

.ml-ritual-content p {
  font-size: 15px;
  line-height: 1.7;
  opacity: 0.75;
}

/* CTA */
.ml-cta {
  display: inline-block;
  margin-top: 14px;
  border-bottom: 1px solid rgba(0,0,0,0.2);
  text-decoration: none;
  color: #1c1c1c;
}

/* FOOTNOTE */
.ml-footnote {
  text-align: center;
  margin-top: 60px;
  font-size: 14px;
  opacity: 0.65;
}

/* MOBILE */
@media (max-width: 768px) {
  .ml-slide {
    height: 240px;
  }

  .ml-carousel {
    height: 240px;
  }
}

</style>

{% schema %}
{
  "name": "SCN 06 RITUAL",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rituals are environmental instruments, not products."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Products exist as sensory transitions between internal states."
    },
    {
      "type": "url",
      "id": "morning_link",
      "label": "Morning Link"
    },
    {
      "type": "url",
      "id": "evening_link",
      "label": "Evening Link"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Footnote",
      "default": "These systems are not consumed — they are entered repeatedly until they become internal rhythm."
    }
  ],

  "blocks": [
    {
      "type": "morning",
      "name": "Morning Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Morning Image"
        }
      ]
    },
    {
      "type": "evening",
      "name": "Evening Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Evening Image"
        }
      ]
    }
  ],

  "max_blocks": 20,

  "presets": [
    {
      "name": "SCN 06 RITUAL"
    }
  ]
}
{% endschema %}