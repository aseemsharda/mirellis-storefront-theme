{% comment %}
Observatory Research Section
Navigation to full research archive
{% endcomment %}

<section class="observatory-research">
  <div class="observatory-research__container">
    
    <div class="observatory-research__header">
      <h2 class="observatory-research__title">Browse All Research</h2>
      <p class="observatory-research__description">
        Search and explore our complete research archive.
      </p>
    </div>

    <div class="observatory-research__cta-group">
      <a href="/blogs/journal" class="observatory-research__cta">
        <span class="observatory-research__cta-label">View Research Archive</span>
        <span class="observatory-research__cta-description">Published guides, articles and findings organized by transition</span>
      </a>
    </div>

  </div>
</section>

<style>
  .observatory-research {
    padding: 4rem 2rem;
    background: #fff;
  }

  .observatory-research__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .observatory-research__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .observatory-research__title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 400;
    color: #1a1a18;
    margin-bottom: 0.5rem;
  }

  .observatory-research__description {
    font-size: 1rem;
    color: #666;
  }

  .observatory-research__cta-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .observatory-research__cta {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: #faf7f2;
    border: 1px solid rgba(26, 26, 24, 0.08);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .observatory-research__cta:hover {
    background: #f5f2ed;
    border-color: rgba(26, 26, 24, 0.15);
  }

  .observatory-research__cta-label {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a18;
    margin-bottom: 0.5rem;
  }

  .observatory-research__cta-description {
    font-size: 0.95rem;
    color: #666;
  }

  @media (max-width: 768px) {
    .observatory-research {
      padding: 3rem 1.5rem;
    }

    .observatory-research__title {
      font-size: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Observatory Research",
  "settings": []
}
{% endschema %}
