<section class="community-ritual-library">

  <div class="community-ritual-inner">

    <!-- HEADER -->

    <div class="community-ritual-header">

      <div class="community-section-label">
        RITUAL LIBRARY
      </div>

      <h2 class="community-ritual-heading">
        Rhythms, environments, and repeated
        signals people return to for slower,
        more coherent living.
      </h2>

    </div>

    <!-- RITUAL GRID -->

    <div class="community-ritual-grid">

      <!-- CARD 1 -->

      <div class="ritual-card">

        <div class="ritual-image ritual-image-1"></div>

        <div class="ritual-content">

          <div class="ritual-title">
            Slow Sunday Reset
          </div>

          <div class="ritual-text">
            Warm daylight. Instrumental piano.
            No notifications for the first hour.
          </div>

          <div class="ritual-meta">
            35 minutes · Morning Clarity
          </div>

        </div>

      </div>

      <!-- CARD 2 -->

      <div class="ritual-card">

        <div class="ritual-image ritual-image-2"></div>

        <div class="ritual-content">

          <div class="ritual-title">
            Evening Descent
          </div>

          <div class="ritual-text">
            Warm light. Tea before screens.
            Slower pacing before sleep.
          </div>

          <div class="ritual-meta">
            20 minutes · Evening Stillness
          </div>

        </div>

      </div>

      <!-- CARD 3 -->

      <div class="ritual-card">

        <div class="ritual-image ritual-image-3"></div>

        <div class="ritual-content">

          <div class="ritual-title">
            Reading Ritual
          </div>

          <div class="ritual-text">
            Soft lamp light. Linen textures.
            Tea beside books.
          </div>

          <div class="ritual-meta">
            45 minutes · Atmospheric Reading
          </div>

        </div>

      </div>

      <!-- CARD 4 -->

      <div class="ritual-card">

        <div class="ritual-image ritual-image-4"></div>

        <div class="ritual-content">

          <div class="ritual-title">
            Quiet Work Flow
          </div>

          <div class="ritual-text">
            Ambient sound. Fewer tabs.
            Long concentration without interruption.
          </div>

          <div class="ritual-meta">
            90 minutes · Quiet Work
          </div>

        </div>

      </div>

    </div>

  </div>

</section>

