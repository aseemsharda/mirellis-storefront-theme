{% stylesheet %}

.science-notes {
  padding: 180px 60px;
  background: #f6f2ec;
}

.science-notes__intro {
  max-width: 860px;
  margin: 0 auto 110px;
  text-align: center;
}

.science-notes__eyebrow {
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(30,26,22,0.46);
  margin-bottom: 24px;
  font-weight: 500;
}

.science-notes__heading {
  font-family: var(--heading-font-family);
  font-size: clamp(48px, 6vw, 88px);
  line-height: 0.98;
  letter-spacing: -0.04em;
  color: #1d1a17;
  margin: 0;
  font-weight: 400;
}

.science-notes__text {
  margin: 34px auto 0;
  max-width: 700px;
  font-size: 18px;
  line-height: 1.9;
  color: rgba(29,26,23,0.76);
}

.science-notes__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 34px;
  max-width: 1480px;
  margin: 0 auto;
}

.science-notes__card {
  padding: 48px;
  background: rgba(255,255,255,0.52);
  border: 1px solid rgba(30,26,22,0.06);
  backdrop-filter: blur(6px);
}

.science-notes__label {
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(30,26,22,0.42);
  margin-bottom: 22px;
  font-weight: 500;
}

.science-notes__title {
  font-family: var(--heading-font-family);
  font-size: 34px;
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #1d1a17;
  margin: 0;
  font-weight: 400;
}

.science-notes__body {
  margin-top: 24px;
  font-size: 17px;
  line-height: 1.9;
  color: rgba(29,26,23,0.74);
}

.science-notes__body p {
  margin: 0 0 20px;
}

.science-notes__body p:last-child {
  margin-bottom: 0;
}

@media screen and (max-width: 999px) {

  .science-notes {
    padding: 90px 24px;
  }

  .science-notes__intro {
    margin-bottom: 56px;
  }

  .science-notes__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .science-notes__card {
    padding: 34px 28px;
  }

  .science-notes__heading {
    font-size: 52px;
  }

  .science-notes__text,
  .science-notes__body {
    font-size: 16px;
    line-height: 1.82;
  }

  .science-notes__title {
    font-size: 30px;
  }

}

{% endstylesheet %}

<section class="science-notes">

  <div class="science-notes__intro">

    <div class="science-notes__eyebrow">
      {{ section.settings.eyebrow }}
    </div>

    <h2 class="science-notes__heading">
      {{ section.settings.heading }}
    </h2>

    <div class="science-notes__text">
      {{ section.settings.text }}
    </div>

  </div>

  <div class="science-notes__grid">

    {% for block in section.blocks %}

      <div class="science-notes__card">

        <div class="science-notes__label">
          {{ block.settings.label }}
        </div>

        <h3 class="science-notes__title">
          {{ block.settings.title }}
        </h3>

        <div class="science-notes__body">
          {{ block.settings.text }}
        </div>

      </div>

    {% endfor %}

  </div>

</section>

{% schema %}
{
  "name": "Science Notes",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Research Notes"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Quiet Scientific Context"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro Text",
      "default": "<p>Modern neuroscience, circadian biology, environmental psychology, and sensory research increasingly support the idea that atmosphere influences physiology.</p>"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Research Note",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Circadian Rhythm"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Light Influences Melatonin Timing"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Even relatively modest artificial light exposure at night may delay melatonin release and influence circadian timing.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science Notes",
      "blocks": [
        {
          "type": "note"
        },
        {
          "type": "note"
        },
        {
          "type": "note"
        },
        {
          "type": "note"
        }
      ]
    }
  ]
}
{% endschema %}