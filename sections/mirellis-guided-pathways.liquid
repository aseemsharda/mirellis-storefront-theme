{% stylesheet %}
.mirellis-guided {
  position: relative;
  padding: 8rem 2rem;
  background:
    linear-gradient(
      180deg,
      #100f0d 0%,
      #0d0c0b 100%
    );
  overflow: hidden;
}

.mirellis-guided__inner {
  max-width: 1180px;
  margin: 0 auto;
}

.mirellis-guided__label {
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.42);
  margin-bottom: 1.2rem;
}

.mirellis-guided__heading {
  font-family: var(--font-heading-family);
  font-size: clamp(2rem, 4vw, 4rem);
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #f4efe8;
  margin: 0 0 4rem;
  font-weight: 500;
  max-width: 720px;
}

.mirellis-guided__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.4rem;
}

.mirellis-guided__card {
  position: relative;
  padding: 2rem;
  border-radius: 30px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  text-decoration: none;
  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    background 0.35s ease;
}

.mirellis-guided__card:hover {
  transform: translateY(-3px);
  border-color: rgba(255,255,255,0.14);
  background: rgba(255,255,255,0.045);
}

.mirellis-guided__title {
  font-size: 1.25rem;
  line-height: 1.35;
  color: #f5f1ea;
  margin-bottom: 1rem;
  font-weight: 500;
}

.mirellis-guided__text {
  font-size: 0.98rem;
  line-height: 1.8;
  color: rgba(255,255,255,0.64);
  margin-bottom: 2rem;
}

.mirellis-guided__arrow {
  font-size: 1rem;
  color: rgba(196,112,72,0.82);
}

@media screen and (max-width: 989px) {
  .mirellis-guided__grid {
    grid-template-columns: 1fr;
  }
}

@media screen and (max-width: 749px) {
  .mirellis-guided {
    padding: 5rem 1.4rem;
  }

  .mirellis-guided__heading {
    font-size: clamp(1.9rem, 9vw, 3rem);
    line-height: 1.12;
    margin-bottom: 3rem;
  }

  .mirellis-guided__card {
    padding: 1.6rem;
    border-radius: 24px;
  }

  .mirellis-guided__title {
    font-size: 1.1rem;
  }

  .mirellis-guided__text {
    font-size: 0.95rem;
    line-height: 1.75;
  }
}
{% endstylesheet %}

<section class="mirellis-guided">

  <div class="mirellis-guided__inner">

    <div class="mirellis-guided__label">
      {{ section.settings.label }}
    </div>

    <h2 class="mirellis-guided__heading">
      {{ section.settings.heading }}
    </h2>

    <div class="mirellis-guided__grid">

      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link }}"
          class="mirellis-guided__card"
        >

          <div class="mirellis-guided__title">
            {{ block.settings.title }}
          </div>

          <div class="mirellis-guided__text">
            {{ block.settings.text }}
          </div>

          <div class="mirellis-guided__arrow">
            Explore →
          </div>

        </a>
      {% endfor %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Guided Pathways",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "CONTINUE EXPLORING"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Related pathways and deeper explorations."
    }
  ],
  "blocks": [
    {
      "type": "pathway",
      "name": "Pathway Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Why Evenings No Longer Feel Restful"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Modern evenings increasingly remove the slower transitions that once helped the nervous system descend."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guided Pathways",
      "blocks": [
        {
          "type": "pathway"
        },
        {
          "type": "pathway"
        },
        {
          "type": "pathway"
        }
      ]
    }
  ]
}
{% endschema %}