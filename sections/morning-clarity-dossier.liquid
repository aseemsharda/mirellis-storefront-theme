    { title: 'Ritual repetition & behavioral association', body: 'Repeated sensory rituals gradually become associated with familiarity, predictability, and environmental orientation through behavioral repetition and nervous-system association.', source: 'Behavioral psychology & habit research', href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC3505409/' },
    { title: 'Morning light & circadian rhythm', body: 'The nervous system responds strongly to the first environmental signals of the morning. Light exposure and early sensory cues may influence alertness, circadian timing, and the transition into wakefulness.', source: 'Harvard Medical School / circadian research', href: 'https://www.health.harvard.edu/staying-healthy/blue-light-has-a-dark-side' },
    { title: 'Breath & nervous system rhythm', body: 'Breathing patterns influence autonomic nervous-system activity and may affect physiological pacing during transitions between rest, alertness, and cognitive activation.', source: 'NIH / breath physiology', href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC6137615/' }
  ];

  function buildAcc(id, items) {
    var container = document.getElementById(id);
    if (!container) return;
    var openIdx = null;
    items.forEach(function(item, i) {
      var num = String(i+1).padStart(2,'0');
      var wrap = document.createElement('div');
      wrap.style.borderBottom = '1px solid #ddd3c6';
      var btn = document.createElement('button');
      btn.style.cssText = "width:100%;display:flex;align-items:center;gap:20px;padding:24px 4px;background:none;border:none;cursor:pointer;text-align:left";
      var nEl = document.createElement('span');
      nEl.style.cssText = "font-family:'Mulish',sans-serif;font-size:12px;color:#bb7a33;letter-spacing:0.08em;flex:none";
      nEl.textContent = num;
      var tEl = document.createElement('span');
      tEl.style.cssText = "flex:1;font-family:'Newsreader',serif;font-size:21px;color:#1f1c17;line-height:1.3";
      tEl.textContent = item.title;
      var ico = document.createElement('span');
      ico.style.cssText = "flex:none;width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-family:'Mulish',sans-serif;font-size:22px;font-weight:300;color:#8a7f70;transition:transform .3s";
      ico.textContent = '+';
      btn.appendChild(nEl); btn.appendChild(tEl); btn.appendChild(ico);
      var panel = document.createElement('div');
      panel.style.cssText = 'max-height:0;overflow:hidden;transition:max-height .4s ease,opacity .4s ease;opacity:0';
      var inner = document.createElement('div');
      inner.style.cssText = 'padding:0 4px 28px 48px';
      var body = document.createElement('p');
      body.style.cssText = "margin:0;font-family:'Newsreader',serif;font-size:17px;line-height:1.66;color:#48433a;max-width:62ch";
      body.textContent = item.body;
      var link = document.createElement('a');
      link.href = item.href; link.target = '_blank'; link.rel = 'noopener';
      link.style.cssText = "display:inline-flex;align-items:center;gap:8px;margin-top:16px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#bb7a33;text-decoration:none";
      link.textContent = item.source + ' →';
      inner.appendChild(body); inner.appendChild(link);
      panel.appendChild(inner);
      wrap.appendChild(btn); wrap.appendChild(panel);
      container.appendChild(wrap);
      btn.addEventListener('click', function() {
        var isOpen = openIdx === i;
        if (openIdx !== null) {
          var prev = container.children[openIdx];
          prev.querySelector('div').style.maxHeight = '0';
          prev.querySelector('div').style.opacity = '0';
          prev.querySelector('span:last-child').style.transform = 'none';
        }
        if (!isOpen) {
          openIdx = i;
          panel.style.maxHeight = '420px';
          panel.style.opacity = '1';
          ico.style.transform = 'rotate(45deg)';
        } else {
          openIdx = null;
        }
      });
    });
  }

  buildAcc('mc-acc-a', ingItems);
  buildAcc('mc-acc-b', noteItems);

  var revEls = document.querySelectorAll('[data-mc-reveal]');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('mc-on'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    revEls.forEach(function(el) { io.observe(el); });
  } else {
    revEls.forEach(function(el) { el.classList.add('mc-on'); });
  }
})();
</script>

