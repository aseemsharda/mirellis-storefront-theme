{% if section.settings.show_section %}
<section class="wwa-foundations">
  <div class="wwa-inner">
    {% if section.settings.eyebrow != blank %}
    <p class="wwa-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
    <h2 class="wwa-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="wwa-pillars">
      {% for block in section.blocks %}
      <div class="wwa-pillar">
        <h3 class="wwa-pillar-title">{{ block.settings.title }}</h3>
        <p class="wwa-pillar-body">{{ block.settings.body }}</p>
      </div>
      {% endfor %}
    </div>

    {% if section.settings.closing != blank %}
    <p class="wwa-closing">{{ section.settings.closing }}</p>
    {% endif %}
  </div>
</section>
{% endif %}

<style>
.wwa-foundations {
  background: #faf7f2;
  padding: 6rem 2rem;
}
.wwa-inner {
  max-width: 720px;
  margin: 0 auto;
}
.wwa-eyebrow {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(26,26,24,0.45);
  margin: 0 0 1.5rem 0;
}
.wwa-heading {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 400;
  color: #1a1a18;
  margin: 0 0 3rem 0;
  line-height: 1.2;
}
.wwa-pillars {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}
.wwa-pillar {
  padding: 0;
}
.wwa-pillar-title {
  font-size: 1.1rem;
  font-weight: 500;
  color: #1a1a18;
  margin: 0 0 1rem 0;
  line-height: 1.3;
}
.wwa-pillar-body {
  font-size: 0.95rem;
  line-height: 1.8;
  color: rgba(26,26,24,0.7);
  margin: 0;
}
.wwa-closing {
  font-size: 0.95rem;
  line-height: 1.85;
  color: rgba(26,26,24,0.65);
  text-align: center;
  margin: 3rem 0 0 0;
  padding-top: 2rem;
  border-top: 1px solid rgba(26,26,24,0.1);
}
@media (max-width: 640px) {
  .wwa-foundations {
    padding: 4rem 1.5rem;
  }
  .wwa-pillars {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "WWA Foundations",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FOUNDATIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ancient wisdom. Modern science. Environmental design."
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Closing Line",
      "default": "No single tradition is sufficient. The Mirellis method draws from all three."
    },
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ancient Wisdom"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Ayurveda and traditional ritual systems have studied human state transitions for thousands of years — daily rhythms, sensory inputs, and the relationship between environment and physiological state. This is the foundation."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What We Are - Foundations",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Ancient Wisdom",
            "body": "Ayurveda and traditional ritual systems have studied human state transitions for thousands of years — daily rhythms, sensory inputs, and the relationship between environment and physiological state. This is the foundation."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Modern Science",
            "body": "Circadian biology, neuroscience, sensory psychology, and habit formation research explain the mechanisms. Why repetition creates conditioning. Why the nervous system responds to scent, sound, and touch before the mind can evaluate them."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Environmental Design",
            "body": "The spaces and sounds around us regulate attention, mood, and recovery — often without awareness. Designing the environment is designing the transition."
          }
        }
      ]
    }
  ]
}
{% endschema %}
