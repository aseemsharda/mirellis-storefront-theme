{% stylesheet %}
[data-mc-reveal]{opacity:0;transform:translateY(18px);transition:opacity 0.85s cubic-bezier(.2,.7,.2,1),transform 0.85s cubic-bezier(.2,.7,.2,1)}
[data-mc-reveal].mc-on{opacity:1;transform:none}
@media(max-width:768px){.mc-3step{grid-template-columns:1fr!important}}
{% endstylesheet %}

<section style="background:{{ section.settings.bg_color }}">
  <div style="max-width:1180px;margin:0 auto;padding:104px 32px">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;border-bottom:1px solid #ddd3c6;padding-bottom:34px">
      <div>
        <p data-mc-reveal style="margin:0 0 22px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:#bb7a33">{{ section.settings.eyebrow }}</p>
        <h2 data-mc-reveal style="margin:0;font-weight:400;font-size:42px;line-height:1.12;letter-spacing:-0.015em;color:#1f1c17">{{ section.settings.heading }}</h2>
      </div>
      <p data-mc-reveal style="margin:0;font-family:'Mulish',sans-serif;font-size:14px;line-height:1.6;color:#6c6358;max-width:30ch;text-align:right">{{ section.settings.heading_note }}</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0" class="mc-3step">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          {% assign step_num = forloop.index %}
          <div data-mc-reveal {{ block.shopify_attributes }} style="padding:48px 34px 8px;{% unless forloop.last %}border-right:1px solid #ddd3c6;{% endunless %}display:flex;flex-direction:column;min-height:260px">
            <span style="font-family:'Mulish',sans-serif;font-size:12px;letter-spacing:0.1em;color:#bb7a33">{{ block.settings.step_label }}</span>
            <div style="font-family:'Newsreader',serif;font-weight:300;font-size:68px;line-height:1;color:#e3d8c8;margin:14px 0 24px">{% if step_num < 10 %}0{{ step_num }}{% else %}{{ step_num }}{% endif %}</div>
            <h3 style="margin:0 0 12px;font-weight:500;font-size:23px;color:#1f1c17">{{ block.settings.title }}</h3>
            <p style="margin:0;font-size:17px;line-height:1.58;color:#5b5346">{{ block.settings.body }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function(){if(!window.mcBaseInit){window.mcBaseInit=true;document.addEventListener('DOMContentLoaded',function(){var io=null;if('IntersectionObserver' in window){io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('mc-on');io.unobserve(e.target);}});},{threshold:0.12});}document.querySelectorAll('[data-mc-reveal]').forEach(function(el){if(io){io.observe(el);}else{el.classList.add('mc-on');}});});}})();
</script>

{% schema %}
{
  "name": "MC — Ritual Steps",
  "settings": [
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#f1ebe1"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The practice"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "The oil pulling ritual"},
    {"type": "text", "id": "heading_note", "label": "Heading note", "default": "5–10 minutes. Performed daily upon waking."}
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {"type": "text", "id": "step_label", "label": "Step label", "default": "Step 1"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "body", "label": "Body"}
      ]
    }
  ],
  "presets": [{"name": "MC — Ritual Steps"}]
}
{% endschema %}