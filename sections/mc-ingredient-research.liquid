{% stylesheet %}
[data-mc-reveal]{opacity:0;transform:translateY(18px);transition:opacity 0.85s cubic-bezier(.2,.7,.2,1),transform 0.85s cubic-bezier(.2,.7,.2,1)}
[data-mc-reveal].mc-on{opacity:1;transform:none}
.mc-acc-btn{width:100%;display:flex;align-items:center;gap:20px;padding:24px 4px;background:none;border:none;cursor:pointer;text-align:left}
.mc-acc-panel{max-height:0;overflow:hidden;transition:max-height .4s ease,opacity .4s ease;opacity:0}
{% endstylesheet %}

<section style="background:{{ section.settings.bg_color }}">
  <div style="max-width:980px;margin:0 auto;padding:96px 32px">
    <div style="max-width:60ch;margin-bottom:48px">
      <p data-mc-reveal style="margin:0 0 22px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:#bb7a33">{{ section.settings.eyebrow }}</p>
      <h2 data-mc-reveal style="margin:0;font-weight:400;font-size:36px;line-height:1.2;letter-spacing:-0.01em;color:#1f1c17">{{ section.settings.heading }}</h2>
      <p data-mc-reveal style="margin:22px 0 0;font-size:17px;line-height:1.62;color:#5b5346">{{ section.settings.intro }}</p>
    </div>

    <div data-mc-reveal id="mc-acc-{{ section.id }}" style="border-top:1px solid #ddd3c6">
      {% for block in section.blocks %}
        {% if block.type == 'accordion_item' %}
          {% assign item_num = forloop.index %}
          <div class="mc-acc-item" {{ block.shopify_attributes }} style="border-bottom:1px solid #ddd3c6">
            <button class="mc-acc-btn">
              <span style="font-family:'Mulish',sans-serif;font-size:12px;color:#bb7a33;letter-spacing:0.08em;flex:none">{% if item_num < 10 %}0{{ item_num }}{% else %}{{ item_num }}{% endif %}</span>
              <span style="flex:1;font-family:'Newsreader',serif;font-size:21px;color:#1f1c17;line-height:1.3">{{ block.settings.title }}</span>
              <span class="mc-acc-ico" style="flex:none;width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-family:'Mulish',sans-serif;font-size:22px;font-weight:300;color:#8a7f70;transition:transform .3s">+</span>
            </button>
            <div class="mc-acc-panel">
              <div style="padding:0 4px 28px 48px">
                <p style="margin:0;font-family:'Newsreader',serif;font-size:17px;line-height:1.66;color:#48433a;max-width:62ch">{{ block.settings.body }}</p>
                {% if block.settings.source_url != blank %}
                  <a href="{{ block.settings.source_url }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;margin-top:16px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#bb7a33;text-decoration:none">{{ block.settings.source_label }} →</a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function(){if(!window.mcBaseInit){window.mcBaseInit=true;document.addEventListener('DOMContentLoaded',function(){var io=null;if('IntersectionObserver' in window){io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('mc-on');io.unobserve(e.target);}});},{threshold:0.12});}document.querySelectorAll('[data-mc-reveal]').forEach(function(el){if(io){io.observe(el);}else{el.classList.add('mc-on');}});});}})();
(function() {
  var container = document.getElementById('mc-acc-{{ section.id }}');
  if (!container) return;
  var openIdx = null;
  var items = container.querySelectorAll('.mc-acc-item');
  items.forEach(function(item, i) {
    var btn = item.querySelector('.mc-acc-btn');
    var panel = item.querySelector('.mc-acc-panel');
    var ico = item.querySelector('.mc-acc-ico');
    if (!btn) return;
    btn.addEventListener('click', function() {
      var isOpen = openIdx === i;
      if (openIdx !== null && items[openIdx]) {
        items[openIdx].querySelector('.mc-acc-panel').style.maxHeight = '0';
        items[openIdx].querySelector('.mc-acc-panel').style.opacity = '0';
        items[openIdx].querySelector('.mc-acc-ico').style.transform = 'none';
      }
      openIdx = isOpen ? null : i;
      if (!isOpen) {
        panel.style.maxHeight = '420px';
        panel.style.opacity = '1';
        ico.style.transform = 'rotate(45deg)';
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "MC — Ingredient Research",
  "settings": [
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#faf7f4"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ingredient research"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Morning sensory ritual & botanical research"},
    {"type": "textarea", "id": "intro", "label": "Intro text", "default": "Oil Pulling Elixir combines botanical oils, aromatic compounds, and sensory ingredients traditionally associated with cleansing rituals, breath freshness, and morning orientation. Contemporary research continues exploring how plant oils and oral sensory environments may influence perception and physiological awareness."}
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion item",
      "settings": [
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "body", "label": "Body"},
        {"type": "text", "id": "source_label", "label": "Source label"},
        {"type": "text", "id": "source_url", "label": "Source URL"}
      ]
    }
  ],
  "presets": [{"name": "MC — Ingredient Research"}]
}
{% endschema %}