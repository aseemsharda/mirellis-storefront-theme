      <a href="/pages/listening?transition=rest" class="sound-listening-cta__card">Preparing for Rest</a>
      <a href="/pages/listening?transition=restore" class="sound-listening-cta__card">Restoring Energy</a>
      <a href="/pages/listening?transition=reflect" class="sound-listening-cta__card">Open Reflection</a>
    </div>

    <a href="/pages/listening" class="sound-listening-cta__link">Or enter without selecting →</a>

  </div>
</section>

