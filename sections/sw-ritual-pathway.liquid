{% if section.settings.show_section %}
<section class="rp-section">
  <div class="rp-container">
    <div class="rp-pathway">
      <div class="rp-step">
        <p class="rp-label">{{ section.settings.step_1_label }}</p>
        <p class="rp-body">{{ section.settings.step_1_body }}</p>
      </div>
      <div class="rp-separator">→</div>
      <div class="rp-step">
        <p class="rp-label">{{ section.settings.step_2_label }}</p>
        <p class="rp-body">{{ section.settings.step_2_body }}</p>
      </div>
      <div class="rp-separator">→</div>
      <div class="rp-step">
        <p class="rp-label">{{ section.settings.step_3_label }}</p>
        <p class="rp-body">{{ section.settings.step_3_body }}</p>
      </div>
    </div>

    <hr class="rp-rule">

    <div class="rp-depth-links">
      {% if section.settings.depth_link_1_text != blank and section.settings.depth_link_1_url != blank %}
      <a href="{{ section.settings.depth_link_1_url }}" class="rp-depth-link">{{ section.settings.depth_link_1_text }}</a>
      {% endif %}
      {% if section.settings.depth_link_2_text != blank and section.settings.depth_link_2_url != blank %}
      <a href="{{ section.settings.depth_link_2_url }}" class="rp-depth-link">{{ section.settings.depth_link_2_text }}</a>
      {% endif %}
    </div>

    <div class="rp-product">
      {% if section.settings.product_eyebrow != blank %}
      <p class="rp-product-eyebrow">{{ section.settings.product_eyebrow }}</p>
      {% endif %}
      {% if section.settings.product_heading != blank %}
      <h3 class="rp-product-heading">{{ section.settings.product_heading }}</h3>
      {% endif %}
      {% if section.settings.product_body != blank %}
      <p class="rp-product-body">{{ section.settings.product_body }}</p>
      {% endif %}
      {% if section.settings.product_cta_text != blank and section.settings.product_cta_link != blank %}
      <a href="{{ section.settings.product_cta_link }}" class="rp-cta">{{ section.settings.product_cta_text }}</a>
      {% endif %}
    </div>

    {% if section.settings.next_transition_text != blank and section.settings.next_transition_url != blank %}
    <p class="rp-next-transition">
      <a href="{{ section.settings.next_transition_url }}" class="rp-next-link">{{ section.settings.next_transition_text }}</a>
    </p>
    {% endif %}
  </div>
</section>
{% endif %}

<style>
.rp-section {
  background: #faf7f2;
  padding: 4rem 2rem 6rem 2rem;
}
.rp-container {
  max-width: 800px;
  margin: 0 auto;
}
.rp-pathway {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  gap: 2rem;
  align-items: flex-start;
  margin-bottom: 3rem;
}
.rp-step {
  flex: 1;
}
.rp-label {
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(26,26,24,0.45);
  margin: 0 0 0.75rem 0;
}
.rp-body {
  font-size: 0.9rem;
  line-height: 1.7;
  color: rgba(26,26,24,0.75);
  margin: 0;
}
.rp-separator {
  color: rgba(26,26,24,0.2);
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  padding: 0 0.5rem;
}
.rp-rule {
  border: none;
  border-top: 1px solid rgba(26,26,24,0.1);
  margin: 3rem 0;
}
.rp-depth-links {
  display: flex;
  gap: 4rem;
  margin-bottom: 4rem;
  justify-content: center;
}
.rp-depth-link {
  font-size: 0.85rem;
  color: rgba(26,26,24,0.45);
  text-decoration: none;
  border-bottom: 1px solid rgba(26,26,24,0.2);
  padding-bottom: 1px;
  transition: all 0.2s ease;
}
.rp-depth-link:hover {
  color: rgba(26,26,24,0.7);
  border-color: rgba(26,26,24,0.4);
}
.rp-product {
  margin-top: 4rem;
}
.rp-product-eyebrow {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(26,26,24,0.45);
  margin: 0 0 1rem 0;
}
.rp-product-heading {
  font-size: 1.5rem;
  font-weight: 400;
  color: #1a1a18;
  margin: 0 0 1.5rem 0;
  line-height: 1.3;
}
.rp-product-body {
  font-size: 1rem;
  line-height: 1.8;
  color: rgba(26,26,24,0.75);
  margin-bottom: 1.5rem;
}
.rp-cta {
  display: inline-block;
  padding: 0.6rem 1.25rem;
  border: 1px solid rgba(26,26,24,0.35);
  color: #1a1a18;
  text-decoration: none;
  font-size: 0.9rem;
  letter-spacing: 0.02em;
  transition: all 0.2s ease;
}
.rp-cta:hover {
  background: rgba(26,26,24,0.04);
  border-color: rgba(26,26,24,0.7);
}
.rp-next-transition {
  margin-top: 3rem;
  font-size: 0.85rem;
  color: rgba(26,26,24,0.5);
  font-style: italic;
  text-align: center;
}
.rp-next-link {
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid rgba(26,26,24,0.25);
  padding-bottom: 1px;
  transition: all 0.2s ease;
}
.rp-next-link:hover {
  color: rgba(26,26,24,0.8);
  border-color: rgba(26,26,24,0.5);
}
@media (max-width: 768px) {
  .rp-pathway {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .rp-separator {
    display: none;
  }
  .rp-depth-links {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .rp-depth-link {
    display: block;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Ritual Pathway & Product",
  "settings": [
    {
      "type": "text",
      "id": "step_1_label",
      "label": "Step 1 Label",
      "default": "Before the world"
    },
    {
      "type": "text",
      "id": "step_1_body",
      "label": "Step 1 Body",
      "default": "A sound environment that begins the day before the phone does"
    },
    {
      "type": "text",
      "id": "step_2_label",
      "label": "Step 2 Label",
      "default": "The first act"
    },
    {
      "type": "text",
      "id": "step_2_body",
      "label": "Step 2 Body",
      "default": "Morning Clarity Elixir. The mouth knows morning has begun."
    },
    {
      "type": "text",
      "id": "step_3_label",
      "label": "Step 3 Label",
      "default": "The pause"
    },
    {
      "type": "text",
      "id": "step_3_body",
      "label": "Step 3 Body",
      "default": "Three minutes without input before the day has named itself"
    },
    {
      "type": "text",
      "id": "product_eyebrow",
      "label": "Product Eyebrow",
      "default": "MORNING CLARITY"
    },
    {
      "type": "text",
      "id": "product_heading",
      "label": "Product Heading",
      "default": "The physical entry point into this ritual."
    },
    {
      "type": "textarea",
      "id": "product_body",
      "label": "Product Body",
      "default": "A daily oral elixir used in the first minutes of waking. Before screens. Before caffeine. Before conversation. The taste becomes the signal. The repetition makes it reliable."
    },
    {
      "type": "text",
      "id": "product_cta_text",
      "label": "Product CTA Text",
      "default": "Explore Morning Clarity"
    },
    {
      "type": "text",
      "id": "product_cta_link",
      "label": "Product CTA Link",
      "default": "/products/morning-clarity"
    },
    {
      "type": "text",
      "id": "depth_link_1_text",
      "label": "Depth Link 1 Text",
      "default": "Why this works →"
    },
    {
      "type": "text",
      "id": "depth_link_1_url",
      "label": "Depth Link 1 URL",
      "default": "/blogs/journal/the-first-30-minutes-after-waking-are-not-like-the-rest-of-the-day"
    },
    {
      "type": "text",
      "id": "depth_link_2_text",
      "label": "Depth Link 2 Text",
      "default": "The full ritual →"
    },
    {
      "type": "text",
      "id": "depth_link_2_url",
      "label": "Depth Link 2 URL",
      "default": "/products/morning-clarity"
    },
    {
      "type": "text",
      "id": "next_transition_text",
      "label": "Next Transition Text",
      "default": "The morning ritual begins tonight. Explore the evening transition →"
    },
    {
      "type": "text",
      "id": "next_transition_url",
      "label": "Next Transition URL",
      "default": "/pages/work-to-recovery"
    },
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    }
  ]
}
{% endschema %}
