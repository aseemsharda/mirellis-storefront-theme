<section class="mi-philosophy">

  <div class="container">

    <div class="mi-philosophy-inner">

      {% if section.settings.eyebrow != blank %}
        <p class="mi-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.content != blank %}
        <div class="mi-copy">
          {{ section.settings.content }}
        </div>
      {% endif %}

    </div>

  </div>

</section>

<style>

.mi-philosophy{
  padding:
  {{ section.settings.top_spacing }}px
  0
  {{ section.settings.bottom_spacing }}px;
}

.mi-philosophy-inner{
  max-width:{{ section.settings.content_width }}px;
  margin:0 auto;
  text-align:{{ section.settings.alignment }};
}

.mi-eyebrow{
  text-transform:uppercase;
  letter-spacing:.15em;
  opacity:.6;
  margin-bottom:12px;
}

.mi-philosophy h2{
  margin-bottom:24px;
}

.mi-copy{
  opacity:.8;
}

.mi-copy p{
  margin-bottom:20px;
}

</style>

{% schema %}
{
  "name": "Institute Philosophy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Institute"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "An Environment For Observation, Not Prescription"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Width",
      "min": 500,
      "max": 1200,
      "step": 50,
      "default": 800
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top Spacing",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Institute Philosophy"
    }
  ]
}
{% endschema %}