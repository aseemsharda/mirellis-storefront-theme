{%- comment -%}
  MIRELLIS — OBSERVATORY INDEX
  Blog listing at /blogs/observatory
  Reuses obs-article-card from assets/observatory.css
{%- endcomment -%}

{{ 'observatory.css' | asset_url | stylesheet_tag }}

{%- assign transition_map = 'sleep-to-wakefulness|Sleep → Wakefulness,work-to-recovery|Work → Recovery,stimulation-to-restoration|Stimulation → Restoration' | split: ',' -%}

{%- assign articles_per_page = section.settings.articles_per_page | default: 9 -%}

{%- paginate blog.articles by articles_per_page -%}

<div class="obs-index">


  {%- comment -%} ══ HEADER ══════════════════════════════════ {%- endcomment -%}

  <header class="obs-index__header">
    <div class="ml-container-reading">
      <div class="ml-text-breathing">

        {%- if section.settings.eyebrow != blank -%}
          <p class="obs-eyebrow ml-supporting-text">
            {{- section.settings.eyebrow -}}
          </p>
        {%- endif -%}

        <h1 class="ml-display-heading ml-headline-soft">
          {{- section.settings.heading | default: blog.title -}}
        </h1>

        {%- if section.settings.intro != blank -%}
          <p class="ml-contemplative-copy ml-copy-soft">
            {{- section.settings.intro -}}
          </p>
        {%- endif -%}

      </div>
    </div>
  </header>


  {%- comment -%} ══ TAG FILTERS ═════════════════════════════ {%- endcomment -%}

  <div class="obs-index__filters">
    <div class="ml-container-cinematic">
      <nav class="obs-filter-nav" aria-label="Filter by transition">

        <a
          href="{{ blog.url }}"
          class="obs-filter-link ml-supporting-text{%- if current_tags == blank %} obs-filter-link--active{%- endif -%}"
        >
          All
        </a>

        {%- for entry in transition_map -%}
          {%- assign parts = entry | split: '|' -%}
          {%- assign filter_slug = parts[0] -%}
          {%- assign filter_label = parts[1] -%}
          <a
            href="{{ blog.url }}/tagged/{{ filter_slug }}"
            class="obs-filter-link ml-supporting-text{%- if current_tags contains filter_slug %} obs-filter-link--active{%- endif -%}"
          >
            {{- filter_label -}}
          </a>
        {%- endfor -%}

      </nav>
    </div>
  </div>


  {%- comment -%} ══ ARTICLE GRID ════════════════════════════ {%- endcomment -%}

  <div class="obs-index__grid-wrap">
    <div class="ml-container-cinematic">

      {%- if paginate.items > 0 -%}

        <div class="obs-articles__grid">

          {%- for article in blog.articles -%}

            {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
            {%- assign reading_minutes = word_count | divided_by: 200 | at_least: 1 | at_most: 30 -%}

            {%- assign article_transition = '' -%}
            {%- for entry in transition_map -%}
              {%- assign parts = entry | split: '|' -%}
              {%- if article.tags contains parts[0] -%}
                {%- assign article_transition = parts[1] -%}
              {%- endif -%}
            {%- endfor -%}

            <a href="{{ article.url }}" class="obs-article-card ml-soft-hover">

              {%- if article.image != blank -%}
                <div class="obs-article-card__image">
                  {{-
                    article.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 900',
                      class: 'obs-article-card__img ml-atmospheric-image'
                  -}}
                </div>
              {%- endif -%}

              <div class="obs-article-card__body ml-rhythm-soft">

                {%- if article_transition != blank -%}
                  <p class="obs-article-card__tag ml-supporting-text">
                    {{- article_transition -}}
                  </p>
                {%- endif -%}

                <h2 class="obs-article-card__title">
                  {{- article.title -}}
                </h2>

                {%- if article.excerpt != blank -%}
                  <p class="obs-article-card__excerpt ml-body-copy ml-copy-soft">
                    {{- article.excerpt | strip_html | truncate: 130 -}}
                  </p>
                {%- endif -%}

                <div class="obs-article-card__meta ml-supporting-text">
                  <span>{{- article.published_at | date: '%B %d, %Y' -}}</span>
                  <span class="obs-meta-dot" aria-hidden="true">·</span>
                  <span>{{- reading_minutes -}} min read</span>
                </div>

              </div>

            </a>

          {%- endfor -%}

        </div>

      {%- else -%}

        <p class="obs-index__empty ml-body-copy ml-copy-soft">
          {{- section.settings.empty_message | default: 'No articles published yet.' -}}
        </p>

      {%- endif -%}

    </div>
  </div>


  {%- comment -%} ══ PAGINATION ══════════════════════════════ {%- endcomment -%}

  {%- if paginate.pages > 1 -%}
    <div class="obs-index__pagination">
      <div class="ml-container-cinematic">
        {{- paginate | default_pagination:
              next: section.settings.pagination_next,
              previous: section.settings.pagination_prev -}}
      </div>
    </div>
  {%- endif -%}


</div>

{%- endpaginate -%}


{% schema %}
{
  "name": "Observatory Index",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE OBSERVATORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Human State Transitions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Research on how humans move between states — and what modern life has done to those transitions."
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No articles published yet."
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "text",
      "id": "pagination_next",
      "label": "Next label",
      "default": "Next →"
    },
    {
      "type": "text",
      "id": "pagination_prev",
      "label": "Previous label",
      "default": "← Previous"
    }
  ],
  "presets": [
    {
      "name": "Observatory Index"
    }
  ]
}
{% endschema %}
