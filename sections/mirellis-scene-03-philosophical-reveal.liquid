{% comment %}
MIRELLIS — SCENE 03
PHILOSOPHICAL REVEAL
Ritual Reframing Layer
{% endcomment %}

<section class="mirellis-philosophical">

  <!-- BACKGROUND LAYER -->
  <div class="mirellis-philosophical-media">

    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: class: 'mirellis-philosophical-image'
      }}
    {% endif %}

  </div>

  <!-- SOFT ATMOSPHERIC OVERLAY -->
  <div class="mirellis-philosophical-overlay"></div>

  <!-- CONTENT -->
  <div class="mirellis-philosophical-content">

    {% if section.settings.heading != blank %}
      <h2 class="mirellis-philosophical-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="mirellis-philosophical-subtext">
        {{ section.settings.subtext }}
      </p>
    {% endif %}

    {% if section.settings.core != blank %}
      <div class="mirellis-philosophical-core">
        {{ section.settings.core }}
      </div>
    {% endif %}

  </div>

</section>

<style>

/* =========================
   SCENE 03 — PHILOSOPHICAL REVEAL
========================= */

.mirellis-philosophical {
  position: relative;
  min-height: 100vh;
  width: 100%;
  background: #f6f1ea;
  overflow: hidden;
}

/* IMAGE */
.mirellis-philosophical-media {
  position: absolute;
  inset: 0;
}

.mirellis-philosophical-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(0.92) saturate(0.88);
}

/* OVERLAY — more minimal, more clarity */
.mirellis-philosophical-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(246,241,232,0.55) 0%,
    rgba(246,241,232,0.85) 55%,
    rgba(246,241,232,0.96) 100%
  );
}

/* CONTENT */
.mirellis-philosophical-content {
  position: relative;
  z-index: 2;
  max-width: 860px;
  margin: 0 auto;
  padding: 140px 24px;
  text-align: center;
}

/* HEADLINE */
.mirellis-philosophical-heading {
  font-size: clamp(26px, 3.2vw, 54px);
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: -0.02em;
  color: #1c1c1c;
  margin-bottom: 22px;
}

/* SUBTEXT */
.mirellis-philosophical-subtext {
  font-size: 16px;
  line-height: 1.7;
  color: rgba(28,28,28,0.72);
  max-width: 620px;
  margin: 0 auto 36px auto;
}

/* CORE PHILOSOPHICAL BLOCK */
.mirellis-philosophical-core {
  font-size: 17px;
  line-height: 1.85;
  color: rgba(28,28,28,0.86);
  max-width: 600px;
  margin: 0 auto;

  padding-top: 28px;
  border-top: 1px solid rgba(0,0,0,0.08);

  font-style: normal;
  letter-spacing: -0.01em;
}

/* MOBILE */
@media screen and (max-width: 768px) {
  .mirellis-philosophical-content {
    padding: 100px 20px;
  }

  .mirellis-philosophical-heading {
    font-size: 28px;
  }

  .mirellis-philosophical-subtext {
    font-size: 15px;
  }
}

</style>

{% schema %}
{
  "name": "Mirellis Scene 03",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rituals are not habits."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "They are not wellness practices or self-care routines."
    },
    {
      "type": "textarea",
      "id": "core",
      "label": "Core Philosophical Statement",
      "default": "Rituals are repeated sensory transitions that the nervous system learns to recognize over time. The body responds before conscious intention arrives — through light, sound, pacing, and atmosphere."
    }
  ],
  "presets": [
    {
      "name": "Mirellis Scene 03"
    }
  ]
}
{% endschema %}