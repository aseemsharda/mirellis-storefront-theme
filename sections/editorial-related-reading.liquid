<section class="editorial-related-reading">

  <div class="page-width">

    <div class="editorial-related-reading__inner">

      {% if section.settings.heading != blank %}

        <h2 class="editorial-related-reading__heading">
          {{ section.settings.heading }}
        </h2>

      {% endif %}

      <div class="editorial-related-reading__grid">

        {% for block in section.blocks %}

          <a href="{{ block.settings.link }}" class="editorial-related-reading__item">

            <p class="editorial-related-reading__label">
              {{ block.settings.label }}
            </p>

            <h3 class="editorial-related-reading__title">
              {{ block.settings.title }}
            </h3>

            <div class="editorial-related-reading__description">
              {{ block.settings.description }}
            </div>

          </a>

        {% endfor %}

      </div>

    </div>

  </div>

</section>

<style>

.editorial-related-reading {
  padding: 110px 0;
  background: #f7f3ee;
}

.editorial-related-reading__inner {
  max-width: 1100px;
  margin: 0 auto;
}

.editorial-related-reading__heading {
  margin: 0 0 50px;

  font-size: 34px;
  line-height: 1.3;
  font-weight: 300;

  color: #1f1f1f;
}

.editorial-related-reading__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.editorial-related-reading__item {
  display: block;

  padding: 34px;
  background: #fcfaf7;

  border-radius: 2px;

  text-decoration: none;

  transition: transform 0.35s ease,
              background 0.35s ease;
}

.editorial-related-reading__item:hover {
  transform: translateY(-2px);
  background: #ffffff;
}

.editorial-related-reading__label {
  margin: 0 0 18px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: #8b8378;
}

.editorial-related-reading__title {
  margin: 0 0 18px;

  font-size: 24px;
  line-height: 1.4;
  font-weight: 400;

  color: #202020;
}

.editorial-related-reading__description {
  font-size: 15px;
  line-height: 1.85;

  color: #5d5852;
}

@media screen and (max-width: 990px) {

  .editorial-related-reading {
    padding: 90px 0;
  }

  .editorial-related-reading__grid {
    grid-template-columns: 1fr;
  }

}

@media screen and (max-width: 749px) {

  .editorial-related-reading {
    padding: 70px 0;
  }

  .editorial-related-reading__heading {
    margin-bottom: 36px;
    font-size: 28px;
  }

  .editorial-related-reading__item {
    padding: 24px;
  }

  .editorial-related-reading__title {
    font-size: 20px;
  }

}

</style>

{% schema %}
{
  "name": "Editorial Related Reading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Reading"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Reading Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Editorial"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Related Reading"
    }
  ]
}
{% endschema %}