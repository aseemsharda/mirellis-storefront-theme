<section class="atmospheric-divider">

  {% if section.settings.image != blank %}

    <div class="atmospheric-divider__media">

      {{
        section.settings.image
        | image_url: width: 2200
        | image_tag:
          loading: 'lazy',
          class: 'atmospheric-divider__image'
      }}

      <div class="atmospheric-divider__overlay"></div>

    </div>

  {% endif %}

  <div class="atmospheric-divider__content">

    {% if section.settings.label != blank %}

      <p class="atmospheric-divider__label">
        {{ section.settings.label }}
      </p>

    {% endif %}

    {% if section.settings.text != blank %}

      <div class="atmospheric-divider__text">
        {{ section.settings.text }}
      </div>

    {% endif %}

  </div>

</section>

<style>

.atmospheric-divider {
  position: relative;
  overflow: hidden;
  min-height: 90vh;
  background: #f7f3ee;
}

.atmospheric-divider__media {
  position: absolute;
  inset: 0;
}

.atmospheric-divider__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.atmospheric-divider__overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to bottom,
      rgba(20,20,20,0.18),
      rgba(20,20,20,0.38)
    );
}

.atmospheric-divider__content {
  position: relative;
  z-index: 2;

  max-width: 760px;

  padding:
    180px
    60px;

  color: #fcfaf7;
}

.atmospheric-divider__label {
  margin-bottom: 28px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: rgba(255,255,255,0.72);
}

.atmospheric-divider__text {
  font-size: 42px;
  line-height: 1.55;
  font-weight: 300;
}

.atmospheric-divider__text p {
  margin: 0;
}

@media screen and (max-width: 990px) {

  .atmospheric-divider {
    min-height: 72vh;
  }

  .atmospheric-divider__content {
    padding:
      120px
      40px;
  }

  .atmospheric-divider__text {
    font-size: 34px;
    line-height: 1.6;
  }

}

@media screen and (max-width: 749px) {

  .atmospheric-divider {
    min-height: 62vh;
  }

  .atmospheric-divider__content {
    padding:
      100px
      24px;
  }

  .atmospheric-divider__text {
    font-size: 24px;
    line-height: 1.7;
  }

}

</style>

{% schema %}
{
  "name": "Atmospheric Divider",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Atmosphere"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The nervous system remembers environments long before conscious thought fully explains them.</p>"
    }
  ],
  "presets": [
    {
      "name": "Atmospheric Divider"
    }
  ]
}
{% endschema %}