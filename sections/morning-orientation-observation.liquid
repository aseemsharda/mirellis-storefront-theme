<style>

.mirellis-observation{
  background:#f8f4ee;
  min-height:100vh;
}

.observation-progress{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:2px;
  background:rgba(0,0,0,.06);
  z-index:100;
}

.observation-progress-bar{
  width:16%;
  height:100%;
  background:#1f1f1f;
  transition:.6s ease;
}

.observation-container{
  width:100%;
}

.observation-screen{
  display:none;
  min-height:100vh;
  max-width:900px;
  margin:0 auto;
  padding:80px 32px;

  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}

.observation-screen.active{
  display:flex;
}

.observation-eyebrow{
  font-size:12px;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:#8d867d;
  margin-bottom:30px;
}

.observation-screen h1{
  font-size:clamp(58px,8vw,110px);
  line-height:.95;
  letter-spacing:-0.04em;
  font-weight:400;
  margin-bottom:40px;
}

.observation-screen h2{
  font-size:clamp(48px,7vw,90px);
  line-height:1;
  font-weight:400;
  margin-bottom:50px;
}

.observation-intro{
  font-size:30px;
  line-height:1.7;
  margin-bottom:10px;
}

.observation-description{
  margin-top:40px;
  margin-bottom:15px;
  color:#6a625b;
}

.observation-question{
  font-size:38px;
  line-height:1.4;
  font-weight:400;
  margin-bottom:40px;
}

.observation-meta{
  margin-bottom:40px;
  font-size:12px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#8d867d;
}

.observation-screen p{
  font-size:22px;
  line-height:1.9;
  color:#5d5650;
}

.observation-primary{
  margin-top:30px;
  padding:18px 34px;
  background:#1f1f1f;
  color:white;
  border:none;
  cursor:pointer;
}

.observation-choice{
  width:100%;
  max-width:500px;
  padding:20px;
  margin:12px auto;
  background:white;
  border:1px solid rgba(0,0,0,.08);
  cursor:pointer;
}

.observation-choice:hover{
  border-color:#1f1f1f;
}

@media(max-width:768px){

.observation-screen{
  padding:60px 24px;
}

.observation-screen h1{
  font-size:56px;
}

.observation-screen h2{
  font-size:48px;
}

.observation-intro{
  font-size:22px;
}

.observation-screen p{
  font-size:18px;
}

.observation-question{
  font-size:28px;
}

.observation-choice{
  max-width:100%;
}

}
.pause-timer{
  font-size:80px;
  line-height:1;
  margin:40px 0;
  color:#1f1f1f;
  font-weight:300;
}
</style>

<script>

document.addEventListener('DOMContentLoaded', function(){

const screens = document.querySelectorAll('.observation-screen');
const buttons = document.querySelectorAll('.next-step');
const progress = document.querySelector('.observation-progress-bar');

let current = 0;

buttons.forEach(button => {

button.addEventListener('click', function(){

if(current < screens.length - 1){

screens[current].classList.remove('active');

current++;

screens[current].classList.add('active');

let percentage =
((current + 1) / screens.length) * 100;

progress.style.width = percentage + '%';

}

});

});

});

</script>

