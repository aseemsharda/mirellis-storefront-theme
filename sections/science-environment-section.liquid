{% stylesheet %}

.science-environment {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: #141210;
}

.science-environment__media {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.science-environment__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.science-environment__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    linear-gradient(
      to top,
      rgba(10,9,8,0.82),
      rgba(10,9,8,0.28)
    );
}

.science-environment__ambient {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    radial-gradient(
      circle at top right,
      rgba(199,155,96,0.12),
      transparent 34%
    );
  mix-blend-mode: screen;
}

.science-environment__content {
  position: relative;
  z-index: 3;
  width: 100%;
  padding: 140px 60px;
}

.science-environment__inner {
  max-width: 760px;
}

.science-environment__eyebrow {
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.62);
  margin-bottom: 24px;
  font-weight: 500;
}

.science-environment__heading {
  font-family: var(--heading-font-family);
  font-size: clamp(48px, 6vw, 92px);
  line-height: 0.96;
  letter-spacing: -0.04em;
  color: #f8f4ef;
  margin: 0;
  font-weight: 400;
  max-width: 900px;
}

.science-environment__text {
  margin-top: 34px;
  max-width: 620px;
  font-size: 18px;
  line-height: 1.95;
  color: rgba(255,255,255,0.80);
}

.science-environment__text p {
  margin: 0 0 24px;
}

.science-environment__text p:last-child {
  margin-bottom: 0;
}

@media screen and (max-width: 999px) {

  .science-environment {
    min-height: 82vh;
  }

  .science-environment__content {
    padding: 90px 24px;
  }

  .science-environment__heading {
    font-size: 54px;
    line-height: 1;
  }

  .science-environment__text {
    margin-top: 26px;
    font-size: 16px;
    line-height: 1.82;
  }

}

{% endstylesheet %}

<section class="science-environment">

  <div class="science-environment__media">

    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
        loading: 'lazy',
        widths: '1200, 1600, 2000, 2400'
      }}
    {% endif %}

  </div>

  <div class="science-environment__overlay"></div>

  <div class="science-environment__ambient"></div>

  <div class="science-environment__content">

    <div class="science-environment__inner">

      {% if section.settings.eyebrow != blank %}
        <div class="science-environment__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="science-environment__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="science-environment__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Science Environment",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Environmental Psychology"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Environments Quietly Shape Internal States"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Light, sound, temperature, texture, rhythm, and sensory repetition continuously influence how the nervous system feels and responds.</p><p>The body does not only respond to thoughts. It responds to atmosphere.</p>"
    }
  ],
  "presets": [
    {
      "name": "Science Environment"
    }
  ]
}
{% endschema %}