<section class="homepage-philosophy">

  <div class="page-width">

    <div class="homepage-philosophy__inner">

      {% if section.settings.label != blank %}

        <p class="homepage-philosophy__label">
          {{ section.settings.label }}
        </p>

      {% endif %}

      <div class="homepage-philosophy__text">
        {{ section.settings.text }}
      </div>

    </div>

  </div>

</section>

<style>

.homepage-philosophy {
  padding: 140px 0;
  background: #fcfaf7;
}

.homepage-philosophy__inner {
  max-width: 980px;
  margin: 0 auto;
}

.homepage-philosophy__label {
  margin-bottom: 32px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: #8b8378;
}

.homepage-philosophy__text {
  font-size: 38px;
  line-height: 1.75;
  font-weight: 300;

  color: #222222;
}

.homepage-philosophy__text p {
  margin: 0 0 36px;
}

.homepage-philosophy__text p:last-child {
  margin-bottom: 0;
}

@media screen and (max-width: 990px) {

  .homepage-philosophy {
    padding: 110px 24px;
  }

  .homepage-philosophy__text {
    font-size: 30px;
    line-height: 1.8;
  }

}

@media screen and (max-width: 749px) {

  .homepage-philosophy {
    padding: 80px 24px;
  }

  .homepage-philosophy__label {
    margin-bottom: 24px;
  }

  .homepage-philosophy__text {
    font-size: 22px;
    line-height: 1.85;
  }

  .homepage-philosophy__text p {
    margin-bottom: 28px;
  }

}

</style>

{% schema %}
{
  "name": "Homepage Philosophy",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Philosophy"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Modern life keeps the nervous system inside continuous stimulation. Mirellis creates slower sensory environments through ritual pacing, atmosphere, repetition, and emotional coherence.</p>"
    }
  ],
  "presets": [
    {
      "name": "Homepage Philosophy"
    }
  ]
}
{% endschema %}