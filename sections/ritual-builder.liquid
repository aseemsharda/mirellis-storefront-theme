<section class="ritual-builder">

  <div class="ritual-builder-container">

    <div class="ritual-builder-header">

      <p class="ritual-builder-eyebrow">
        Build A Ritual
      </p>

      <h2>
        Small repeated signals often become more powerful than dramatic changes.
      </h2>

      <p class="ritual-builder-intro">
        Choose a transition you would like to explore. Mirellis rituals are designed around orientation, restoration and repeated sensory signals.
      </p>

    </div>

    <div class="ritual-selector">

      <button class="ritual-tab active" data-target="morning">
        Morning
      </button>

      <button class="ritual-tab" data-target="evening">
        Evening
      </button>

    </div>

    <div id="morning" class="ritual-content active">

      <div class="ritual-card">

        <div class="ritual-meta">
          Suggested Duration · 5–10 Minutes
        </div>

        <h3>
          Morning Clarity Ritual
        </h3>

        <div class="ritual-step">
          <span>01</span>
          <div>
            <h4>Mirellis Oil Pulling Elixir</h4>
            <p>
              Begin the day with a consistent sensory signal and intentional pause.
            </p>
          </div>
        </div>

        <div class="ritual-step">
          <span>02</span>
          <div>
            <h4>Morning Clarity Playlist</h4>
            <p>
              Gentle sound cues that support orientation before the day accelerates.
            </p>
          </div>
        </div>

        <div class="ritual-step">
          <span>03</span>
          <div>
            <h4>Reflection Prompt</h4>
            <p>
              What feels most important today?
            </p>
          </div>
        </div>

        <div class="ritual-links">

          <a href="https://open.spotify.com/playlist/0kPGfp1m7uIAEkT8h6j66P" target="_blank">
            Listen To Playlist
          </a>

          <a href="/pages/journal">
            Explore Journal
          </a>

        </div>

      </div>

    </div>

    <div id="evening" class="ritual-content">

      <div class="ritual-card">

        <div class="ritual-meta">
          Suggested Duration · 10–15 Minutes
        </div>

        <h3>
          Evening Restoration Ritual
        </h3>

        <div class="ritual-step">
          <span>01</span>
          <div>
            <h4>Mirellis Stillness Elixir</h4>
            <p>
              A repeated sensory cue that helps create distinction between activity and restoration.
            </p>
          </div>
        </div>

        <div class="ritual-step">
          <span>02</span>
          <div>
            <h4>Stillness Playlist</h4>
            <p>
              Gentle atmosphere designed to support environmental transition.
            </p>
          </div>
        </div>

        <div class="ritual-step">
          <span>03</span>
          <div>
            <h4>Reflection Prompt</h4>
            <p>
              What would feel complete if left unfinished until tomorrow?
            </p>
          </div>
        </div>

        <div class="ritual-links">

          <a href="https://open.spotify.com/playlist/6VG02jtawiXTcOGi0nZzp6" target="_blank">
            Listen To Playlist
          </a>

          <a href="/pages/journal">
            Explore Journal
          </a>

        </div>

      </div>

    </div>

  </div>

</section>

<style>

.ritual-builder{
padding:140px 40px;
background:#f8f4ee;
}

.ritual-builder-container{
max-width:1000px;
margin:0 auto;
}

.ritual-builder-header{
text-align:center;
max-width:760px;
margin:0 auto 70px;
}

.ritual-builder-eyebrow{
font-size:13px;
letter-spacing:.16em;
text-transform:uppercase;
color:#8d867d;
margin-bottom:20px;
}

.ritual-builder-header h2{
font-size:clamp(40px,5vw,68px);
line-height:1.08;
font-weight:400;
margin-bottom:24px;
color:#1f1f1f;
}

.ritual-builder-intro{
font-size:20px;
line-height:1.9;
color:#5d5650;
}

.ritual-selector{
display:flex;
justify-content:center;
gap:12px;
margin-bottom:50px;
}

.ritual-tab{
padding:14px 28px;
background:white;
border:none;
cursor:pointer;
font-size:14px;
letter-spacing:.08em;
text-transform:uppercase;
}

.ritual-tab.active{
background:#1f1f1f;
color:white;
}

.ritual-content{
display:none;
}

.ritual-content.active{
display:block;
}

.ritual-card{
background:white;
padding:60px;
border-radius:22px;
}

.ritual-meta{
font-size:13px;
letter-spacing:.12em;
text-transform:uppercase;
color:#8d867d;
margin-bottom:24px;
}

.ritual-card h3{
font-size:42px;
font-weight:400;
margin-bottom:40px;
}

.ritual-step{
display:flex;
gap:24px;
margin-bottom:34px;
}

.ritual-step span{
font-size:28px;
color:#b3aca3;
min-width:50px;
}

.ritual-step h4{
font-size:22px;
font-weight:400;
margin-bottom:10px;
}

.ritual-step p{
font-size:17px;
line-height:1.8;
color:#5d5650;
}

.ritual-links{
display:flex;
gap:20px;
margin-top:40px;
flex-wrap:wrap;
}

.ritual-links a{
padding:14px 24px;
border:1px solid rgba(0,0,0,.1);
text-decoration:none;
color:#1f1f1f;
}

@media(max-width:768px){

.ritual-builder{
padding:90px 24px;
}

.ritual-card{
padding:30px;
}

.ritual-card h3{
font-size:32px;
}

.ritual-step{
flex-direction:column;
gap:10px;
}

}

</style>

<script>

document.addEventListener('DOMContentLoaded', function(){

const tabs = document.querySelectorAll('.ritual-tab');

tabs.forEach(tab => {

tab.addEventListener('click', function(){

document.querySelectorAll('.ritual-tab').forEach(t=>{
t.classList.remove('active');
});

document.querySelectorAll('.ritual-content').forEach(c=>{
c.classList.remove('active');
});

tab.classList.add('active');

document.getElementById(
tab.dataset.target
).classList.add('active');

});

});

});

</script>

