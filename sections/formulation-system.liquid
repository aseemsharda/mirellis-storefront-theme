{% style %}

.mirellis-formulation {
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  overflow: hidden;
}

.mirellis-formulation .page-width {
  max-width: 1320px;
  margin: 0 auto;
  padding-left: 40px;
  padding-right: 40px;
}

/* =========================
   HEADER
========================= */

.mirellis-formulation-header {
  max-width: 920px;
  margin: 0 auto 120px;
  text-align: center;
}

.mirellis-eyebrow {
  font-size: 11px;
  letter-spacing: .24em;
  text-transform: uppercase;
  opacity: .46;
  margin-bottom: 24px;
  color: {{ section.settings.text_color }};
}

.mirellis-heading {
  font-size: clamp(44px, 6vw, 88px);
  line-height: .96;
  letter-spacing: -.06em;
  font-weight: 400;
  margin: 0 auto 36px;
  color: {{ section.settings.heading_color }};
  max-width: 900px;
}

.mirellis-description {
  font-size: 20px;
  line-height: 1.95;
  color: {{ section.settings.text_color }};
  opacity: .72;
  max-width: 760px;
  margin: 0 auto;
}

.mirellis-intro-link {
  display: inline-block;
  margin-top: 42px;
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  text-decoration: none;
  color: {{ section.settings.heading_color }};
  border-bottom: 1px solid rgba(0,0,0,.14);
  padding-bottom: 5px;
  transition: all .4s ease;
}

.mirellis-intro-link:hover {
  opacity: .55;
}

/* =========================
   STACK
========================= */

.mirellis-formulation-stack {
  display: flex;
  flex-direction: column;
  gap: 54px;
  max-width: 1080px;
  margin: 0 auto;
}

/* =========================
   CLUSTER
========================= */

.mirellis-cluster {
  padding: 58px;
  background:
  linear-gradient(
    180deg,
    rgba(255,255,255,.58) 0%,
    rgba(248,244,238,.84) 100%
  );

  border: 1px solid rgba(0,0,0,.04);

  transition: all .45s ease;
}

/* stagger */

.mirellis-cluster:nth-child(2) {
  margin-left: 90px;
}

.mirellis-cluster:nth-child(3) {
  margin-right: 70px;
}

.mirellis-cluster:hover {
  transform: translateY(-2px);
}

.mirellis-cluster-label {
  font-size: 11px;
  letter-spacing: .22em;
  text-transform: uppercase;
  opacity: .42;
  margin-bottom: 26px;
  color: {{ section.settings.text_color }};
}

.mirellis-cluster-heading {
  font-size: 42px;
  line-height: 1.18;
  letter-spacing: -.04em;
  font-weight: 400;
  margin: 0 0 52px;
  color: {{ section.settings.heading_color }};
  max-width: 82%;
}

/* =========================
   INGREDIENTS
========================= */

.mirellis-ingredient {
  border-top: 1px solid rgba(0,0,0,.05);
  padding: 26px 0;
}

.mirellis-ingredient:last-child {
  border-bottom: 1px solid rgba(0,0,0,.05);
}

.mirellis-ingredient summary {
  list-style: none;
  cursor: pointer;
  position: relative;
  font-size: 28px;
  line-height: 1.3;
  letter-spacing: -.03em;
  color: {{ section.settings.heading_color }};
  padding-right: 32px;
  transition: all .35s ease;
}

.mirellis-ingredient summary:hover {
  opacity: .62;
}

.mirellis-ingredient summary::-webkit-details-marker {
  display: none;
}

.mirellis-ingredient summary::after {
  content: '+';
  position: absolute;
  right: 0;
  top: 0;
  opacity: .32;
  transition: all .35s ease;
}

.mirellis-ingredient[open] summary::after {
  content: '−';
}

.mirellis-ingredient-content {
  padding-top: 28px;
  max-width: 72%;
}

.mirellis-role {
  font-size: 17px;
  line-height: 1.95;
  color: {{ section.settings.heading_color }};
  margin-bottom: 18px;
}

.mirellis-text {
  font-size: 15px;
  line-height: 2;
  color: {{ section.settings.text_color }};
  opacity: .74;
}

.mirellis-link {
  display: inline-block;
  margin-top: 24px;
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  text-decoration: none;
  color: {{ section.settings.heading_color }};
  border-bottom: 1px solid rgba(0,0,0,.14);
  padding-bottom: 5px;
  transition: all .4s ease;
}

.mirellis-link:hover {
  opacity: .55;
}

/* =========================
   MOBILE
========================= */

@media screen and (max-width: 990px) {

  .mirellis-formulation {
    padding: 90px 0 !important;
  }

  .mirellis-formulation .page-width {
    padding-left: 24px;
    padding-right: 24px;
  }

  .mirellis-formulation-header {
    margin-bottom: 70px;
  }

  .mirellis-heading {
    font-size: 52px;
    max-width: 100%;
  }

  .mirellis-description {
    font-size: 17px;
    max-width: 100%;
  }

  .mirellis-cluster {
    padding: 34px;
    margin: 0 !important;
  }

  .mirellis-cluster-heading {
    font-size: 30px;
    max-width: 100%;
  }

  .mirellis-ingredient summary {
    font-size: 24px;
  }

  .mirellis-ingredient-content {
    max-width: 100%;
  }

}

{% endstyle %}


<section class="mirellis-formulation">

  <div class="page-width">

    <!-- HEADER -->

    <div class="mirellis-formulation-header">

      {% if section.settings.eyebrow != blank %}
        <div class="mirellis-eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="mirellis-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="mirellis-description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url }}" class="mirellis-intro-link">
          {{ section.settings.link_text }}
        </a>
      {% endif %}

    </div>


    <!-- STACK -->

    <div class="mirellis-formulation-stack">

      {% for block in section.blocks %}

        <div class="mirellis-cluster" {{ block.shopify_attributes }}>

          {% if block.settings.label != blank %}
            <div class="mirellis-cluster-label">
              {{ block.settings.label }}
            </div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h3 class="mirellis-cluster-heading">
              {{ block.settings.heading }}
            </h3>
          {% endif %}


          <!-- INGREDIENT 1 -->

          {% if block.settings.ing1 != blank %}
          <details class="mirellis-ingredient">

            <summary>
              {{ block.settings.ing1 }}
            </summary>

            <div class="mirellis-ingredient-content">

              <div class="mirellis-role">
                {{ block.settings.ing1_role }}
              </div>

              <div class="mirellis-text">
                {{ block.settings.ing1_text }}
              </div>

              {% if block.settings.ing1_link != blank %}
                <a href="{{ block.settings.ing1_link }}" class="mirellis-link">
                  Explore Ingredient Research
                </a>
              {% endif %}

            </div>

          </details>
          {% endif %}


          <!-- INGREDIENT 2 -->

          {% if block.settings.ing2 != blank %}
          <details class="mirellis-ingredient">

            <summary>
              {{ block.settings.ing2 }}
            </summary>

            <div class="mirellis-ingredient-content">

              <div class="mirellis-role">
                {{ block.settings.ing2_role }}
              </div>

              <div class="mirellis-text">
                {{ block.settings.ing2_text }}
              </div>

              {% if block.settings.ing2_link != blank %}
                <a href="{{ block.settings.ing2_link }}" class="mirellis-link">
                  Explore Ingredient Research
                </a>
              {% endif %}

            </div>

          </details>
          {% endif %}


          <!-- INGREDIENT 3 -->

          {% if block.settings.ing3 != blank %}
          <details class="mirellis-ingredient">

            <summary>
              {{ block.settings.ing3 }}
            </summary>

            <div class="mirellis-ingredient-content">

              <div class="mirellis-role">
                {{ block.settings.ing3_role }}
              </div>

              <div class="mirellis-text">
                {{ block.settings.ing3_text }}
              </div>

              {% if block.settings.ing3_link != blank %}
                <a href="{{ block.settings.ing3_link }}" class="mirellis-link">
                  Explore Ingredient Research
                </a>
              {% endif %}

            </div>

          </details>
          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Formulation System",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inside the Formulation"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The architecture behind Stillness Elixir"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Stillness Elixir was formulated through layered Ayurvedic composition — combining grounding oils, adaptogenic botanicals, and calming aromatic layers selected to support sensory slowing and evening decompression."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Explore the Formulation Philosophy"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f1eb"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1f1a17"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1f1a17"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 40,
      "max": 240,
      "step": 10,
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 40,
      "max": 240,
      "step": 10,
      "default": 140
    }
  ],

  "blocks": [
    {
      "type": "cluster",
      "name": "Ingredient Cluster",
      "settings": [

        {
          "type": "text",
          "id": "label",
          "label": "Cluster Label",
          "default": "Cognitive Quieting"
        },

        {
          "type": "textarea",
          "id": "heading",
          "label": "Cluster Heading",
          "default": "Designed to soften mental overstimulation and cognitive momentum during evening transitions."
        },

        {
          "type": "text",
          "id": "ing1",
          "label": "Ingredient 1",
          "default": "Brahmi"
        },

        {
          "type": "textarea",
          "id": "ing1_role",
          "label": "Ingredient 1 Role",
          "default": "Selected to support mental quietness during periods of cognitive overstimulation."
        },

        {
          "type": "textarea",
          "id": "ing1_text",
          "label": "Ingredient 1 Description",
          "default": "Traditionally associated in Ayurveda with clarity, steadiness, and calming the mind."
        },

        {
          "type": "url",
          "id": "ing1_link",
          "label": "Ingredient 1 Link"
        },

        {
          "type": "text",
          "id": "ing2",
          "label": "Ingredient 2",
          "default": "Jatamansi"
        },

        {
          "type": "textarea",
          "id": "ing2_role",
          "label": "Ingredient 2 Role",
          "default": "Included to support slower emotional transitions and evening nervous-system quieting."
        },

        {
          "type": "textarea",
          "id": "ing2_text",
          "label": "Ingredient 2 Description",
          "default": "Traditionally used in calming and restorative Ayurvedic formulations."
        },

        {
          "type": "url",
          "id": "ing2_link",
          "label": "Ingredient 2 Link"
        },

        {
          "type": "text",
          "id": "ing3",
          "label": "Ingredient 3",
          "default": "Ashwagandha"
        },

        {
          "type": "textarea",
          "id": "ing3_role",
          "label": "Ingredient 3 Role",
          "default": "Selected to support steadiness during periods of emotional depletion and overstimulation."
        },

        {
          "type": "textarea",
          "id": "ing3_text",
          "label": "Ingredient 3 Description",
          "default": "Associated with adaptogenic support and nervous-system resilience."
        },

        {
          "type": "url",
          "id": "ing3_link",
          "label": "Ingredient 3 Link"
        }

      ]
    }
  ],

  "presets": [
    {
      "name": "Formulation System",
      "blocks": [
        {
          "type": "cluster"
        },
        {
          "type": "cluster"
        },
        {
          "type": "cluster"
        }
      ]
    }
  ]
}
{% endschema %}