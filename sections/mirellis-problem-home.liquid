{{ 'mirellis-problem-home.css' | asset_url | stylesheet_tag }}

<main class="mph" id="mirellis-problem-home-{{ section.id }}">
  <section class="mph-hero" aria-labelledby="mph-home-title">
    <div class="mph-shell mph-hero__grid">
      <div class="mph-hero__copy">
        <p class="mph-kicker">Sleep · Focus · Restoration</p>
        <h1 id="mph-home-title">Can’t sleep, switch off, or focus? Start here.</h1>
        <p class="mph-hero__lead">Mirellis helps you understand what’s happening with your sleep, focus, and restoration — and find the right help.</p>
        <div class="mph-actions">
          <a class="mph-button" data-mirellis-event="homepage_primary_action" data-mirellis-context="hero_directory" href="https://directory.mirellis.in">Find the right specialist</a>
          <a class="mph-button mph-button--quiet" data-mirellis-event="homepage_secondary_action" data-mirellis-context="hero_understand" href="#understand">Understand what’s happening</a>
        </div>
        <p class="mph-hero__note">Clear starting points, credentialed specialists, and a free tool for tonight.</p>
      </div>

      <div class="mph-hero__visual" aria-label="Mirellis helps with sleep, focus and restoration">
        {% if section.settings.hero_image != blank %}
          <div class="mph-hero__image">
            {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '640, 900, 1200, 1600, 1800', sizes: '(min-width: 900px) 46vw, 100vw', alt: section.settings.hero_image.alt }}
          </div>
        {% else %}
          <div class="mph-signal-field" aria-hidden="true">
            <div class="mph-signal-field__halo"></div>
            <p><span>01</span>Sleep</p>
            <p><span>02</span>Focus</p>
            <p><span>03</span>Restoration</p>
            <small>Understand the signal.<br>Choose the next honest step.</small>
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="mph-section mph-concerns" aria-labelledby="mph-concerns-title">
    <div class="mph-shell">
      <div class="mph-section__head">
        <div>
          <p class="mph-kicker">Start with what feels difficult</p>
          <h2 id="mph-concerns-title">You don’t need the right clinical words.</h2>
        </div>
        <p>Choose the experience closest to yours. We’ll help you understand what may be involved and who is qualified to help.</p>
      </div>

      <nav class="mph-concern-grid" aria-label="Explore sleep, focus and restoration concerns">
        <a class="mph-concern-card mph-concern-card--sleep" href="/sleep">
          <span class="mph-concern-card__number" aria-hidden="true">01</span>
          <span class="mph-concern-card__body">
            <span class="mph-concern-card__eyebrow">Sleep</span>
            <strong>I can’t sleep properly.</strong>
            <span>Falling asleep, waking at night, snoring, body-clock problems, or never feeling refreshed.</span>
          </span>
          <span class="mph-concern-card__link">Explore sleep <span aria-hidden="true">→</span></span>
        </a>

        <a class="mph-concern-card mph-concern-card--focus" href="/focus">
          <span class="mph-concern-card__number" aria-hidden="true">02</span>
          <span class="mph-concern-card__body">
            <span class="mph-concern-card__eyebrow">Focus</span>
            <strong>I can’t think or stay with things.</strong>
            <span>Brain fog, distraction, procrastination, forgetfulness, or attention that runs out too quickly.</span>
          </span>
          <span class="mph-concern-card__link">Explore focus <span aria-hidden="true">→</span></span>
        </a>

        <a class="mph-concern-card mph-concern-card--restoration" href="/restoration">
          <span class="mph-concern-card__number" aria-hidden="true">03</span>
          <span class="mph-concern-card__body">
            <span class="mph-concern-card__eyebrow">Restoration</span>
            <strong>I have nothing left.</strong>
            <span>Burnout, overwhelm, feeling wired but tired, low motivation, or being unable to recover.</span>
          </span>
          <span class="mph-concern-card__link">Explore restoration <span aria-hidden="true">→</span></span>
        </a>
      </nav>

      <a class="mph-text-link" href="/what-is-going-on">Not sure where to begin? Help me work it out <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="mph-specialist" aria-labelledby="mph-specialist-title">
    <div class="mph-shell mph-specialist__grid">
      <div class="mph-specialist__copy">
        <p class="mph-kicker">Find the right help</p>
        <h2 id="mph-specialist-title">You should not have to guess who treats this.</h2>
        <p>Mirellis is built specifically around sleep, focus, stress and restoration. See what a specialist works with, how they consult, and their verification status before you decide what to do next.</p>
        <div class="mph-actions">
          <a class="mph-button mph-button--light" data-mirellis-event="directory_opened" data-mirellis-context="homepage_specialist" href="https://directory.mirellis.in">Find a specialist</a>
        </div>
      </div>

      <ol class="mph-specialist__steps" aria-label="How the Mirellis directory helps">
        <li><span>01</span><div><strong>Start with your concern</strong><p>Use familiar words instead of trying to name a diagnosis.</p></div></li>
        <li><span>02</span><div><strong>See who works with it</strong><p>Review disciplines, areas of work, consultation modes and available verification information.</p></div></li>
        <li><span>03</span><div><strong>Choose your next step</strong><p>Contact a suitable specialist directly. Mirellis does not diagnose or choose for you.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="mph-section mph-section--soft" id="understand" aria-labelledby="mph-pathways-title">
    <div class="mph-shell">
      <div class="mph-section__head">
        <div>
          <p class="mph-kicker">Help can begin in different ways</p>
          <h2 id="mph-pathways-title">Need to understand first—or get through tonight?</h2>
        </div>
        <p>Both are valid starting points. Neither replaces professional care when a problem is persistent, worsening, or affecting your safety.</p>
      </div>

      <div class="mph-pathway-grid">
        <article class="mph-pathway-card">
          <div class="mph-pathway-card__topline"><span>Understand</span><span aria-hidden="true">01</span></div>
          <h3>Make sense of what may be happening.</h3>
          <p>Read plain-language concern guides, the Journal and Mirellis Observatory records. Clinical material is separated from observation, with sources and limitations shown.</p>
          <div class="mph-pathway-card__links">
            <a class="mph-text-link" data-mirellis-event="understand_opened" data-mirellis-context="homepage_pathway" href="/pages/understand">Understand what is happening <span aria-hidden="true">→</span></a>
            <a class="mph-text-link mph-text-link--quiet" href="/blogs/journal">Read the Journal</a>
          </div>
        </article>

        <article class="mph-pathway-card mph-pathway-card--app">
          <div class="mph-pathway-card__topline"><span>Tonight</span><span aria-hidden="true">02</span></div>
          <h3>Close the workday with one guided practice.</h3>
          <p>After Work is a free Mirellis tool for the moment work has ended but your mind has not. It gives you a short, structured action—not another article to remember.</p>
          <div class="mph-pathway-card__links">
            <a class="mph-text-link" data-mirellis-event="app_opened" data-mirellis-context="homepage_pathway" href="https://app.mirellis.in">Open After Work <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="mph-section mph-principles" aria-labelledby="mph-principles-title">
    <div class="mph-shell mph-principles__grid">
      <div>
        <p class="mph-kicker">A clearer route, not another promise</p>
        <h2 id="mph-principles-title">Serious enough for the problem. Human enough for the person.</h2>
      </div>
      <div class="mph-principles__body">
        <p>Mirellis does not diagnose you, replace medical care, or sell a product as the answer to a health concern. We help you recognise the problem, understand the available routes, and reach appropriately qualified help.</p>
        <a class="mph-text-link" href="/pages/about">Why Mirellis exists <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="mph-closing" aria-labelledby="mph-closing-title">
    <div class="mph-shell mph-closing__inner">
      <p class="mph-kicker">Start where you are</p>
      <h2 id="mph-closing-title">You don’t have to translate the problem before asking for help.</h2>
      <div class="mph-actions mph-actions--center">
        <a class="mph-button" data-mirellis-event="directory_opened" data-mirellis-context="homepage_close" href="https://directory.mirellis.in">Find the right specialist</a>
        <a class="mph-button mph-button--quiet" href="/what-is-going-on">Help me work it out</a>
      </div>
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Problem-first homepage",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Original hero photograph"
    }
  ],
  "presets": [
    {
      "name": "Problem-first homepage"
    }
  ]
}
{% endschema %}
