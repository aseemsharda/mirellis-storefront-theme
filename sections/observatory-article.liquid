{%- comment -%}
  MIRELLIS — OBSERVATORY ARTICLE
  Custom reading experience for /blogs/observatory/<article>
  Companion styles: assets/observatory.css (appended)
{%- endcomment -%}

{{ 'observatory.css' | asset_url | stylesheet_tag }}

{%- comment -%} ── TAG MAPPING ─────────────────────────────── {%- endcomment -%}
{%- assign transition_map = 'sleep-to-wakefulness|Sleep → Wakefulness,work-to-recovery|Work → Recovery,stimulation-to-restoration|Stimulation → Restoration' | split: ',' -%}
{%- assign transition_tag_raw = '' -%}
{%- assign transition_tag_label = '' -%}
{%- for entry in transition_map -%}
  {%- assign parts = entry | split: '|' -%}
  {%- assign slug = parts[0] -%}
  {%- assign label = parts[1] -%}
  {%- if article.tags contains slug -%}
    {%- assign transition_tag_raw = slug -%}
    {%- assign transition_tag_label = label -%}
  {%- endif -%}
{%- endfor -%}

{%- assign word_count = article.content | strip_html | split: ' ' | size -%}
{%- assign reading_minutes = word_count | divided_by: 200 | at_least: 1 | at_most: 30 -%}


<article class="obs-article">

  {%- comment -%} ══ ARTICLE HEADER ══════════════════════════ {%- endcomment -%}

  <header class="obs-article__header">
    <div class="obs-article__header-inner ml-container-narrow">

      {%- if transition_tag_label != blank -%}
        <a
          href="{{ blog.url }}/tagged/{{ transition_tag_raw }}"
          class="obs-article__transition obs-eyebrow ml-supporting-text"
        >
          {{- transition_tag_label -}}
        </a>
      {%- endif -%}

      <h1 class="obs-article__title ml-display-heading ml-headline-soft">
        {{- article.title -}}
      </h1>

      <p class="obs-article__meta ml-supporting-text ml-copy-soft">
        {{- reading_minutes -}} min read
      </p>

    </div>
  </header>


  {%- comment -%} ══ ARTICLE BODY ════════════════════════════ {%- endcomment -%}

  <div class="obs-article__body">
    <div class="obs-article__body-inner ml-container-narrow">

      {%- for block in section.blocks -%}
        {%- if block.type == 'pull_quote' and block.settings.position == 'before_body' -%}
          <blockquote class="obs-pull-quote ml-atmospheric-quote" {{ block.shopify_attributes }}>
            {{- block.settings.quote -}}
          </blockquote>
        {%- endif -%}
      {%- endfor -%}

      <div class="obs-article__content rte ml-reading-flow">
        {{- article.content -}}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'pull_quote' and block.settings.position == 'after_body' -%}
          <blockquote class="obs-pull-quote ml-atmospheric-quote" {{ block.shopify_attributes }}>
            {{- block.settings.quote -}}
          </blockquote>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>


  {%- comment -%} ══ ARTICLE FOOTER ══════════════════════════ {%- endcomment -%}

  <footer class="obs-article__footer">
    <div class="obs-article__footer-inner ml-container-narrow">

      <div class="obs-footer-divider"></div>


      {%- comment -%} 1. FILED UNDER ─────────────────────────── {%- endcomment -%}

      {%- if transition_tag_label != blank -%}
        <p class="obs-filed ml-supporting-text ml-copy-soft">
          Filed under:
          <a
            href="{{ blog.url }}/tagged/{{ transition_tag_raw }}"
            class="obs-filed__link"
          >
            {{- transition_tag_label -}}
          </a>
          <span class="obs-meta-dot" aria-hidden="true">·</span>
          <span>{{- article.published_at | date: '%B %d, %Y' -}}</span>
        </p>
      {%- endif -%}


      {%- comment -%} 2. RELATED ARTICLES ─────────────────────── {%- endcomment -%}

      {%- assign r1 = section.settings.related_article_1 -%}
      {%- assign r2 = section.settings.related_article_2 -%}
      {%- if r1 != blank or r2 != blank -%}

        <div class="obs-related">

          {%- if section.settings.related_heading != blank -%}
            <p class="obs-eyebrow ml-supporting-text">
              {{- section.settings.related_heading -}}
            </p>
          {%- endif -%}

          <div class="obs-related__grid">

            {%- for i in (1..2) -%}
              {%- if i == 1 -%}{%- assign rel = r1 -%}{%- else -%}{%- assign rel = r2 -%}{%- endif -%}

              {%- if rel != blank -%}
                {%- assign rel_words = rel.content | strip_html | split: ' ' | size -%}
                {%- assign rel_minutes = rel_words | divided_by: 200 | at_least: 1 | at_most: 30 -%}
                {%- assign rel_transition = '' -%}
                {%- for entry in transition_map -%}
                  {%- assign parts = entry | split: '|' -%}
                  {%- if rel.tags contains parts[0] -%}
                    {%- assign rel_transition = parts[1] -%}
                  {%- endif -%}
                {%- endfor -%}

                <a href="{{ rel.url }}" class="obs-related-card ml-soft-hover">
                  {%- if rel_transition != blank -%}
                    <p class="obs-related-card__tag ml-supporting-text">
                      {{- rel_transition -}}
                    </p>
                  {%- endif -%}
                  <h3 class="obs-related-card__title">{{- rel.title -}}</h3>
                  <p class="obs-related-card__meta ml-supporting-text ml-copy-soft">
                    {{- rel_minutes -}} min read
                  </p>
                </a>

              {%- endif -%}
            {%- endfor -%}

          </div>
        </div>

      {%- endif -%}


      {%- comment -%} 3. PRODUCT CARD ─────────────────────────── {%- endcomment -%}

      {%- assign linked_product = section.settings.linked_product -%}
      {%- if linked_product != blank -%}

        <div class="obs-product-card">

          {%- if transition_tag_label != blank -%}
            <p class="obs-product-card__transition obs-eyebrow ml-supporting-text">
              {{- transition_tag_label -}}
            </p>
          {%- endif -%}

          <p class="obs-product-card__title">
            {{- linked_product.title -}}
          </p>

          {%- assign founding_line = linked_product.metafields.custom.founding_line -%}
          {%- if founding_line != blank -%}
            <p class="obs-product-card__founding ml-body-copy ml-copy-soft">
              {{- founding_line -}}
            </p>
          {%- endif -%}

          <a
            href="{{ linked_product.url }}"
            class="obs-product-card__link ml-soft-cta ml-soft-hover"
          >
            {{- section.settings.product_cta | default: 'Explore the ritual →' -}}
          </a>

        </div>

      {%- endif -%}


      {%- comment -%} 4. SUBSCRIBE ───────────────────────────── {%- endcomment -%}

      <div class="obs-article-subscribe">

        {%- if section.settings.subscribe_eyebrow != blank -%}
          <p class="obs-eyebrow ml-supporting-text">
            {{- section.settings.subscribe_eyebrow -}}
          </p>
        {%- endif -%}

        {%- if section.settings.subscribe_line != blank -%}
          <p class="obs-article-subscribe__line ml-body-copy ml-copy-soft">
            {{- section.settings.subscribe_line -}}
          </p>
        {%- endif -%}

        {%- form 'customer', id: 'obs-article-subscribe-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,observatory-subscriber">
          <div class="obs-subscribe__form">
            <label for="obs-article-email" class="sr-only">Your email address</label>
            <input
              id="obs-article-email"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.email_placeholder | default: 'Your email address' }}"
              class="obs-subscribe__input"
              required
              autocomplete="email"
            >
            <button type="submit" class="obs-subscribe__button ml-soft-cta">
              {{- section.settings.subscribe_cta | default: 'Follow the Observatory' -}}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="obs-subscribe__success ml-supporting-text ml-copy-soft">
              {{- section.settings.success_message | default: 'You are now following the Observatory.' -}}
            </p>
          {%- endif -%}
          {{- form.errors | default_errors -}}
        {%- endform -%}

      </div>


    </div>
  </footer>

</article>


{% schema %}
{
  "name": "Observatory Article",
  "settings": [
    {
      "type": "header",
      "content": "Related Articles"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Related heading",
      "default": "CONTINUE READING"
    },
    {
      "type": "article",
      "id": "related_article_1",
      "label": "Related article 1"
    },
    {
      "type": "article",
      "id": "related_article_2",
      "label": "Related article 2"
    },
    {
      "type": "header",
      "content": "Product Card"
    },
    {
      "type": "product",
      "id": "linked_product",
      "label": "Linked product"
    },
    {
      "type": "text",
      "id": "product_cta",
      "label": "Product CTA label",
      "default": "Explore the ritual →"
    },
    {
      "type": "header",
      "content": "Subscribe"
    },
    {
      "type": "text",
      "id": "subscribe_eyebrow",
      "label": "Subscribe eyebrow",
      "default": "FOLLOW THE RESEARCH"
    },
    {
      "type": "text",
      "id": "subscribe_line",
      "label": "Subscribe line",
      "default": "New research published slowly. One piece at a time."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "subscribe_cta",
      "label": "Button label",
      "default": "Follow the Observatory"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You are now following the Observatory."
    }
  ],
  "blocks": [
    {
      "type": "pull_quote",
      "name": "Pull Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote text"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "before_body", "label": "Before article body" },
            { "value": "after_body",  "label": "After article body"  }
          ],
          "default": "after_body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Observatory Article"
    }
  ]
}
{% endschema %}
