{% stylesheet %}
[data-mc-reveal]{opacity:0;transform:translateY(18px);transition:opacity 0.85s cubic-bezier(.2,.7,.2,1),transform 0.85s cubic-bezier(.2,.7,.2,1)}
[data-mc-reveal].mc-on{opacity:1;transform:none}
@media(max-width:900px){.mc-hiw-grid{grid-template-columns:1fr!important}.mc-hiw-img{display:none!important}}
{% endstylesheet %}

<section style="background:{{ section.settings.bg_color }}">
  <div style="max-width:1180px;margin:0 auto;padding:104px 32px;display:grid;grid-template-columns:0.92fr 1.08fr;gap:68px;align-items:center" class="mc-hiw-grid">
    <div data-mc-reveal class="mc-hiw-img" style="border-radius:6px;overflow:hidden;background:#ede5da;aspect-ratio:4/5">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1122 }}" alt="{{ section.settings.heading }}" width="1122" height="1403" style="width:100%;height:100%;object-fit:cover">
      {% elsif section.settings.fallback_url != blank %}
        <img src="{{ section.settings.fallback_url }}" alt="{{ section.settings.heading }}" width="1122" height="1403" style="width:100%;height:100%;object-fit:cover">
      {% endif %}
    </div>
    <div>
      <p data-mc-reveal style="margin:0 0 24px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:#bb7a33">{{ section.settings.eyebrow }}</p>
      <h2 data-mc-reveal style="margin:0;font-weight:400;font-size:42px;line-height:1.14;letter-spacing:-0.015em;color:#1f1c17">{{ section.settings.heading }}</h2>
      <p data-mc-reveal style="margin:28px 0 0;font-size:18.5px;line-height:1.64;color:#48433a;max-width:52ch">{{ section.settings.body_1 }}</p>
      <p data-mc-reveal style="margin:18px 0 0;font-size:18.5px;line-height:1.64;color:#5b5346;max-width:52ch">{{ section.settings.body_2 }}</p>
      <blockquote data-mc-reveal style="margin:34px 0 0;padding:24px 26px;border-left:2px solid #bb7a33;background:#f1ebe1;border-radius:0 5px 5px 0">
        <p style="margin:0;font-size:22px;line-height:1.4;font-style:italic;color:#1f1c17">{{ section.settings.quote }}</p>
      </blockquote>
      {% assign hiw_tags = section.blocks | where: 'type', 'tag' %}
      {% if hiw_tags.size > 0 %}
      <div data-mc-reveal style="display:flex;flex-wrap:wrap;gap:10px;margin-top:28px">
        {% for block in section.blocks %}
          {% if block.type == 'tag' %}
            <span {{ block.shopify_attributes }} style="font-family:'Mulish',sans-serif;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:#5b5346;border:1px solid #ddd3c6;border-radius:100px;padding:8px 14px">{{ block.settings.label }}</span>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function(){if(!window.mcBaseInit){window.mcBaseInit=true;document.addEventListener('DOMContentLoaded',function(){var io=null;if('IntersectionObserver' in window){io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('mc-on');io.unobserve(e.target);}});},{threshold:0.12});}document.querySelectorAll('[data-mc-reveal]').forEach(function(el){if(io){io.observe(el);}else{el.classList.add('mc-on');}});});}})();
</script>

{% schema %}
{
  "name": "MC — How It Works",
  "settings": [
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#faf7f4"},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "fallback_url", "label": "Fallback image URL", "default": "https://mirellis.in/cdn/shop/files/what_makes_it_work_oil_pulling.png?v=1779107904"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it works"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "What makes it work"},
    {"type": "textarea", "id": "body_1", "label": "Body paragraph 1", "default": "Oil pulling supports the body at one of its most sensitive transition points. A traditional Ayurvedic practice, it is used to support oral hygiene, stimulate digestion, and bring clarity to the mind — the slow, mindful swishing engages the senses and signals the body to wake gently and coherently."},
    {"type": "textarea", "id": "body_2", "label": "Body paragraph 2", "default": "The formulation is designed to feel grounding, not aggressive — allowing clarity to emerge through consistency rather than intensity. This ritual doesn't rush the body into action. It prepares it."},
    {"type": "text", "id": "quote", "label": "Pull quote", "default": "This is not a cleanse. It is a beginning."}
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Benefit tag",
      "settings": [
        {"type": "text", "id": "label", "label": "Tag label"}
      ]
    }
  ],
  "presets": [{"name": "MC — How It Works"}]
}
{% endschema %}