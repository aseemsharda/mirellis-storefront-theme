</section>

<style>
  .transition-research {
    padding: 4rem 2rem;
    background: #fff;
  }

  .transition-research__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .transition-research__title {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 400;
    color: #1a1a18;
    margin-bottom: 2rem;
  }

  .transition-research__category {
    margin-bottom: 3rem;
  }

  .transition-research__category-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a18;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(26, 26, 24, 0.1);
  }

  .transition-research__article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .transition-article-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: #faf7f2;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .transition-article-card:hover {
    background: #f5f2ed;
  }

  .transition-article-card__title {
    margin: 0 0 0.75rem 0;
  }

  .transition-article-card__title a {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    color: #1a1a18;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .transition-article-card__title a:hover {
    color: #666;
  }

  .transition-article-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #666;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .transition-article-card__meta {
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 1rem;
  }

  .transition-article-card__link {
    color: #1a1a18;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .transition-article-card__link:hover {
    color: #666;
  }

  @media (max-width: 768px) {
    .transition-research {
      padding: 3rem 1.5rem;
    }

    .transition-research__title {
      font-size: 1.5rem;
    }

    .transition-research__article-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
</style>

