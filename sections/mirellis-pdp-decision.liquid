{%- comment -%}
  MIRELLIS — PDP DECISION  ("Begin the morning ritual" · the real buy block · reusable)
  Book I: Journey 7 (Purchase) · resolves convenience + security · Dim A.
  The purchase is the natural conclusion of understanding. Real product form (price + add to cart),
  variant-aware, empty-safe (falls back to a CTA link off a product template). Anchor #pdp-buy for hero CTA.
  All surrounding copy is settings.
{%- endcomment -%}

{%- assign s = section.settings -%}
<section class="pddc" id="pdp-buy" data-mirellis-view-event="product_decision_view" data-mirellis-context="{{ product.handle | default: 'product' }}">
  <div class="pddc__inner">
    {%- if s.heading != blank -%}<h2 class="pddc__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.sub != blank -%}<p class="pddc__sub">{{ s.sub }}</p>{%- endif -%}

    <div class="pddc__facts" aria-label="Product decision information">
      {%- if s.what_it_is != blank -%}<div><span>What it is</span><p>{{ s.what_it_is }}</p></div>{%- endif -%}
      {%- if s.who_for != blank -%}<div><span>It may suit</span><p>{{ s.who_for }}</p></div>{%- endif -%}
      {%- if s.not_for != blank -%}<div><span>What it is not</span><p>{{ s.not_for }}</p></div>{%- endif -%}
      {%- if s.safety != blank -%}<div><span>Use safely</span><p>{{ s.safety }}</p></div>{%- endif -%}
    </div>

    {%- if product != blank -%}
      {%- assign cv = product.selected_or_first_available_variant -%}
      <div class="pddc__buy">
        <div class="pddc__price">{{ cv.price | money }}{%- if cv.compare_at_price > cv.price -%}<span class="pddc__was">{{ cv.compare_at_price | money }}</span>{%- endif -%}</div>
        {%- form 'product', product, class: 'pddc__form' -%}
          {%- if product.variants.size > 1 -%}
            <label class="pddc__vlabel" for="pddc-variant">{{ s.variant_label | default: 'Option' }}</label>
            <select id="pddc-variant" name="id" class="pddc__variant">
              {%- for v in product.variants -%}
                <option value="{{ v.id }}" {% if v == cv %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }} — {{ v.price | money }}</option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" name="id" value="{{ cv.id }}">
          {%- endif -%}
          <button type="submit" name="add" class="pddc__add" data-mirellis-event="product_add_to_cart" data-mirellis-context="{{ product.handle }}" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ s.cta_label | default: 'Add to cart' }}{%- else -%}{{ s.sold_out | default: 'Sold out' }}{%- endif -%}
          </button>
        {%- endform -%}
      </div>
    {%- elsif s.fallback_label != blank and s.fallback_url != blank -%}
      <div class="pddc__buy"><a class="pddc__add pddc__add--link" href="{{ s.fallback_url }}">{{ s.fallback_label }}</a></div>
    {%- endif -%}

    {%- if s.reassurance != blank -%}<p class="pddc__reassure">{{ s.reassurance }}</p>{%- endif -%}
    {%- if s.next != blank -%}<p class="pddc__next">{{ s.next }}</p>{%- endif -%}
  </div>
</section>

<style>
  .pddc { background: var(--ml-color-warm-paper); padding-block: clamp(4rem, 9vw, 7rem); border-top: 1px solid var(--ml-color-border-soft); scroll-margin-top: 2rem; }
  .pddc__inner { max-width: 680px; margin-inline: auto; padding-inline: clamp(1rem, 5vw, 2rem); text-align: center; }
  .pddc__heading { font-size: clamp(1.9rem, 4.5vw, 2.7rem); font-weight: 300; line-height: 1.15; color: var(--ml-color-soft-charcoal); margin: 0 0 1rem; }
  .pddc__sub { font-size: 1.05rem; line-height: 1.7; color: var(--ml-color-text-secondary); max-width: 46ch; margin: 0 auto 2.25rem; }
  .pddc__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 0 0 2.5rem; border: 1px solid var(--ml-color-border-soft); background: var(--ml-color-border-soft); text-align: left; }
  .pddc__facts > div { min-height: 9rem; background: var(--ml-color-warm-paper); padding: 1.2rem; }
  .pddc__facts span { display: block; margin-bottom: .55rem; color: var(--ml-color-muted-earth); font-size: .68rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .pddc__facts p { margin: 0; color: var(--ml-color-text-secondary); font-size: .9rem; line-height: 1.55; }
  .pddc__buy { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .pddc__price { font-size: 1.4rem; font-weight: 300; color: var(--ml-color-soft-charcoal); }
  .pddc__was { margin-left: 0.6rem; font-size: 1rem; color: var(--ml-color-muted-earth); text-decoration: line-through; }
  .pddc__form { display: flex; flex-direction: column; align-items: center; gap: 0.9rem; width: 100%; max-width: 22rem; }
  .pddc__vlabel { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ml-color-muted-earth); font-weight: 600; }
  .pddc__variant { width: 100%; padding: 0.7rem 0.9rem; border: 1px solid var(--ml-color-border-soft); border-radius: 2px; background: var(--ml-color-warm-paper); color: var(--ml-color-soft-charcoal); font-size: 0.95rem; }
  .pddc__add { display: inline-block; width: 100%; padding: 1rem 2rem; border: 1px solid var(--ml-color-soft-charcoal); border-radius: 999px; background: var(--ml-color-soft-charcoal); color: var(--ml-color-warm-paper); font-size: 0.82rem; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: opacity var(--ml-motion-fast, 200ms) ease; }
  .pddc__add:hover { opacity: 0.88; }
  .pddc__add[disabled] { opacity: 0.4; cursor: not-allowed; }
  .pddc__add--link { text-decoration: none; text-align: center; }
  .pddc__reassure { margin-top: 1.75rem; font-size: 0.85rem; letter-spacing: 0.02em; color: var(--ml-color-muted-earth); }
  .pddc__next { margin-top: 0.6rem; font-size: 0.9rem; color: var(--ml-color-text-secondary); }
  @media (max-width: 640px) { .pddc__facts { grid-template-columns: 1fr; } .pddc__facts > div { min-height: 0; } }
</style>

{% schema %}
{
  "name": "PDP · Decision",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Begin the morning ritual." },
    { "type": "inline_richtext", "id": "sub", "label": "Sub (optional)" },
    { "type": "textarea", "id": "what_it_is", "label": "What it is" },
    { "type": "textarea", "id": "who_for", "label": "It may suit" },
    { "type": "textarea", "id": "not_for", "label": "What it is not" },
    { "type": "textarea", "id": "safety", "label": "Safety summary" },
    { "type": "text", "id": "variant_label", "label": "Variant picker label", "default": "Option" },
    { "type": "text", "id": "cta_label", "label": "Add-to-cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out", "label": "Sold-out label", "default": "Sold out" },
    { "type": "textarea", "id": "reassurance", "label": "Reassurance line", "default": "⟦Shipping timeframe⟧ · ⟦returns policy⟧ · secure checkout." },
    { "type": "textarea", "id": "next", "label": "What happens next", "default": "What happens next: your ritual guide arrives with the order." },
    { "type": "header", "content": "Fallback (non-product templates)" },
    { "type": "text", "id": "fallback_label", "label": "Fallback CTA label" },
    { "type": "url", "id": "fallback_url", "label": "Fallback CTA url" }
  ],
  "presets": [{ "name": "PDP · Decision" }]
}
{% endschema %}
