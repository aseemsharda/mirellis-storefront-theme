{% comment %}
MIRELLIS — SCENE 02
RECOGNITION FIELD
Psychological Mirror Layer
{% endcomment %}

<section class="mirellis-recognition">

  <!-- BACKGROUND LAYER -->
  <div class="mirellis-recognition-media">

    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: class: 'mirellis-recognition-image'
      }}
    {% endif %}

  </div>

  <!-- ATMOSPHERIC OVERLAY -->
  <div class="mirellis-recognition-overlay"></div>

  <!-- CONTENT -->
  <div class="mirellis-recognition-content">

    {% if section.settings.heading != blank %}
      <h2 class="mirellis-recognition-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="mirellis-recognition-subtext">
        {{ section.settings.subtext }}
      </p>
    {% endif %}

    {% if section.settings.thought != blank %}
      <div class="mirellis-recognition-thought">
        {{ section.settings.thought }}
      </div>
    {% endif %}

  </div>

</section>

<style>

/* =========================
   SCENE 02 — RECOGNITION
========================= */

.mirellis-recognition {
  position: relative;
  min-height: 100vh;
  width: 100%;
  background: #f6f1ea;
  overflow: hidden;
}

/* IMAGE */
.mirellis-recognition-media {
  position: absolute;
  inset: 0;
}

.mirellis-recognition-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(0.92) saturate(0.9);
}

/* OVERLAY — softer than hero */
.mirellis-recognition-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(246,241,232,0.65) 0%,
    rgba(246,241,232,0.85) 60%,
    rgba(246,241,232,0.95) 100%
  );
}

/* CONTENT */
.mirellis-recognition-content {
  position: relative;
  z-index: 2;
  max-width: 820px;
  margin: 0 auto;
  padding: 140px 24px;
  text-align: center;
}

/* HEADLINE */
.mirellis-recognition-heading {
  font-size: clamp(26px, 3.2vw, 52px);
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: -0.02em;
  color: #1c1c1c;
  margin-bottom: 22px;
}

/* SUBTEXT */
.mirellis-recognition-subtext {
  font-size: 16px;
  line-height: 1.7;
  color: rgba(28,28,28,0.72);
  max-width: 620px;
  margin: 0 auto 36px auto;
}

/* CORE RECOGNITION STATEMENT */
.mirellis-recognition-thought {
  font-size: 17px;
  line-height: 1.8;
  color: rgba(28,28,28,0.85);
  max-width: 560px;
  margin: 0 auto;

  padding-top: 28px;
  border-top: 1px solid rgba(0,0,0,0.08);

  font-style: italic;
}

/* MOBILE */
@media screen and (max-width: 768px) {
  .mirellis-recognition-content {
    padding: 100px 20px;
  }

  .mirellis-recognition-heading {
    font-size: 28px;
  }

  .mirellis-recognition-subtext {
    font-size: 15px;
  }
}

</style>

{% schema %}
{
  "name": "Mirellis Scene 02",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modern life rarely gives the nervous system a clear ending."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Not stress. Not burnout. Something quieter and more continuous."
    },
    {
      "type": "textarea",
      "id": "thought",
      "label": "Core Recognition Thought",
      "default": "Light, sound, movement, and attention now continue long after the body was meant to slow."
    }
  ],
  "presets": [
    {
      "name": "Mirellis Scene 02"
    }
  ]
}
{% endschema %}