<section class="homepage-ritual-territories">

  <div class="page-width">

    <div class="homepage-ritual-territories__inner">

      {% if section.settings.label != blank %}

        <p class="homepage-ritual-territories__label">
          {{ section.settings.label }}
        </p>

      {% endif %}

      {% if section.settings.heading != blank %}

        <h2 class="homepage-ritual-territories__heading">
          {{ section.settings.heading }}
        </h2>

      {% endif %}

      <div class="homepage-ritual-territories__grid">

        {% for block in section.blocks %}

          <a href="{{ block.settings.link }}" class="homepage-ritual-territories__item">

            <div class="homepage-ritual-territories__content">

              <p class="homepage-ritual-territories__item-label">
                {{ block.settings.label }}
              </p>

              <h3 class="homepage-ritual-territories__title">
                {{ block.settings.title }}
              </h3>

              <div class="homepage-ritual-territories__description">
                {{ block.settings.description }}
              </div>

            </div>

          </a>

        {% endfor %}

      </div>

    </div>

  </div>

</section>

<style>

.homepage-ritual-territories {
  padding: 140px 0;
  background: #f7f3ee;
}

.homepage-ritual-territories__inner {
  max-width: 1200px;
  margin: 0 auto;
}

.homepage-ritual-territories__label {
  margin-bottom: 26px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: #8b8378;
}

.homepage-ritual-territories__heading {
  max-width: 760px;
  margin: 0 0 60px;

  font-size: 42px;
  line-height: 1.35;
  font-weight: 300;

  color: #202020;
}

.homepage-ritual-territories__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}

.homepage-ritual-territories__item {
  display: block;

  min-height: 420px;
  padding: 42px;

  background: #fcfaf7;

  text-decoration: none;

  transition:
    transform 0.35s ease,
    background 0.35s ease;
}

.homepage-ritual-territories__item:hover {
  transform: translateY(-3px);
  background: #ffffff;
}

.homepage-ritual-territories__content {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.homepage-ritual-territories__item-label {
  margin: 0 0 22px;

  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;

  color: #8b8378;
}

.homepage-ritual-territories__title {
  margin: 0 0 24px;

  font-size: 34px;
  line-height: 1.3;
  font-weight: 300;

  color: #1f1f1f;
}

.homepage-ritual-territories__description {
  font-size: 17px;
  line-height: 1.95;

  color: #5b5550;
}

@media screen and (max-width: 990px) {

  .homepage-ritual-territories {
    padding: 110px 24px;
  }

  .homepage-ritual-territories__grid {
    grid-template-columns: 1fr;
  }

  .homepage-ritual-territories__item {
    min-height: auto;
  }

}

@media screen and (max-width: 749px) {

  .homepage-ritual-territories {
    padding: 80px 24px;
  }

  .homepage-ritual-territories__label {
    margin-bottom: 22px;
  }

  .homepage-ritual-territories__heading {
    margin-bottom: 42px;
    font-size: 30px;
    line-height: 1.4;
  }

  .homepage-ritual-territories__grid {
    gap: 20px;
  }

  .homepage-ritual-territories__item {
    padding: 34px 28px;
  }

  .homepage-ritual-territories__item-label {
    margin-bottom: 18px;
  }

  .homepage-ritual-territories__title {
    font-size: 26px;
    margin-bottom: 20px;
  }

  .homepage-ritual-territories__description {
    font-size: 16px;
    line-height: 1.9;
  }

}

</style>

{% schema %}
{
  "name": "Ritual Territories",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Ritual Territories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Different emotional environments require different ritual architectures."
    }
  ],
  "blocks": [
    {
      "type": "territory",
      "name": "Territory",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Territory"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual Territories"
    }
  ]
}
{% endschema %}