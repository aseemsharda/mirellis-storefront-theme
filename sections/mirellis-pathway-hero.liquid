{% stylesheet %}
.mirellis-hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #0f0d0c;
}

.mirellis-hero__media {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.mirellis-hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mirellis-hero__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(7,7,7,0.72) 0%,
      rgba(7,7,7,0.48) 38%,
      rgba(7,7,7,0.28) 100%
    );
}

.mirellis-hero__inner {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1320px;
  margin: 0 auto;
  padding: 7rem 2rem;
}

.mirellis-hero__content {
  max-width: 720px;
}

.mirellis-hero__label {
  font-size: 11px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.56);
  margin-bottom: 1.4rem;
}

.mirellis-hero__heading {
  font-family: var(--font-heading-family);
  font-size: clamp(3.2rem, 7vw, 6.4rem);
  line-height: 0.98;
  letter-spacing: -0.05em;
  color: #f5f1ea;
  margin: 0 0 2rem;
  font-weight: 500;
}

.mirellis-hero__text {
  max-width: 620px;
  font-size: 1.08rem;
  line-height: 1.95;
  color: rgba(255,255,255,0.74);
  margin-bottom: 2.6rem;
}

.mirellis-hero__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 1.8rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.08);
  color: #f5f1ea;
  text-decoration: none;
  font-size: 0.95rem;
  transition:
    background 0.3s ease,
    transform 0.3s ease;
}

.mirellis-hero__button:hover {
  background: rgba(255,255,255,0.14);
  transform: translateY(-2px);
}

.mirellis-hero__mobile-image {
  display: none;
}

@media screen and (max-width: 749px) {

  .mirellis-hero {
    min-height: 88vh;
    align-items: flex-end;
  }

  .mirellis-hero__media--desktop {
    display: none;
  }

  .mirellis-hero__mobile-image {
    display: block;
  }

  .mirellis-hero__inner {
    padding: 5rem 1.4rem 3rem;
  }

  .mirellis-hero__heading {
    font-size: clamp(2.5rem, 13vw, 4.4rem);
    line-height: 0.98;
  }

  .mirellis-hero__text {
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .mirellis-hero__overlay {
    background:
      linear-gradient(
        180deg,
        rgba(7,7,7,0.28) 0%,
        rgba(7,7,7,0.82) 100%
      );
  }
}
{% endstylesheet %}

<section class="mirellis-hero">

  <div class="mirellis-hero__media mirellis-hero__media--desktop">

    {% if section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2400
        | image_tag: loading: 'eager'
      }}
    {% endif %}

    <div class="mirellis-hero__overlay"></div>

  </div>

  <div class="mirellis-hero__media mirellis-hero__mobile-image">

    {% if section.settings.mobile_image != blank %}
      {{
        section.settings.mobile_image
        | image_url: width: 1200
        | image_tag: loading: 'eager'
      }}
    {% endif %}

    <div class="mirellis-hero__overlay"></div>

  </div>

  <div class="mirellis-hero__inner">

    <div class="mirellis-hero__content">

      <div class="mirellis-hero__label">
        {{ section.settings.label }}
      </div>

      <h1 class="mirellis-hero__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="mirellis-hero__text">
        {{ section.settings.text }}
      </div>

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="mirellis-hero__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Mirellis Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "MODERN HUMAN RHYTHMS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The nervous system remembers what life repeatedly feels like."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting Text",
      "default": "<p>Mirellis explores rituals, environments, and sensory experiences that support how humans move through modern life.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Begin Exploring"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Mirellis Hero"
    }
  ]
}
{% endschema %}