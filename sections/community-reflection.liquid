<section class="community-reflection">

  <div class="community-reflection-inner">

    <!-- SECTION HEADER -->

    <div class="community-reflection-header">

      <div class="community-section-label">
        TODAY’S REFLECTION
      </div>

      <h2 class="community-reflection-heading">
        What helps your evenings stop feeling
        like extensions of work?
      </h2>

      <button class="community-reflection-button">
        Add Reflection
      </button>

    </div>

    <!-- REFLECTION GRID -->

    <div class="community-reflection-grid">

      <!-- CARD 1 -->

      <div class="reflection-card">
        <div class="reflection-card-text">
          “Warm lighting changes everything for me.
          My body relaxes before my mind does.”
        </div>

        <div class="reflection-card-meta">
          — Evening Rituals
        </div>
      </div>

      <!-- CARD 2 -->

      <div class="reflection-card">
        <div class="reflection-card-text">
          “Music helps me feel like the day is
          finally slowing down.”
        </div>

        <div class="reflection-card-meta">
          — Sound & Atmosphere
        </div>
      </div>

      <!-- CARD 3 -->

      <div class="reflection-card">
        <div class="reflection-card-text">
          “Tea before bed became the signal
          that the day was ending.”
        </div>

        <div class="reflection-card-meta">
          — Evening Reflections
        </div>
      </div>

      <!-- CARD 4 -->

      <div class="reflection-card">
        <div class="reflection-card-text">
          “Sleep started improving when evenings
          stopped feeling like extensions
          of the internet.”
        </div>

        <div class="reflection-card-meta">
          — Community Reflection
        </div>
      </div>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Community Reflection",
  "settings": [],
  "presets": [
    {
      "name": "Community Reflection"
    }
  ]
}
{% endschema %}