{% stylesheet %}
[data-mc-reveal]{opacity:0;transform:translateY(18px);transition:opacity 0.85s cubic-bezier(.2,.7,.2,1),transform 0.85s cubic-bezier(.2,.7,.2,1)}
[data-mc-reveal].mc-on{opacity:1;transform:none}
.mc-comp-btn:hover{background:#fff!important}
@media(max-width:900px){.mc-comp-grid{grid-template-columns:1fr!important}}
{% endstylesheet %}

<section style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }}">
  <div style="max-width:1180px;margin:0 auto;padding:104px 32px;display:grid;grid-template-columns:1.1fr 0.9fr;gap:64px;align-items:center" class="mc-comp-grid">
    <div>
      <p data-mc-reveal style="margin:0 0 26px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:{{ section.settings.eyebrow_color }}">{{ section.settings.eyebrow }}</p>
      <h2 data-mc-reveal style="margin:0;font-weight:300;font-size:42px;line-height:1.16;letter-spacing:-0.01em;max-width:18ch">{{ section.settings.heading }}</h2>
      <p data-mc-reveal style="margin:28px 0 0;font-size:18.5px;line-height:1.62;color:{{ section.settings.body_color }};max-width:48ch">{{ section.settings.body }}</p>
      <div data-mc-reveal style="display:flex;align-items:center;gap:18px;margin-top:38px">
        <a href="{{ section.settings.cta_url }}" class="mc-comp-btn" style="display:inline-flex;align-items:center;gap:10px;height:52px;padding:0 26px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};border-radius:3px;font-family:'Mulish',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;transition:background .3s;text-decoration:none">{{ section.settings.cta_text }}</a>
        <span style="font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:{{ section.settings.cta_note_color }}">{{ section.settings.cta_note }}</span>
      </div>
    </div>
    <div data-mc-reveal style="position:relative;border-radius:6px;overflow:hidden;background:{{ section.settings.img_bg_color }};aspect-ratio:4/5">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1080 }}" alt="{{ section.settings.heading }}" width="1080" height="1350" style="width:100%;height:100%;object-fit:cover;filter:saturate(0.85) brightness(0.92)">
      {% elsif section.settings.fallback_url != blank %}
        <img src="{{ section.settings.fallback_url }}" alt="{{ section.settings.heading }}" width="1080" height="1350" style="width:100%;height:100%;object-fit:cover;filter:saturate(0.85) brightness(0.92)">
      {% endif %}
      {% if section.settings.badge_text != blank %}
        <div style="position:absolute;left:18px;bottom:18px;font-family:'Mulish',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:{{ section.settings.bg_color }};background:rgba(220,218,230,0.9);padding:8px 12px;border-radius:2px">{{ section.settings.badge_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function(){if(!window.mcBaseInit){window.mcBaseInit=true;document.addEventListener('DOMContentLoaded',function(){var io=null;if('IntersectionObserver' in window){io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('mc-on');io.unobserve(e.target);}});},{threshold:0.12});}document.querySelectorAll('[data-mc-reveal]').forEach(function(el){if(io){io.observe(el);}else{el.classList.add('mc-on');}});});}})();
</script>

{% schema %}
{
  "name": "MC — Companion",
  "settings": [
    {"type": "color", "id": "bg_color", "label": "Background", "default": "#1b1a23"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#dcdae6"},
    {"type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#9aa0c4"},
    {"type": "color", "id": "body_color", "label": "Body text color", "default": "#a6a4b8"},
    {"type": "color", "id": "cta_note_color", "label": "CTA note color", "default": "#7a7e9a"},
    {"type": "color", "id": "img_bg_color", "label": "Image background", "default": "#26252f"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The transition before this one"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "The evening ritual that shapes the morning."},
    {"type": "textarea", "id": "body", "label": "Body", "default": "The quality of Sleep → Wakefulness is shaped by how the previous evening ended. Stillness Elixir exists for the Work → Recovery transition — the signal that tells the nervous system the day is finished, before the morning can begin differently."},
    {"type": "url", "id": "cta_url", "label": "CTA link"},
    {"type": "text", "id": "cta_text", "label": "CTA button text", "default": "Explore the evening →"},
    {"type": "text", "id": "cta_note", "label": "CTA note", "default": "Companion ritual"},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "fallback_url", "label": "Fallback image URL", "default": "https://mirellis.in/cdn/shop/files/Image-9_-Begin-the-day-grounded.png?v=1773638990"},
    {"type": "text", "id": "badge_text", "label": "Image badge text", "default": "Stillness Elixir"}
  ],
  "presets": [{"name": "MC — Companion"}]
}
{% endschema %}