{% if section.settings.show_section %}
<section class="wwa-observatory">
  <div class="wwa-inner">
    {% if section.settings.eyebrow != blank %}
    <p class="wwa-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
    <h2 class="wwa-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
    <div class="wwa-body">{{ section.settings.body | newline_to_br }}</div>
    {% endif %}
    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
    <div class="wwa-cta-wrapper">
      <a href="{{ section.settings.cta_link }}" class="wwa-cta-secondary">{{ section.settings.cta_text }}</a>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<style>
.wwa-observatory {
  background: #faf7f2;
  padding: 6rem 2rem;
}
.wwa-inner {
  max-width: 720px;
  margin: 0 auto;
}
.wwa-eyebrow {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(26,26,24,0.45);
  margin: 0 0 1.5rem 0;
}
.wwa-heading {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 400;
  color: #1a1a18;
  margin: 0 0 2.5rem 0;
  line-height: 1.2;
}
.wwa-body {
  font-size: 1rem;
  line-height: 1.85;
  color: rgba(26,26,24,0.7);
  margin-bottom: 2rem;
}
.wwa-cta-wrapper {
  margin-top: 2rem;
}
.wwa-cta-secondary {
  font-size: 0.9rem;
  color: rgba(26,26,24,0.55);
  text-decoration: none;
  border-bottom: 1px solid rgba(26,26,24,0.25);
  padding-bottom: 1px;
  transition: all 0.2s ease;
  display: inline-block;
}
.wwa-cta-secondary:hover {
  color: #1a1a18;
  border-color: rgba(26,26,24,0.6);
}
@media (max-width: 640px) {
  .wwa-observatory {
    padding: 4rem 1.5rem;
  }
}
</style>

{% schema %}
{
  "name": "WWA Observatory",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE OBSERVATORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Research into Human State Transitions."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The Observatory is the research arm of Mirellis.\n\nThe Observatory documents observations, patterns, experiments, and emerging hypotheses from the study of Human State Transitions.\n\nA growing body of work exploring the moments between sleep and waking, work and recovery, stimulation and restoration.\n\nNot wellness content.\nNot productivity advice.\n\nA deeper investigation into how humans change states — and what consistent ritual systems do to support those changes over time."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Enter the Observatory →"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA Link",
      "default": "/pages/the-observatory"
    },
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    }
  ]
}
{% endschema %}
