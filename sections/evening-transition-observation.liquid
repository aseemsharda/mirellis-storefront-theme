<section class="mirellis-observation">

  <div class="observation-progress">
    <div class="observation-progress-bar"></div>
  </div>

  <div class="observation-container">
<!-- SCREEN 1 -->

<div class="observation-screen active">

  <p class="observation-eyebrow">
    Field Observation
  </p>

  <h1>
    The Evening Transition
  </h1>

  <p class="observation-intro">
    The clock may suggest that evening has arrived.
  </p>

  <p class="observation-intro">
    The body often follows different signals.
  </p>

  <p class="observation-description">
    This observation explores a simple question:
  </p>

  <h3 class="observation-question">
    When does evening actually begin?
  </h3>

  <div class="observation-meta">
    Estimated Time · 3 Minutes
  </div>

  <button class="observation-primary next-step">
    Begin Observation
  </button>

</div>

<!-- SCREEN 2 -->

<div class="observation-screen">

  <h2>Arrival</h2>

  <p>Pause for a moment.</p>

  <p>Look around the room you are currently in.</p>

  <p>Not the room you wish you were in.</p>

  <p>The room you are in now.</p>

  <p>Notice the light.</p>

  <p>Notice the sound.</p>

  <p>Notice the atmosphere.</p>

  <button class="observation-primary next-step">
    Continue
  </button>

</div>

<!-- SCREEN 3 -->

<div class="observation-screen">

  <h2>Light</h2>

  <p>Which source currently shapes the atmosphere most?</p>

  <button class="observation-choice next-step">Screen</button>
  <button class="observation-choice next-step">Lamp</button>
  <button class="observation-choice next-step">Window</button>
  <button class="observation-choice next-step">Ceiling Light</button>

</div>

<!-- SCREEN 4 -->

<div class="observation-screen">

  <h2>Sound</h2>

  <p>Which feels most true?</p>

  <button class="observation-choice next-step">
    The environment feels busy
  </button>

  <button class="observation-choice next-step">
    The environment feels mixed
  </button>

  <button class="observation-choice next-step">
    The environment feels mostly quiet
  </button>

</div>

<!-- SCREEN 5 -->

<div class="observation-screen">

  <h2>Attention</h2>

  <p>Where does attention naturally return?</p>

  <button class="observation-choice next-step">
    Unfinished tasks
  </button>

  <button class="observation-choice next-step">
    A device
  </button>

  <button class="observation-choice next-step">
    Tomorrow
  </button>

  <button class="observation-choice next-step">
    The present environment
  </button>

  <button class="observation-choice next-step">
    I'm not sure
  </button>

</div>

<!-- SCREEN 6 -->

<div class="observation-screen">

  <h2>Recognition</h2>

  <p>What feels most true right now?</p>

  <button class="observation-choice next-step">
    My day still feels active
  </button>

  <button class="observation-choice next-step">
    My day feels unfinished
  </button>

  <button class="observation-choice next-step">
    My day feels quieter
  </button>

  <button class="observation-choice next-step">
    I'm not sure
  </button>

</div>
<!-- SCREEN 7 -->

<div class="observation-screen">

  <p class="observation-eyebrow">
    Reflection
  </p>

  <h2>
    Transition Awareness
  </h2>

  <p>
    Before continuing,
  </p>

  <p>
    ask yourself:
  </p>

  <h3 class="observation-question">
    Has evening already arrived?
  </h3>

  <button class="observation-choice next-step">
    Yes
  </button>

  <button class="observation-choice next-step">
    No
  </button>

  <button class="observation-choice next-step">
    I'm Not Sure
  </button>

</div>

<!-- SCREEN 8 -->

<div class="observation-screen">

  <h2>
    Pause
  </h2>

  <p>
    For a few moments,
  </p>

  <p>
    do nothing.
  </p>

  <p>
    Simply observe the room.
  </p>

  <p>
    Notice what is asking for attention.
  </p>

  <button class="observation-primary next-step">
    Continue
  </button>

</div>

<!-- SCREEN 9 -->

<div class="observation-screen">

  <p class="observation-eyebrow">
    Your Observation
  </p>

  <h2>
    Environmental Momentum
  </h2>

  <p>
    Several signals associated with activity appear to remain present.
  </p>

  <p>
    Evening often begins through changing signals rather than changing time.
  </p>

  <p>
    Notice which signals have changed before this moment.
  </p>

  <button class="observation-primary next-step">
    Continue
  </button>

</div>

<!-- SCREEN 10 -->

<div class="observation-screen">

  <p class="observation-eyebrow">
    Field Note
  </p>

  <h2>
    One Thing To Notice
  </h2>

  <p>
    For the next three evenings,
  </p>

  <p>
    notice the first signal that tells your body the day is changing.
  </p>

  <p>
    Do not change anything.
  </p>

  <p>
    Observe.
  </p>

  <button class="observation-primary next-step">
    Continue
  </button>

</div>

<!-- SCREEN 11 -->

<div class="observation-screen">

  <p class="observation-eyebrow">
    Continue Exploring
  </p>

  <h2>
    The Observation Continues
  </h2>

  <p>
    Explore additional rituals, environments and reflections.
  </p>

  <a href="/pages/ritual-wellness" class="observation-primary">
    Explore Rituals
  </a>

</div>

  </div>

</section>

<style>

.mirellis-observation{
  background:#f8f4ee;
  min-height:100vh;
}

.observation-progress{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:2px;
  background:rgba(0,0,0,.06);
  z-index:100;
}

.observation-progress-bar{
  width:16%;
  height:100%;
  background:#1f1f1f;
  transition:.6s ease;
}

.observation-container{
  width:100%;
}

.observation-screen{
  display:none;
  min-height:100vh;
  max-width:900px;
  margin:0 auto;
  padding:80px 32px;

  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}

.observation-screen.active{
  display:flex;
}

.observation-eyebrow{
  font-size:12px;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:#8d867d;
  margin-bottom:30px;
}

.observation-screen h1{
  font-size:clamp(58px,8vw,110px);
  line-height:.95;
  letter-spacing:-0.04em;
  font-weight:400;
  margin-bottom:40px;
}

.observation-screen h2{
  font-size:clamp(48px,7vw,90px);
  line-height:1;
  font-weight:400;
  margin-bottom:50px;
}

.observation-intro{
  font-size:30px;
  line-height:1.7;
  margin-bottom:10px;
}

.observation-description{
  margin-top:40px;
  margin-bottom:15px;
  color:#6a625b;
}

.observation-question{
  font-size:38px;
  line-height:1.4;
  font-weight:400;
  margin-bottom:40px;
}

.observation-meta{
  margin-bottom:40px;
  font-size:12px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#8d867d;
}

.observation-screen p{
  font-size:22px;
  line-height:1.9;
  color:#5d5650;
}

.observation-primary{
  margin-top:30px;
  padding:18px 34px;
  background:#1f1f1f;
  color:white;
  border:none;
  cursor:pointer;
}

.observation-choice{
  width:100%;
  max-width:500px;
  padding:20px;
  margin:12px auto;
  background:white;
  border:1px solid rgba(0,0,0,.08);
  cursor:pointer;
}

.observation-choice:hover{
  border-color:#1f1f1f;
}

@media(max-width:768px){

.observation-screen{
  padding:60px 24px;
}

.observation-screen h1{
  font-size:56px;
}

.observation-screen h2{
  font-size:48px;
}

.observation-intro{
  font-size:22px;
}

.observation-screen p{
  font-size:18px;
}

.observation-question{
  font-size:28px;
}

.observation-choice{
  max-width:100%;
}

}
.pause-timer{
  font-size:80px;
  line-height:1;
  margin:40px 0;
  color:#1f1f1f;
  font-weight:300;
}
</style>

<script>

document.addEventListener('DOMContentLoaded', function(){

const screens = document.querySelectorAll('.observation-screen');
const buttons = document.querySelectorAll('.next-step');
const progress = document.querySelector('.observation-progress-bar');

let current = 0;

buttons.forEach(button => {

button.addEventListener('click', function(){

if(current < screens.length - 1){

screens[current].classList.remove('active');

current++;

screens[current].classList.add('active');

let percentage =
((current + 1) / screens.length) * 100;

progress.style.width = percentage + '%';

}

});

});

});

</script>

{% schema %}
{
"name": "Evening Transition",
"presets": [
{
"name": "Evening Transition"
}
]
}
{% endschema %}
