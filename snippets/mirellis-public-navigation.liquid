{%- liquid
  assign public_navigation_labels = 'Sleep · Focus · Restoration|Find a specialist|Understand|After Work|About' | split: '|'
  assign public_navigation_urls = '/what-is-going-on|https://directory.mirellis.in|/pages/understand|https://app.mirellis.in|/pages/about' | split: '|'
  assign public_navigation_path = request.path
-%}

{%- for navigation_label in public_navigation_labels -%}
  {%- liquid
    assign navigation_url = public_navigation_urls[forloop.index0]
    assign navigation_current = false

    case forloop.index0
      when 0
        if public_navigation_path == '/what-is-going-on' or public_navigation_path == '/sleep' or public_navigation_path == '/focus' or public_navigation_path == '/restoration'
          assign navigation_current = true
        endif
      when 2
        if public_navigation_path contains '/pages/understand' or public_navigation_path contains '/pages/the-observatory' or public_navigation_path contains '/pages/observatory-findings' or public_navigation_path contains '/blogs/journal'
          assign navigation_current = true
        endif
      when 4
        if public_navigation_path contains '/pages/about' or public_navigation_path contains '/pages/why-we-exist' or public_navigation_path contains '/pages/how-we-work'
          assign navigation_current = true
        endif
    endcase
  -%}

  {%- if surface == 'mobile' -%}
    <li class="h3 sm:h4">
      <a href="{{ navigation_url }}" class="group block w-full"{% if navigation_current %} aria-current="page"{% endif %}>
        <span><span class="reversed-link">{{ navigation_label }}</span></span>
      </a>
    </li>
  {%- elsif surface == 'footer' -%}
    <li>
      <a href="{{ navigation_url }}" class="inline-block link-faded break-all"{% if navigation_current %} aria-current="page"{% endif %}>{{ navigation_label }}</a>
    </li>
  {%- else -%}
    <li>
      <a href="{{ navigation_url }}" class="bold link-faded-reverse"{% if navigation_current %} aria-current="page"{% endif %}>{{- navigation_label -}}</a>
    </li>
  {%- endif -%}
{%- endfor -%}
